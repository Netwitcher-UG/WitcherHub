@page
@using Microsoft.AspNetCore.Authorization
@using WitcherHub.Domain.SeedData
@attribute [Authorize(Policy = AppPolicyPrefixes.Permission + AppPermissions.ManageNetwitcher)]
@model WitcherHub.Pages.ServicesModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Services";
}

<div id="servicesTableCard" class="wh-tablecard-scroll">
    <partial name="_TableCard" model="Model.ServicesTable" />
</div>
<partial name="~/Pages/Shared/Modals/_ModalShell.cshtml" model="Model.CreateServiceModal" />
<partial name="~/Pages/Shared/Modals/_ViewServiceModal.cshtml" />

<form id="tblDeleteForm" method="post" asp-page-handler="DeleteService" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="serviceId" id="tblDeleteServiceId" />
</form>

<input type="hidden" id="vcServiceUrl" value="@Url.Page("./Services", "Service")" />
<input type="hidden" id="vcUpdateBasicUrl" value="@Url.Page("./Services", "UpdateBasic")" />
<input type="hidden" id="antiForgeryToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<input type="hidden" id="vcAddRuleUrl" value="@Url.Page("./Services", "AddPricingRule")" />
<input type="hidden" id="vcUpdateRuleUrl" value="@Url.Page("./Services", "UpdatePricingRule")" />
<input type="hidden" id="vcDeleteRuleUrl" value="@Url.Page("./Services", "DeletePricingRule")" />
<div class="modal fade quote-confirm-modal" id="DeleteServiceConfirmModal" tabindex="-1" aria-labelledby="DeleteServiceConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteServiceConfirmModalLabel">Delete service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="DeleteServiceConfirmModalMessage">Are you sure you want to delete this service?</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="DeleteServiceConfirmModalSubmit">Delete</button>
            </div>
        </div>
    </div>
</div>


@if (Model.CreateServiceModal?.AutoOpen == true)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('FormModal');
            if (!el) return;

            const m = bootstrap.Modal.getOrCreateInstance(el);
            m.show();

            const firstErr = el.querySelector('.field-validation-error, .text-danger:not(:empty)');
            if (firstErr) {
                const input = firstErr.closest('.col-md-2,.col-md-4,.col-md-6,.col-md-8,.col-12')
                    ?.querySelector('input,select,textarea');
                if (input) input.focus();
            }
        });
    </script>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/services/schema-builder.js" asp-append-version="true"></script>
    <script src="~/js/pages/services/services.js" asp-append-version="true"></script>

   
}