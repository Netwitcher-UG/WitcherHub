@page
@using WitcherHub.Pages.Models.UI
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Invoices.DetailsModel
@{
    ViewData["Title"] = Model.Invoice is null ? "Invoice" : $"Invoice {Model.Invoice.InvoiceNo}";
    var invoice = Model.Invoice!;
    var totals = invoice.Totals;
}

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-24">
    <div>
        <nav class="mb-8">
            <a asp-page="/Invoices/Index" class="text-secondary-light text-sm hover-text-primary d-inline-flex align-items-center gap-1">
                <i class="ri-arrow-left-line"></i> All invoices
            </a>
        </nav>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <h3 class="mb-0 fw-semibold">@invoice.InvoiceNo</h3>
            <partial name="_StatusBadge" model="DocumentStatusPresentation.ForInvoice(invoice.Status)" />

            @if (Model.IsOverdue)
            {
                <span class="badge bg-danger-focus text-danger-main border border-danger-main px-16 py-4 radius-4 text-sm">
                    <i class="ri-alarm-warning-line"></i> @Model.DaysOverdue days overdue
                </span>
            }
        </div>

        <p class="text-secondary-light mb-0 mt-8 text-sm">
            <a asp-page="/Clients/Details" asp-route-id="@invoice.CustomerId" class="text-primary-600 fw-medium">@invoice.CustomerName</a>
            ·
            <a asp-page="/Projects/Workspace" asp-route-id="@invoice.ProjectId" asp-route-tab="invoices" class="hover-text-primary">@invoice.ProjectTitle</a>
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (Model.HasLexwarePdf)
        {
            <a asp-page-handler="Pdf" asp-route-id="@invoice.Id" target="_blank"
               class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2">
                <i class="ri-file-pdf-2-line"></i> View PDF
            </a>
            <a asp-page-handler="Pdf" asp-route-id="@invoice.Id" asp-route-download="true"
               class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2">
                <i class="ri-download-2-line"></i> Download
            </a>
        }

        <a asp-page="/Invoices/Edit" asp-route-id="@invoice.Id"
           class="btn btn-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2">
            <i class="ri-edit-line"></i> Edit
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger radius-8 mb-24" role="alert">@Model.ErrorMessage</div>
}

<div class="row gy-4">
    <div class="col-12 col-xl-8">
        @* ---------------- what was billed ---------------- *@
        <div class="card radius-12 border mb-24">
            <div class="card-body p-24">
                <h6 class="fw-semibold mb-16">Positions</h6>

                @if (invoice.Items.Count == 0)
                {
                    <p class="text-secondary-light mb-0">This invoice has no positions yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="text-sm">Position</th>
                                    <th class="text-sm text-end">Qty</th>
                                    <th class="text-sm text-end">Unit price</th>
                                    <th class="text-sm text-end">Line total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in invoice.Items)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-medium d-block">@item.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <span class="text-secondary-light text-sm">@item.Description</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @item.Quantity.ToString("0.##")
                                            @if (!string.IsNullOrWhiteSpace(item.UnitName))
                                            {
                                                <span class="text-secondary-light">@item.UnitName</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">@Format.Money(item.UnitPrice, invoice.Currency)</td>
                                        <td class="text-end text-nowrap fw-semibold">@Format.Money(item.LineTotal, invoice.Currency)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* ---------------- what has been received ---------------- *@
        <div class="card radius-12 border">
            <div class="card-body p-24">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-16">
                    <h6 class="fw-semibold mb-0">Payments</h6>

                    @if (Model.CanRecordPayment)
                    {
                        <button type="button" class="btn btn-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2"
                                data-bs-toggle="modal" data-bs-target="#recordPaymentModal">
                            <i class="ri-add-line"></i> Record payment
                        </button>
                    }
                </div>

                @if (Model.Payments.Count == 0)
                {
                    <p class="text-secondary-light mb-0">
                        Nothing received against this invoice yet.
                        @if (!Model.CanRecordPayment && invoice.Status == DocumentStatus.Draft)
                        {
                            <text>Issue the invoice before recording a payment.</text>
                        }
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="text-sm">Received</th>
                                    <th class="text-sm">Method</th>
                                    <th class="text-sm">Reference</th>
                                    <th class="text-sm">State</th>
                                    <th class="text-sm text-end">Amount</th>
                                    <th class="text-sm text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td class="text-nowrap">@Format.Date(payment.PaidAt ?? payment.RecordedAt)</td>
                                        <td class="text-nowrap">
                                            @{
                                                var method = DocumentStatusPresentation.ForPaymentMethod(payment.Method);
                                            }
                                            <i class="@method.Icon text-secondary-light"></i> @method.Label
                                        </td>
                                        <td class="text-break">
                                            @(string.IsNullOrWhiteSpace(payment.Reference) ? "—" : payment.Reference)
                                        </td>
                                        <td>
                                            <partial name="_StatusBadge" model="DocumentStatusPresentation.ForPayment(payment.Status)" />
                                        </td>
                                        <td class="text-end fw-semibold text-nowrap">
                                            @Format.Money(payment.Amount, payment.Currency)
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DeletePayment" class="d-inline"
                                                  onsubmit="return confirm('Remove this payment? The invoice balance will go back up.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@invoice.Id" />
                                                <input type="hidden" name="paymentId" value="@payment.Id" />
                                                <button type="submit" class="btn btn-sm vc-icon-btn text-danger-main"
                                                        title="Remove this payment">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ---------------- the money ---------------- *@
    <div class="col-12 col-xl-4">
        <div class="card radius-12 border mb-24">
            <div class="card-body p-24">
                <h6 class="fw-semibold mb-16">Totals</h6>

                <dl class="row mb-0">
                    <dt class="col-7 text-secondary-light fw-medium py-4">Subtotal</dt>
                    <dd class="col-5 text-end py-4 mb-0">@Format.Money(totals?.Subtotal ?? 0m, invoice.Currency)</dd>

                    @if ((totals?.DiscountTotal ?? 0m) != 0m)
                    {
                        <dt class="col-7 text-secondary-light fw-medium py-4">Discount</dt>
                        <dd class="col-5 text-end py-4 mb-0">−@Format.Money(totals!.DiscountTotal, invoice.Currency)</dd>
                    }

                    <dt class="col-7 text-secondary-light fw-medium py-4">VAT</dt>
                    <dd class="col-5 text-end py-4 mb-0">@Format.Money(totals?.TaxTotal ?? 0m, invoice.Currency)</dd>

                    <dd class="col-12 p-0"><hr class="my-8"></dd>

                    <dt class="col-7 fw-semibold py-4">Total</dt>
                    <dd class="col-5 text-end fw-semibold py-4 mb-0">@Format.Money(totals?.Total ?? 0m, invoice.Currency)</dd>

                    <dt class="col-7 text-success-main fw-medium py-4">Received</dt>
                    <dd class="col-5 text-end text-success-main py-4 mb-0">@Format.Money(totals?.PaidTotal ?? 0m, invoice.Currency)</dd>

                    <dd class="col-12 p-0"><hr class="my-8"></dd>

                    <dt class="col-7 fw-semibold py-4">Outstanding</dt>
                    <dd class="col-5 text-end fw-bold py-4 mb-0 @((totals?.BalanceDue ?? 0m) > 0m ? "text-danger-main" : "text-success-main")">
                        @Format.Money(totals?.BalanceDue ?? 0m, invoice.Currency)
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card radius-12 border">
            <div class="card-body p-24">
                <h6 class="fw-semibold mb-16">Dates</h6>

                <dl class="row mb-0 text-sm">
                    <dt class="col-6 text-secondary-light fw-medium py-4">Issued</dt>
                    <dd class="col-6 text-end py-4 mb-0">@Format.Date(invoice.IssueDate)</dd>

                    <dt class="col-6 text-secondary-light fw-medium py-4">Due</dt>
                    <dd class="col-6 text-end py-4 mb-0">
                        @Format.Date(invoice.DueDate)
                        @if (invoice.DueDate is not null)
                        {
                            <span class="d-block text-secondary-light">@Format.Relative(invoice.DueDate)</span>
                        }
                    </dd>

                    <dt class="col-6 text-secondary-light fw-medium py-4">Paid</dt>
                    <dd class="col-6 text-end py-4 mb-0">@Format.Date(invoice.PaidAt)</dd>

                    @if (!string.IsNullOrWhiteSpace(invoice.LexwareVoucherNumber))
                    {
                        <dt class="col-6 text-secondary-light fw-medium py-4">Lexware</dt>
                        <dd class="col-6 text-end py-4 mb-0">@invoice.LexwareVoucherNumber</dd>
                    }
                </dl>

                @if (!string.IsNullOrWhiteSpace(invoice.Notes))
                {
                    <hr class="my-16">
                    <span class="text-secondary-light text-sm fw-medium d-block mb-8">Notes</span>
                    <p class="mb-0 text-sm">@invoice.Notes</p>
                }
            </div>
        </div>
    </div>
</div>

@* ---------------- record a payment ---------------- *@
@if (Model.CanRecordPayment)
{
    <div class="modal fade" id="recordPaymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="RecordPayment" class="modal-content">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@invoice.Id" />

                <div class="modal-header wh-modal-header">
                    <h5 class="modal-title">Record a payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-24">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label text-sm fw-medium" asp-for="PaymentAmount">Amount</label>
                            <div class="input-group">
                                <input asp-for="PaymentAmount" class="form-control radius-8" inputmode="decimal" required>
                                <span class="input-group-text">@Format.Symbol(invoice.Currency)</span>
                            </div>
                            <span class="text-secondary-light text-sm">
                                Outstanding: @Format.Money(totals?.BalanceDue ?? 0m, invoice.Currency)
                            </span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label text-sm fw-medium" asp-for="PaymentReceivedOn">Received on</label>
                            <input asp-for="PaymentReceivedOn" type="date" class="form-control radius-8 js-datepicker"
                                   max="@DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd")" required>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label text-sm fw-medium" asp-for="PaymentMethod">Method</label>
                            <select asp-for="PaymentMethod" class="form-select radius-8">
                                <option value="@((int)PaymentMethod.Bank)">Bank transfer</option>
                                <option value="@((int)PaymentMethod.Cash)">Cash</option>
                                <option value="@((int)PaymentMethod.Card)">Card</option>
                                <option value="@((int)PaymentMethod.Online)">Online</option>
                                <option value="@((int)PaymentMethod.Other)">Other</option>
                            </select>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label text-sm fw-medium" asp-for="PaymentReference">Reference</label>
                            <input asp-for="PaymentReference" class="form-control radius-8"
                                   placeholder="Bank reference, transaction id…">
                        </div>

                        <div class="col-12">
                            <div class="form-check d-flex align-items-center gap-2">
                                <input asp-for="PaymentIsPending" class="form-check-input" type="checkbox">
                                <label class="form-check-label text-sm" asp-for="PaymentIsPending">
                                    Not cleared yet — record it without reducing the balance
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary radius-8" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary radius-8">Record payment</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/decimal-culture.js" asp-append-version="true"></script>
}
