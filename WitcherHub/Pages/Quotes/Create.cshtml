@page
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Quotes.CreateModel

@{
    ViewData["Title"] = "Create Quote";
}

@functions {
    string FmtDate(DateTimeOffset? d) => d?.ToString("yyyy-MM-dd") ?? "";

}
<style>
    .wh-btn-primary {
        background-color: rgb(107 76 230);
        border-color: rgb(107 76 230);
        color: #fff;
    }

        .wh-btn-primary:hover,
        .wh-btn-primary:focus,
        .wh-btn-primary:active,
        .wh-btn-primary.active,
        .show > .wh-btn-primary.dropdown-toggle {
            background-color: rgb(95 66 214);
            border-color: rgb(95 66 214);
            color: #fff;
        }

        .wh-btn-primary:focus {
            box-shadow: 0 0 0 .25rem rgba(107, 76, 230, .25);
        }

        .wh-btn-primary:disabled,
        .wh-btn-primary.disabled {
            background-color: rgb(107 76 230);
            border-color: rgb(107 76 230);
            color: #fff;
            opacity: .65;
        }
</style>
<div class="mb-3">
    <div class="mb-1">
        <a class="text-decoration-none text-muted small"
           asp-page="/Projects/Workspace"
           asp-route-id="@Model.Form.Quote.ProjectId"
           asp-route-tab="quotes"
           title="Back to Project Workspace - Quotes">
            Project Workspace / Quotes
        </a>
    </div>

    <h3 class="mb-0">Create Quote</h3>
</div>

<form method="post" class="card">
    <div class="card-body">
        <input type="hidden" asp-for="Form.Quote.ProjectId" />
        <input type="hidden" asp-for="Form.Quote.Currency" value="EUR" />

        <div class="row g-3 js-pointer">
            <div class="col-12 col-md-4">
                <label class="form-label js-pointer-label">Issued At</label>
                <input type="date"
                       class="form-control js-themed-date js-datepicker js-pointer-date"
                       name="Form.Quote.IssuedAt"
                       value="@FmtDate(Model.Form.Quote.IssuedAt)" />
                <span class="text-danger small" asp-validation-for="Form.Quote.IssuedAt"></span>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label js-pointer-label">Expires At</label>
                <input type="date"
                       class="form-control js-themed-date js-datepicker js-pointer-date"
                       name="Form.Quote.ExpiresAt"
                       value="@FmtDate(Model.Form.Quote.ExpiresAt)" />
                <span class="text-danger small" asp-validation-for="Form.Quote.ExpiresAt"></span>
            </div>

            <div class="col-12 col-md-4">
                <div class="quote-vat-field">
                    <label class="form-label">VAT</label>
                    <div class="form-check d-flex align-items-center">
                        <input class="form-check-input js-pointer-checkbox"
                               asp-for="Form.Quote.ApplyVat"
                               type="checkbox"
                               id="CreateQuoteApplyVat" />
                        <label class="form-check-label js-pointer-label ms-2" for="CreateQuoteApplyVat">
                            Apply VAT (19%)
                        </label>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">After customer signs</label>
                <select class="form-select js-pointer-select"
                        asp-for="Form.Quote.AfterCustomerSignAction"
                        id="createQuoteAfterSignAction">
                    <option value="@((int)QuoteAfterSignAction.Contract)">Create Contract</option>
                    <option value="@((int)QuoteAfterSignAction.Invoice)">Send as Invoice</option>
                </select>
                <span class="text-danger small" asp-validation-for="Form.Quote.AfterCustomerSignAction"></span>
            </div>

            <div class="col-12 col-md-6" id="createQuoteInvoiceSendModeWrap">
                <label class="form-label">Invoice Send Mode</label>
                <select class="form-select js-pointer-select"
                        asp-for="Form.Quote.InvoiceSendMode"
                        id="createQuoteInvoiceSendMode">
                    <option value="@((int)InvoiceSendMode.Automatic)">Automatic</option>
                    <option value="@((int)InvoiceSendMode.Manual)">Manual</option>
                </select>
                <span class="text-danger small" asp-validation-for="Form.Quote.InvoiceSendMode"></span>
            </div>

            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea class="form-control" rows="3" asp-for="Form.Quote.Notes"></textarea>
                <span class="text-danger small" asp-validation-for="Form.Quote.Notes"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn wh-btn-primary" type="submit">Create</button>
            <a class="btn btn-outline-secondary"
               asp-page="/Projects/Workspace"
               asp-route-id="@Model.Form.Quote.ProjectId"
               asp-route-tab="quotes">
                Cancel
            </a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/quotes/date-input-theme.js" asp-append-version="true"></script>
    <script>
        (function () {
            if (window.quoteDateTheme) {
                window.quoteDateTheme.init(document);
            }
        })();

        (function () {
            const actionEl = document.getElementById('createQuoteAfterSignAction');
            const modeWrapEl = document.getElementById('createQuoteInvoiceSendModeWrap');
            const modeEl = document.getElementById('createQuoteInvoiceSendMode');

            function toggleInvoiceMode() {
                if (!actionEl) return;

                const isInvoice = actionEl.value === '@((int)QuoteAfterSignAction.Invoice)';
                if (modeWrapEl) modeWrapEl.classList.toggle('d-none', !isInvoice);
                if (modeEl) modeEl.disabled = !isInvoice;
            }

            if (actionEl) {
                actionEl.addEventListener('change', toggleInvoiceMode);
                toggleInvoiceMode();
            }
        })();
    </script>
}
