@page
@model WitcherHub.Pages.Quotes.Items.CreateModel
@using static WitcherHub.Infrastructure.Data.Models.Enums

@{
    ViewData["Title"] = "Add Position";
}

@if (Model.Quote is null)
{
    <div class="alert alert-danger">Quote not found.</div>
    return;
}

@{
    var isDraft = Model.Quote.Status == DocumentStatus.Draft;
}

<div class="mb-3">
    <div class="mb-1 d-flex flex-wrap gap-2 align-items-center text-muted small">
        <a class="text-decoration-none text-muted"
           asp-page="/Projects/Workspace"
           asp-route-id="@Model.Quote.ProjectId"
           asp-route-tab="quotes"
           title="Back to Project Workspace - Quotes">
            Project Workspace / Quotes
        </a>

        <span>/</span>

        <a class="text-decoration-none text-muted"
           asp-page="/Quotes/Edit"
           asp-route-id="@Model.Quote.Id"
           title="Back to Edit Quote">
            Edit Quote
        </a>
    </div>

    <div class="text-muted small">Add Position to</div>
    <h3 class="mb-1">@Model.Quote.QuoteNo</h3>
    <div class="text-muted small">
        Status: <strong>@Model.Quote.Status</strong> &nbsp;|&nbsp;
        Currency: <strong>@Model.Quote.Currency</strong>
    </div>
</div>

@if (!isDraft)
{
    <div class="alert alert-warning">
        This quote is not in Draft status. Items are locked.
    </div>
    return;
}

<form method="post" class="card">
    <div class="card-body">
        <input type="hidden" asp-for="QuoteId" />
        <input type="hidden" asp-for="Form.QuoteId" />
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="row g-3">

            <!-- الصف الأول: Service + Pricing Rules -->
            <div class="col-12 col-lg-6">
                <label class="form-label">Service</label>

                <div class="dropdown">
                    <input type="text"
                           class="form-control dropdown-toggle"
                           id="serviceCombo"
                           data-bs-toggle="dropdown"
                           aria-expanded="false"
                           autocomplete="off"
                           placeholder="Search & select service..." />

                    <ul class="dropdown-menu w-100" id="serviceMenu" aria-labelledby="serviceCombo"></ul>
                </div>

                <!-- hidden select for model binding -->
                <select asp-for="SelectedServiceId"
                        asp-items="Model.ServiceOptions"
                        id="serviceSelect"
                        class="form-select"
                        style="position:absolute; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden;">
                    <option value="">-- choose --</option>
                </select>

                <span class="text-danger small" asp-validation-for="SelectedServiceId"></span>
                <div class="form-text">Tip: start typing a keyword (website, design, video...).</div>
            </div>

            <div class="col-12 col-lg-6">
                <div id="rulesBlock" style="display:none;">
                    <label class="form-label">Pricing Rules</label>

                    <div class="dropdown">
                        <input type="text"
                               class="form-control dropdown-toggle"
                               id="ruleCombo"
                               data-bs-toggle="dropdown"
                               aria-expanded="false"
                               autocomplete="off"
                               placeholder="Search & select pricing rule..." />

                        <ul class="dropdown-menu w-100" id="ruleMenu" aria-labelledby="ruleCombo"></ul>
                    </div>

                    <div class="form-text">Select one or more rules (they will be applied in order of priority).</div>

                    <div class="mt-2 d-flex flex-wrap gap-2" id="selectedRules"></div>
                    <div id="ruleHiddenInputs"></div>
                </div>
            </div>
            <div class="col-12">
                <div id="livePriceCard"
                     class="card border bg-transparent"
                     data-currency="@Model.Quote.Currency"
                     style="display:none;">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="fw-semibold">Live Price Preview</div>
                        <div class="small text-muted" id="livePriceStatus">Select a service to preview its price</div>
                    </div>

                    <div class="card-body">
                        <div id="livePriceEmpty" class="text-muted small">
                            Select a service and the price will appear here before you add the item.
                        </div>

                        <div id="livePriceContent" class="d-none">
                            <div class="row g-3">
                                <div class="col-6 col-md-3">
                                    <div class="small text-muted">Base price</div>
                                    <div class="fw-semibold" id="previewBaseUnit">—</div>
                                </div>

                                <div class="col-6 col-md-3">
                                    <div class="small text-muted">Current unit price</div>
                                    <div class="fw-semibold" id="previewEffectiveUnit">—</div>
                                </div>

                                <div class="col-6 col-md-3">
                                    <div class="small text-muted">Discount</div>
                                    <div class="fw-semibold" id="previewDiscount">—</div>
                                </div>

                                <div class="col-6 col-md-3">
                                    <div class="small text-muted">Line total</div>
                                    <div class="fw-semibold" id="previewTotal">—</div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="small text-muted mb-2">Applied rules</div>
                                <div id="previewRules" class="d-flex flex-column gap-2"></div>
                                <div id="previewRulesEmpty" class="text-muted small">No pricing rules applied.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- الصف الثاني: الحقول تبقى دائماً تحت الدروب داون -->
            <div class="col-12"></div>

            <div class="col-12 col-md-3">
                <label class="form-label">Quantity</label>
                <input asp-for="Form.Item.Quantity"
                       asp-format="{0:0.##}"
                       type="number"
                       step="1"
                       min="0"
                       asp-format="{0:0.##}"
                       type="number"
                       step="1"
                       min="0"
                       class="form-control" />
                <span class="text-danger small" asp-validation-for="Form.Item.Quantity"></span>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">BillingCycle</label>
                <select asp-for="Form.Item.BillingCycle"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<BillingCycle>()">
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">Discount Type</label>
                <select class="form-select" asp-for="Form.Item.DiscountType">
                    <option value="">-- none --</option>
                    <option value="Percent">Percent</option>
                    <option value="Amount">Amount</option>
                    <option value="Fixed">Fixed</option>
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">Discount Value</label>
                <input class="form-control" asp-for="Form.Item.DiscountValue" />
            </div>
            <div class="col-12 mt-1">
    <label class="form-label">Unit Name</label>
    <input asp-for="Form.Item.UnitName"
           class="form-control w-100"
           placeholder="e.g. Piece / Hour / Month" />
    <span class="text-danger small" asp-validation-for="Form.Item.UnitName"></span>
</div>

<div class="col-12">
    <label class="form-label">Description</label>
    <textarea asp-for="Form.Item.Description"
              class="form-control w-100 soft-placeholder"
              rows="4"
              placeholder="This text will appear on the quote / invoice line"></textarea>
    <span class="text-danger small" asp-validation-for="Form.Item.Description"></span>
</div>
            
            
            <!-- ✅ Config dynamic UI -->
            <div class="col-12" id="configBlock" style="display:none;">
                <div class="card border bg-transparent">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="fw-semibold">Config</div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="cfgResetBtn">
                                Reset
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#cfgRawCollapse"
                                    aria-expanded="false">
                                Raw JSON
                            </button>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="cfgLoading" class="text-muted small d-none">Loading config schema…</div>

                        <div id="cfgEmpty" class="text-muted small d-none">
                            This service has no config schema. You can still use Raw JSON if needed.
                        </div>

                        <div id="cfgFields" class="row g-3"></div>

                        <!-- Advanced: raw JSON -->
                        <div class="collapse mt-3" id="cfgRawCollapse">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label mb-0">Config (JSON)</label>
                                <button class="btn btn-sm btn-outline-secondary" type="button" id="cfgFormatBtn">Format</button>
                            </div>

                            <textarea class="form-control mt-2 font-monospace" rows="7" asp-for="ConfigJson" id="cfg-json"></textarea>
                            <div class="form-text">You normally don’t need to edit this manually.</div>
                            <span class="text-danger small" asp-validation-for="ConfigJson"></span>
                        </div>

                        <!-- Important: keep textarea posted even if collapse closed -->
                        <textarea asp-for="ConfigJson" id="cfg-json-hidden" style="display:none;"></textarea>
                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn wh-btn-primary" type="submit" id="btnSubmit">Add Item</button>
            <a class="btn btn-outline-secondary"
               asp-page="/Quotes/Edit"
               asp-route-id="@Model.Quote.Id">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/quotes/items-create.js" asp-append-version="true"></script>
}
