@page
@model WitcherHub.Pages.Quotes.DetailsModel

@{
    ViewData["Title"] = "Quote Details";
}
@{
    var showSignedPdfBtn = Model.HasSignedQuotePdf;
    var showCopyLinkBtn = !Model.HasSignedQuotePdf;
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<form method="post" id="quoteCopyLinkAfForm">
    @Html.AntiForgeryToken()
</form>

<input type="hidden"
       id="createQuotePublicLinkUrl"
       value="@Url.Page("./Details", "CreatePublicLink", new { id = Model.Id })" />
<input type="hidden" id="quoteAntiForgeryToken"
       value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
@if (Model.Quote is null)
{
    <div class="alert alert-danger">Quote not found.</div>
    return;
}

@functions {
    string StatusClass(string st)
    {
        var s = (st ?? "").ToLowerInvariant();
        if (s == "accepted") return "badge bg-success bg-opacity-10 text-success";
        if (s == "rejected") return "badge bg-danger bg-opacity-10 text-danger";
        if (s == "sent") return "badge bg-info bg-opacity-10 text-info";
        return "badge bg-warning bg-opacity-10 text-warning";
    }

    string FmtDate(DateTimeOffset? d) => d?.ToString("yyyy-MM-dd") ?? "—";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="text-muted small">Quote</div>
        <h3 class="mb-1">@Model.Quote.QuoteNo</h3>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="@StatusClass(Model.Quote.Status.ToString())">@Model.Quote.Status</span>
            <span class="text-muted">Currency: <strong>@Model.Quote.Currency</strong></span>
        </div>

        <div class="text-muted small mt-2">
            Created: <strong>@Model.Quote.CreatedAt.ToString("yyyy-MM-dd")</strong>
            &nbsp;|&nbsp;
            Issued: <strong>@FmtDate(Model.Quote.IssuedAt)</strong>
            &nbsp;|&nbsp;
            Expires: <strong>@FmtDate(Model.Quote.ExpiresAt)</strong>
        </div>
    </div>

    <div class="d-flex gap-2">
        

        <a class="btn btn-outline-primary"
           id="downloadPdfBtn"
           asp-page="./Details"
           asp-page-handler="Pdf"
           asp-route-id="@Model.Quote.Id"
           data-fallback-name="@($"{Model.Quote.QuoteNo}.pdf")"
           title="Download PDF">
            <span class="pdf-btn-text">PDF</span>
            <span class="spinner-border spinner-border-sm ms-2 d-none" id="downloadPdfSpinner" role="status" aria-hidden="true"></span>
        </a>
        @if (Model.ShowManualInvoiceButton)
        {
            <form method="post"
                  asp-page="./Details"
                  asp-page-handler="GenerateInvoice"
                  asp-route-id="@Model.Quote.Id"
                  class="d-inline">
                <button type="submit" class="btn btn-success" id="quoteGenerateInvoiceBtn">
                    Create Invoice
                </button>
            </form>
        }
        @if (showCopyLinkBtn)
        {
            <button type="button"
                    class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#SendQuoteModal"
                    title="Send quote to customer">
                Send
            </button>
        }
        @if (showCopyLinkBtn)
        {
            <button type="button"
                    class="btn btn-outline-info"
                    id="copyQuoteLinkBtn"
                    title="Copy public signing link">
                Copy Link
            </button>
        }

        @if (showSignedPdfBtn)
        {
            <a class="btn btn-outline-success"
               id="downloadSignedPdfBtn"
               asp-page="./Details"
               asp-page-handler="SignedPdf"
               asp-route-id="@Model.Quote.Id"
               title="Download signed PDF">
                <span class="signed-pdf-btn-text">Signed PDF</span>
                <span class="spinner-border spinner-border-sm ms-2 d-none"
                      id="downloadSignedPdfSpinner"
                      role="status"
                      aria-hidden="true"></span>
            </a>
        }
        else
        {
            <a class="btn btn-primary"
               asp-page="/Quotes/Edit"
               asp-route-id="@Model.Quote.Id">
                Edit
            </a>
        }
        
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Quote.Notes))
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="text-muted small mb-1">Notes</div>
            <div>@Model.Quote.Notes</div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Items</h5>
            <span class="text-muted small">Count: @Model.Quote.Items.Count</span>
        </div>

        @if (Model.Quote.Items.Count == 0)
        {
            <div class="alert alert-info mb-0">No items.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th style="width:70px;">#</th>
                            <th>Title</th>
                            <th style="width:110px;" class="text-end">Qty</th>
                            <th style="width:130px;" class="text-end">Unit</th>
                            <th style="width:140px;" class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in Model.Quote.Items.OrderBy(x => x.Position))
                        {
                            <tr>
                                <td>@it.Position</td>
                                <td>
                                    <div class="fw-semibold">@it.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(it.ServiceName))
                                    {
                                        <div class="text-muted small">@it.ServiceName</div>
                                    }
                                </td>
                                <td class="text-end">@it.Quantity.ToString("0.##")</td>
                                <td class="text-end">@it.UnitPrice.ToString("0.00")</td>
                                <td class="text-end fw-semibold">@it.LineTotal.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<div class="modal fade" id="SendQuoteModal" tabindex="-1" aria-labelledby="SendQuoteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="SendQuoteModalLabel">Send Quote</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2">
                    You are about to send this quote to the customer with:
                </div>

                <ul class="mb-3">
                    <li>an attached unsigned PDF</li>
                    <li>a secure signing link in the email body</li>
                </ul>

                <div class="p-3 rounded-3 border bg-light mb-3">
                    <div class="fw-semibold">@(Model.Quote.CustomerName ?? "—")</div>
                    <div class="text-muted small">@(Model.Quote.CustomerEmail ?? "—")</div>
                </div>

                <div class="small text-muted">
                    Quote: <strong>@Model.Quote.QuoteNo</strong>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>

                <form method="post" asp-page-handler="Send" asp-route-id="@Model.Quote.Id" class="d-inline" id="sendQuoteForm">
                    <button type="submit" class="btn btn-success" id="sendQuoteConfirmBtn">
                        Confirm &amp; Send
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showQuoteToast(type, title, message) {
            const t = (type || '').toString().toLowerCase();

            if (window.UI?.toast) {
                if (t === 'success' && typeof window.UI.toast.success === 'function') {
                    window.UI.toast.success(message, title);
                    return;
                }

                if ((t === 'warning' || t === 'warn') && typeof window.UI.toast.warning === 'function') {
                    window.UI.toast.warning(message, title);
                    return;
                }

                if (t === 'info' && typeof window.UI.toast.info === 'function') {
                    window.UI.toast.info(message, title);
                    return;
                }

                if (typeof window.UI.toast.error === 'function') {
                    window.UI.toast.error(message, title);
                    return;
                }
            }

            alert((title ? title + ': ' : '') + (message || ''));
        }

                (function () {
            const form = document.getElementById('sendQuoteForm');
            const btn = document.getElementById('sendQuoteConfirmBtn');
            if (!form || !btn) return;

            form.addEventListener('submit', function () {
                btn.disabled = true;
                btn.textContent = 'Sending...';
            });
        })();
        (function () {
            const btn = document.getElementById('copyQuoteLinkBtn');
            const urlEl = document.getElementById('createQuotePublicLinkUrl');
            const tokenEl = document.getElementById('quoteAntiForgeryToken');

            if (!btn || !urlEl || !tokenEl) return;

            btn.addEventListener('click', async function () {
                if (btn.dataset.busy === '1') return;

                try {
                    btn.dataset.busy = '1';
                    btn.disabled = true;
                    btn.textContent = 'Creating...';

                    const res = await fetch(urlEl.value, {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'RequestVerificationToken': tokenEl.value
                        }
                    });

                    const data = await res.json().catch(() => null);

                    if (!res.ok || !data?.ok || !data?.data?.url) {
                        showQuoteToast('error', 'Error', data?.message || 'Failed to create public link.');
                        return;
                    }

                    await navigator.clipboard.writeText(data.data.url);
                    showQuoteToast('success', 'Copied', 'Public quote link copied.');
                } catch (err) {
                    console.error(err);
                    showQuoteToast('error', 'Server error', 'Failed to copy public link.');
                } finally {
                    delete btn.dataset.busy;
                    btn.disabled = false;
                    btn.textContent = 'Copy Link';
                }
            });
        })();

        (function () {
            const pdfBtn = document.getElementById('downloadPdfBtn');
            const pdfSpinner = document.getElementById('downloadPdfSpinner');
            const pdfText = pdfBtn?.querySelector('.pdf-btn-text');

            if (!pdfBtn || !pdfSpinner || !pdfText) return;

            let isLoading = false;

            function setPdfLoading(isBusy) {
                isLoading = isBusy;

                if (isBusy) {
                    pdfBtn.classList.add('disabled');
                    pdfBtn.setAttribute('aria-disabled', 'true');
                    pdfSpinner.classList.remove('d-none');
                    pdfText.textContent = 'Generating...';
                } else {
                    pdfBtn.classList.remove('disabled');
                    pdfBtn.removeAttribute('aria-disabled');
                    pdfSpinner.classList.add('d-none');
                    pdfText.textContent = 'PDF';
                }
            }

            function getFileNameFromDisposition(disposition, fallbackName) {
                if (!disposition) return fallbackName;

                const utf8Match = disposition.match(/filename\*=UTF-8''([^;]+)/i);
                if (utf8Match && utf8Match[1]) {
                    return decodeURIComponent(utf8Match[1]);
                }

                const asciiMatch = disposition.match(/filename="?([^"]+)"?/i);
                if (asciiMatch && asciiMatch[1]) {
                    return asciiMatch[1];
                }

                return fallbackName;
            }

            pdfBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                if (isLoading) return;

                const url = pdfBtn.getAttribute('href');
                const fallbackName = pdfBtn.dataset.fallbackName || 'quote.pdf';

                if (!url) return;

                setPdfLoading(true);

                try {
                    const res = await fetch(url, {
                        method: 'GET',
                        credentials: 'same-origin'
                    });

                    if (!res.ok) {
                        throw new Error('Failed to generate PDF.');
                    }

                    const contentType = res.headers.get('Content-Type') || '';
                    if (!contentType.toLowerCase().includes('application/pdf')) {
                        throw new Error('Response is not a PDF file.');
                    }

                    const blob = await res.blob();

                    const disposition = res.headers.get('Content-Disposition') || '';
                    const fileName = getFileNameFromDisposition(disposition, fallbackName);

                    const blobUrl = window.URL.createObjectURL(blob);
                    const tempLink = document.createElement('a');
                    tempLink.href = blobUrl;
                    tempLink.download = fileName;
                    document.body.appendChild(tempLink);
                    tempLink.click();
                    tempLink.remove();

                    window.URL.revokeObjectURL(blobUrl);
                } catch (err) {
                    console.error(err);
                    alert('Failed to download PDF.');
                } finally {
                    setPdfLoading(false);
                }
            });
        })();
                (function () {
            const signedPdfBtn = document.getElementById('downloadSignedPdfBtn');
            const signedPdfSpinner = document.getElementById('downloadSignedPdfSpinner');
            const signedPdfText = signedPdfBtn?.querySelector('.signed-pdf-btn-text');

            if (!signedPdfBtn || !signedPdfSpinner || !signedPdfText) return;

            let signedPdfBusy = false;
            let signedPdfResetTimer = null;

            function setSignedPdfLoading(isBusy) {
                signedPdfBusy = isBusy;

                if (isBusy) {
                    signedPdfBtn.classList.add('disabled');
                    signedPdfBtn.setAttribute('aria-disabled', 'true');
                    signedPdfSpinner.classList.remove('d-none');
                    signedPdfText.textContent = 'Loading...';
                } else {
                    signedPdfBtn.classList.remove('disabled');
                    signedPdfBtn.removeAttribute('aria-disabled');
                    signedPdfSpinner.classList.add('d-none');
                    signedPdfText.textContent = 'Signed PDF';
                }
            }

            signedPdfBtn.addEventListener('click', function () {
                if (signedPdfBusy) return;

                setSignedPdfLoading(true);

                if (signedPdfResetTimer) {
                    clearTimeout(signedPdfResetTimer);
                }

                signedPdfResetTimer = setTimeout(function () {
                    setSignedPdfLoading(false);
                }, 4000);
            });

            window.addEventListener('focus', function () {
                if (!signedPdfBusy) return;
                setSignedPdfLoading(false);
            });

            window.addEventListener('pageshow', function () {
                if (!signedPdfBusy) return;
                setSignedPdfLoading(false);
            });
        })();
    </script>
}


