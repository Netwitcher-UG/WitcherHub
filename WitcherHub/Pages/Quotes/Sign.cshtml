@page "/quotes/sign/{id:guid?}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using System.Text.Json
@using WitcherHub.Resources
@attribute [AllowAnonymous]
@model WitcherHub.Pages.Quotes.SignModel
@inject IStringLocalizer<SharedResource> T

@functions {
    string L(string key, string fallback)
    {
        var value = T[key];
        return value.ResourceNotFound ? fallback : value.Value;
    }
}

@{
    ViewData["Title"] = L("quotePage_Title", "Quote");
    Layout = "_ContractsLayout";
}

@if (!Model.IsQuoteExpired)
{
    <form method="post" id="afForm">
        @Html.AntiForgeryToken()
    </form>

    <input type="hidden" id="signEndpoint"
           value="@Url.Page("/Quotes/Sign", "Sign", new { id = Model.Id, t = Model.Token })" />

    <script>
        window.contractServerState = @Html.Raw(JsonSerializer.Serialize(new {
            isSigned = Model.IsSigned,
            signedAtIso = Model.SignedAtIso ?? "",
            signatureDataUrl = Model.SignatureDataUrl ?? "",
            signerName = Model.SignerNamePrefill ?? "",
            signerEmail = Model.SignerEmailPrefill ?? ""
        }));
    </script>
}

<div class="contractPage">
    <div class="contractPage__langFab" aria-label="@L("contractPage_LanguageSwitch", "Language switch")">
        <button class="contractPage__langBtn" type="button" data-culture="en">EN</button>
        <button class="contractPage__langBtn" type="button" data-culture="de">DE</button>
    </div>

    <div class="contractPage__container">
        <div class="contractPage__paper" id="paper">

            @if (Model.IsQuoteExpired)
            {
             <section class="contractExpired" aria-label="Quote expired">
    <div class="contractExpired__icon">!</div>
    <h1 class="contractExpired__title">Das Angebot ist abgelaufen</h1>
    <p class="contractExpired__message">Bitte wenden Sie sich an den zuständigen Administrator.</p>
    @if (!string.IsNullOrWhiteSpace(Model.QuoteExpiresAtDisplay))
    {
        <div class="contractExpired__date">Ablaufdatum: @Model.QuoteExpiresAtDisplay</div>
    }
</section>
            }
            else
            {
            <div class="contractPage__contractHtml quotePdfScope">
                @Html.Raw(Model.QuoteHtml)
            </div>

            <div class="contractActions" id="contractActions">
                <label class="contractActions__agree" for="chkAgree">
    <input type="checkbox" id="chkAgree" />

    <span>
        Ich habe die
        <a id="termsLink"
           href="https://netwitcher.com/de/agb-fuer-agenturen"
           target="_blank"
           rel="noopener noreferrer">
            Bedingungen
        </a>
        gelesen und stimme dem
        <a id="contractLink"
           href="https://netwitcher.com/de/datenschutzerklaerung"
           target="_blank"
           rel="noopener noreferrer">
            Vertrag
        </a>
        zu.

        <span class="contractActions__text">
            Bitte lesen Sie beide Inhalte sorgfältig, bevor Sie unterschreiben.
        </span>
    </span>
</label>

                <div class="contractActions__right">
                    <div class="contractActions__badge" id="signedBadge">@L("contractPage_Unsigned", "Unsigned")</div>

                    <button class="contractActions__btn contractActions__btn--primary" type="button" id="btnOpen" disabled>
                        @L("contractPage_SignAccept", "Sign & Accept")
                    </button>

                    <button class="contractActions__btn" type="button" id="btnPrint">@L("contractPage_Print", "Print")</button>
                    <button class="contractActions__btn" type="button" id="btnReset">@L("contractPage_Reset", "Reset")</button>
                </div>
            </div>

            <section class="contractSign" aria-label="@L("contractPage_SignaturesTitle", "Quote signature")">
                <h2 class="contractSign__title">@L("contractPage_SignaturesTitle", "Signature")</h2>

                <div class="contractSign__grid">
                    <div>
                        <div class="contractSign__party">@L("contractPage_CustomerParty", "Customer")</div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@L("contractPage_LabelName", "Name")</div>
                            <input id="customerName"
                                   class="contractSign__input"
                                   type="text"
                                   value="@Model.SignerNamePrefill"
                                   autocomplete="name" />
                        </div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@L("contractPage_LabelEmail", "Email")</div>
                            <input id="customerEmail"
                                   class="contractSign__input"
                                   type="email"
                                   value="@Model.SignerEmailPrefill"
                                   autocomplete="email" />
                        </div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@L("contractPage_LabelDate", "Date")</div>
                            <div class="contractSign__line"><span id="customerDate"></span></div>
                        </div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@L("contractPage_LabelSignature", "Signature")</div>
                            <div id="sigBoxClick"
                                 class="contractSign__sigLine"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@L("contractPage_AddSignatureAria", "Add signature")">
                                <img id="sigImage" class="contractSign__sigImg" alt="@L("contractPage_LabelSignature", "Signature")" />
                                <span id="sigPlaceholder" class="contractSign__placeholder"></span>
                            </div>
                        </div>

                        <div class="contractSign__meta">
                            @L("contractPage_SignedAtLabel", "Signed at"): <span id="signedAt"></span>
                        </div>
                    </div>

                    <div>
                        <div class="contractSign__party">@L("contractPage_ProviderParty", "Provider")</div>

                        <div class="contractSign__providerBlock">
                            <div class="contractSign__providerName">@Model.ProviderName</div>
                            <div class="contractSign__providerAddress">@Model.ProviderAddress</div>
                        </div>

                        <div class="contractSign__providerNote">
                            (@L("contractPage_ProviderSignsInternally", "Provider signs internally"))
                        </div>
                    </div>
                </div>
            </section>
            }

        </div>
    </div>

    @if (!Model.IsQuoteExpired)
    {
    <div class="contractPage__toast" id="toast"></div>

    <div class="contractPage__modal" id="sigModal" aria-hidden="true">
        <div class="contractPage__modalCard" role="dialog" aria-modal="true">
            <div class="contractPage__modalHead">
                <div>@L("contractPage_ModalTitle", "Add signature")</div>
                <button class="contractPage__btn" type="button" id="btnClose" aria-label="@L("contractPage_Close", "Close")">✕</button>
            </div>

            <div class="contractPage__modalBody">
                <div class="contractPage__modalHint">@L("contractPage_ModalHint", "Use your mouse or finger to sign below.")</div>

                <div class="contractPage__sigPad">
                    <canvas id="sigCanvas" tabindex="0"></canvas>
                </div>

                <div class="contractPage__modalActions">
                    <button class="contractPage__btn" type="button" id="btnClear">@L("contractPage_Clear", "Clear")</button>
                    <button class="contractPage__btn contractPage__btn--primary" type="button" id="btnAccept">
                        @L("contractPage_AcceptSignature", "Accept signature")
                    </button>
                    <button class="contractPage__btn" type="button" id="btnCancel">@L("contractPage_Cancel", "Cancel")</button>
                </div>

                <div class="contractPage__modalStatus" id="modalStatus"></div>
            </div>
        </div>
    </div>
    }
</div>

@section Scripts {
    @if (!Model.IsQuoteExpired)
    {
    <script>
        window.contractPageI18n = {
            fillName: "@L("contractPage_ErrFillName", "Please enter your name before signing.")",
            fillEmail: "@L("contractPage_ErrFillEmail", "Please enter your email before signing.")",
            fillFields: "@L("contractPage_ErrFillFields", "Please fill all required fields.")",
            invalidEmail: "@L("contractPage_ErrInvalidEmail", "Please enter a valid email address.")",
            emptyCanvas: "@L("contractPage_ErrEmptyCanvas", "Please sign first.")",
            mustAgree: "@L("contractPage_ErrMustAgree", "Please confirm agreement before signing.")",
            cleared: "@L("contractPage_Cleared", "Cleared.")",
            signedOk: "@L("contractPage_SignedOk", "Quote signed successfully.")",
            signed: "@L("contractPage_Signed", "Signed")",
            unsigned: "@L("contractPage_Unsigned", "Unsigned")",
            unauthorized: "@L("contractPage_ErrUnauthorized", "This signing link is invalid or expired.")",
            alreadySigned: "@L("contractPage_ErrAlreadySigned", "This quote is already signed.")",
            notFound: "@L("contractPage_ErrNotFound", "Quote not found.")",
            genericError: "@L("contractPage_ErrGeneric", "Something went wrong. Please try again.")",
            saving: "@L("contractPage_Saving", "Saving...")"
        };
    </script>

    <script src="~/js/pages/contracts/contract-sign.js" asp-append-version="true"></script>
    }
}
