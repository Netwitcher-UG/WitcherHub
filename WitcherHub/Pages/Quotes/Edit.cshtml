@page
@using System.Text
@using System.Text.Json
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Quotes.EditModel

@{
    ViewData["Title"] = "Edit Quote";
}

@if (Model.Quote is null)
{
    <div class="alert alert-danger">Quote not found.</div>
    return;
}

@functions {
    string FmtDate(DateTimeOffset? d) => d?.ToString("yyyy-MM-dd") ?? "";

    decimal ReadDec(JsonDocument? doc, string prop, decimal fallback = 0m)
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d)) return d;
            if (v.ValueKind == JsonValueKind.String && decimal.TryParse(v.GetString(), out var ds)) return ds;
            return fallback;
        }
        catch { return fallback; }
    }

    decimal ReadNestedDec(JsonDocument? doc, string parent, string prop, decimal fallback = 0m)
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(parent, out var p)) return fallback;
            if (p.ValueKind != JsonValueKind.Object) return fallback;
            if (!p.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d)) return d;
            if (v.ValueKind == JsonValueKind.String && decimal.TryParse(v.GetString(), out var ds)) return ds;
            return fallback;
        }
        catch { return fallback; }
    }

    string ReadNestedStr(JsonDocument? doc, string parent, string prop, string fallback = "")
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(parent, out var p)) return fallback;
            if (p.ValueKind != JsonValueKind.Object) return fallback;
            if (!p.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.String) return v.GetString() ?? fallback;
            return fallback;
        }
        catch { return fallback; }
    }

    // ✅ Base64 encode JSON safely for HTML attributes
    string ToB64(string s)
        => Convert.ToBase64String(Encoding.UTF8.GetBytes(s ?? "{}"));
}

@{
    var isDraft = Model.Quote.Status == DocumentStatus.Draft;
    var items = Model.Quote.Items.OrderBy(x => x.Position).ToList();

    // Totals for the sidebar
    decimal sumSub = 0m;
    decimal sumDisc = 0m;
    decimal sumTax = 0m;
    decimal sumTotal = 0m;

    foreach (var it in items)
    {
        var subTotal = ReadDec(it.PriceBreakdown, "subTotal", it.LineTotal);
        var discountAmt = ReadNestedDec(it.PriceBreakdown, "discount", "amount", 0m);

        sumSub += subTotal;
        sumDisc += discountAmt;
    }

    // ✅ VAT على كامل الفاتورة فقط
    var net = Math.Max(0m, sumSub - sumDisc);      // ✅ بعد الخصم
    sumTax = (Model.Quote.ApplyVat ? net * 0.19m : 0m);
    sumTotal = net + sumTax;

    // Re-open canvas if validation fails
    var openAddCanvas = ViewContext.ViewData.ModelState.Keys.Any(k => k.StartsWith("NewItem") || k == "NewItemConfigJson");
    var openEditCanvas = ViewContext.ViewData.ModelState.Keys.Any(k => k.StartsWith("EditItem") || k == "EditItemConfigJson");
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <div class="text-muted small">Quote</div>
        <h3 class="mb-1">@Model.Quote.QuoteNo</h3>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="badge @(isDraft ? "bg-success" : "bg-warning text-dark")">@Model.Quote.Status</span>
            <span class="text-muted">Currency: <strong>@Model.Quote.Currency</strong></span>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        
        <a class="btn btn-outline-primary" asp-page="/Quotes/Details" asp-route-id="@Model.Quote.Id">Preview</a>

        <form method="post" asp-page-handler="DeleteQuote" asp-route-id="@Model.Id" class="d-inline js-delete-form">
            <button class="btn btn-outline-danger js-delete-open"
                    type="button"
                    data-delete-title="Delete quote"
                    data-delete-message="Are you sure you want to delete this quote?">
                Delete
            </button>
        </form>
    </div>
</div>

@if (!isDraft)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <div>
            <strong>Locked:</strong> Positions cannot be changed because status is <strong>@Model.Quote.Status</strong>.
        </div>
        <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#headerCollapse">
            Edit header anyway
        </button>
    </div>
}

<div class="row g-3 align-items-start js-pointer">
    <!-- MAIN -->
    <div class="col-12 col-lg-8">
        <!-- Header -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center quote-card-toggle"
                 role="button"
                 data-bs-toggle="collapse"
                 data-bs-target="#headerCollapse"
                 aria-expanded="true"
                 aria-controls="headerCollapse">
                <div class="fw-semibold mb-0">Header</div>
            </div>

            <div id="headerCollapse" class="collapse show">
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateHeader" asp-route-id="@Model.Id">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Header.Quote.ProjectId" />

                        <div class="row g-3 align-items-stretch">
                            <input type="hidden" name="Header.Quote.Currency" value="EUR" />

                            <div class="col-12 col-md-3">
                                <label class="form-label">Status</label>
                                <select class="form-select js-pointer-select" asp-for="Header.Quote.Status">
                                    <option value="Draft">Draft</option>
                                    <option value="Sent">Sent</option>
                                    <option value="Accepted">Accepted</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="Signed">Signed</option>
                                    <option value="Terminated">Terminated</option>
                                </select>
                                <span class="text-danger small" asp-validation-for="Header.Quote.Status"></span>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label js-pointer-label">Issued At</label>
                                <input type="date"
                                       class="form-control js-themed-date js-datepicker js-pointer-date"
                                       name="Header.Quote.IssuedAt"
                                       value="@FmtDate(Model.Header.Quote.IssuedAt)" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label js-pointer-label">Expires At</label>
                                <input type="date"
                                       class="form-control js-themed-date js-datepicker js-pointer-date"
                                       name="Header.Quote.ExpiresAt"
                                       value="@FmtDate(Model.Header.Quote.ExpiresAt)" />
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="quote-vat-field">
                                    <label class="form-label">VAT</label>
                                    <div class="form-check d-flex align-items-center">
                                        <input class="form-check-input js-pointer-checkbox"
                                               asp-for="Header.Quote.ApplyVat"
                                               type="checkbox"
                                               id="QuoteApplyVat" />
                                        <label class="form-check-label js-pointer-label ms-2" for="QuoteApplyVat">
                                            Apply VAT (19%)
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">After customer signs</label>
                                <select class="form-select js-pointer-select"
                                        asp-for="Header.Quote.AfterCustomerSignAction"
                                        id="quoteAfterSignAction">
                                    <option value="@((int)QuoteAfterSignAction.Contract)">Create Contract</option>
                                    <option value="@((int)QuoteAfterSignAction.Invoice)">Send as Invoice</option>
                                </select>
                                <span class="text-danger small" asp-validation-for="Header.Quote.AfterCustomerSignAction"></span>
                            </div>

                            <div class="col-12 col-md-6" id="quoteInvoiceSendModeWrap">
                                <label class="form-label">Invoice Send Mode</label>
                                <select class="form-select js-pointer-select"
                                        asp-for="Header.Quote.InvoiceSendMode"
                                        id="quoteInvoiceSendMode">
                                    <option value="@((int)InvoiceSendMode.Automatic)">Automatic</option>
                                    <option value="@((int)InvoiceSendMode.Manual)">Manual</option>
                                </select>
                                <span class="text-danger small" asp-validation-for="Header.Quote.InvoiceSendMode"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" rows="3" asp-for="Header.Quote.Notes"></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button class="btn btn-primary" type="submit">Save header</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Items -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div class="fw-semibold">Positions</div>
                    <div class="text-muted small">Quick edit totals, and open advanced edit only when needed.</div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-primary @(isDraft ? "" : "disabled") "
                       asp-page="/Quotes/Items/Create"
                       asp-route-quoteId="@Model.Quote.Id"
                       aria-disabled="@(!isDraft)"
                       tabindex="@(isDraft ? "0" : "-1")">
                        From Services
                    </a>

                    <button class="btn btn-outline-primary" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#AddItemCanvas"
                            @(isDraft ? "" : "disabled")>
                        Quick add
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-12 col-md-8">
                        <label class="form-label mb-1">Search items</label>
                        <input class="form-control" id="itemSearch" placeholder="Type to filter by title..." />
                    </div>
                    <div class="col-12 col-md-4 text-md-end">
                        <div class="text-muted small">Items: <strong>@items.Count</strong></div>
                    </div>
                </div>

                @if (items.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No items yet. Use <strong>From catalog</strong> or <strong>Quick add</strong>.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="itemsTable">
                            <thead>
                                <tr>
                                    <th style="width:70px;">#</th>
                                    <th>Item</th>
                                    <th class="text-end" style="width:90px;">Qty</th>
                                    <th class="text-end" style="width:120px;">Unit</th>
                                    <th class="text-end" style="width:180px;">Total</th>
                                    <th class="text-end" style="width:160px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in items)
                                {
                                    var subTotal = ReadDec(it.PriceBreakdown, "subTotal", it.LineTotal);
                                    var discountAmt = ReadNestedDec(it.PriceBreakdown, "discount", "amount", 0m);
                                    var total = ReadDec(it.PriceBreakdown, "total", it.LineTotal);

                                    var dt = ReadNestedStr(it.PriceBreakdown, "discount", "type", "");
                                    var discVal = it.DiscountValue?.ToString() ?? "";
                                    var cfg = it.Config?.RootElement.GetRawText() ?? "{}";
                                    var cfgB64 = ToB64(cfg);

                                    <tr data-title="@(it.Title?.ToString()?.ToLowerInvariant() ?? "")">
                                        <td class="text-muted">@it.Position</td>

                                        <td>
                                            <div class="fw-semibold">@it.Title</div>

                                            @if (!string.IsNullOrWhiteSpace(it.Description))
                                            {
                                                <div class="text-muted small">@it.Description</div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(it.UnitName))
                                            {
                                                <div class="text-muted small">Unit: @it.UnitName</div>
                                            }

                                            <div class="text-muted small">
                                                Sub: <strong>@subTotal.ToString("0.00")</strong>
                                                &nbsp;•&nbsp; Disc: <strong>@discountAmt.ToString("0.00")</strong>
                                            </div>
                                        </td>

                                        <td class="text-end">@it.Quantity.ToString("0.##")</td>
                                        <td class="text-end">@it.UnitPrice.ToString("0.00")</td>
                                        <td class="text-end fw-semibold">@total.ToString("0.00")</td>

                                        <td class="text-end">
                                            @if (isDraft)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        data-bs-toggle="offcanvas"
                                                        data-bs-target="#EditItemCanvas"
                                                        data-item-id="@it.Id"
                                                        data-item-service-id="@it.ServiceId"
                                                        data-item-title="@it.Title"
                                                        data-item-qty="@it.Quantity"
                                                        data-item-unit="@it.UnitPrice"
                                                        data-item-pos="@it.Position"
                                                        data-item-description="@it.Description"
                                                        data-item-unitname="@it.UnitName"
                                                        data-item-billingcycle="@((int)it.BillingCycle)"
                                                        data-item-disctype="@dt"
                                                        data-item-discval="@discVal"
                                                        data-item-config-b64="@cfgB64">
                                                    Edit
                                                </button>

                                                <form method="post" asp-page-handler="DeleteItem" asp-route-id="@Model.Id" class="d-inline js-delete-form">
                                                    <input type="hidden" name="id" value="@Model.Quote.Id" />
                                                    <input type="hidden" name="itemId" value="@it.Id" />
                                                    <button class="btn btn-sm btn-outline-danger js-delete-open"
                                                            type="button"
                                                            data-delete-title="Delete item"
                                                            data-delete-message="Are you sure you want to delete this item?">
                                                        Delete
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Locked</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SIDEBAR -->
    <div class="col-12 col-lg-4">
        <div class="card sticky-top" style="top: 1rem;">
            <div class="card-header fw-semibold">Summary</div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <div class="text-muted">Subtotal</div>
                    <div class="fw-semibold">@sumSub.ToString("0.00")</div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <div class="text-muted">Discounts</div>
                    <div class="fw-semibold">-@sumDisc.ToString("0.00")</div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <div class="text-muted">Tax</div>
                    <div class="fw-semibold">@sumTax.ToString("0.00")</div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted">Total</div>
                    <div class="fs-4 fw-bold">@sumTotal.ToString("0.00")</div>
                </div>

                <div class="text-muted small mt-2">
                    Currency: <strong>@Model.Quote.Currency</strong>
                </div>
            </div>

            <div class="card-footer d-grid gap-2">
                <a class="btn btn-outline-primary" asp-page="/Quotes/Details" asp-route-id="@Model.Quote.Id">Preview</a>
                <a class="btn btn-outline-secondary" asp-page="/Projects">Back to projects</a>
            </div>
        </div>
    </div>
</div>

<!-- OFFCANVAS: QUICK ADD -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="AddItemCanvas" aria-labelledby="AddItemCanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="AddItemCanvasLabel">Quick add item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <form method="post" asp-page-handler="AddItem" asp-route-id="@Model.Id" id="addItemForm">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" asp-for="NewItem.Item.Title" />
                <span class="text-danger small" asp-validation-for="NewItem.Item.Title"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Unit Name</label>
                <input class="form-control" asp-for="NewItem.Item.UnitName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" asp-for="NewItem.Item.Description" rows="3"></textarea>
            </div>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label">Qty</label>
                    <input class="form-control"  asp-for="NewItem.Item.Quantity" />

                </div>
                <div class="col-4">
                    <label class="form-label">Unit</label>
                    <input class="form-control" asp-for="NewItem.Item.UnitPrice" />
                </div>
                <div class="col-4">
                    <label class="form-label">Pos</label>
                    <input class="form-control" asp-for="NewItem.Item.Position" />
                </div>
            </div>

            <div class="accordion mt-3" id="addItemAdvanced">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="addItemAdvancedHeading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#addItemAdvancedBody">
                            Advanced ( discounts / config)
                        </button>
                    </h2>

                    <div id="addItemAdvancedBody" class="accordion-collapse collapse" data-bs-parent="#addItemAdvanced">
                        <div class="accordion-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Discount Type</label>
                                    <select class="form-select" asp-for="NewItem.Item.DiscountType">
                                        <option value="">-- none --</option>
                                        <option value="Percent">Percent</option>
                                        <option value="Amount">Amount</option>
                                        <option value="Fixed">Fixed</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Discount Value</label>
                                    <input class="form-control" asp-for="NewItem.Item.DiscountValue" />
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label mb-0">Config (JSON)</label>
                                    <button class="btn btn-sm btn-outline-secondary" type="button" onclick="formatJson('ni-config')">Format</button>
                                </div>
                                <textarea class="form-control mt-2" rows="6" asp-for="NewItemConfigJson" id="ni-config"></textarea>
                                <span class="text-danger small" asp-validation-for="NewItemConfigJson"></span>
                                <div class="form-text">Example: {"hours": 12, "rush": true}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-success" type="submit">Add item</button>
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="offcanvas">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- OFFCANVAS: EDIT ITEM -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="EditItemCanvas" aria-labelledby="EditItemCanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="EditItemCanvasLabel">Edit item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <form method="post" asp-page-handler="UpdateItem" asp-route-id="@Model.Id" id="editItemForm">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EditItem.ItemId" id="ei-id" />
            <input type="hidden" asp-for="EditItem.Item.ServiceId" id="ei-service-id" />
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" asp-for="EditItem.Item.Title" id="ei-title" />
            </div>
            <div class="mb-3">
                <label class="form-label">Unit Name</label>
                <input class="form-control" asp-for="EditItem.Item.UnitName" id="ei-unitname" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" asp-for="EditItem.Item.Description" id="ei-description" rows="3"></textarea>
            </div>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label">Qty</label>
                    <input class="form-control"  asp-for="EditItem.Item.Quantity" id="ei-qty" />
                </div>
                <div class="col-4">
                    <label class="form-label">Unit</label>
                    <input class="form-control" asp-for="EditItem.Item.UnitPrice" id="ei-unit" />
                </div>
                <div class="col-4">
                    <label class="form-label">Pos</label>
                    <input class="form-control" asp-for="EditItem.Item.Position" id="ei-pos" />
                </div>
                <div class="mt-2">
                    <label class="form-label">BillingCycle</label>
                    <select class="form-select"
                            asp-for="EditItem.Item.BillingCycle"
                            asp-items="Html.GetEnumSelectList<BillingCycle>()"
                            id="ei-billing">
                    </select>
                </div>
            </div>

            <div class="accordion mt-3" id="editItemAdvanced">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="editItemAdvancedHeading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#editItemAdvancedBody">
                            Advanced (discounts / config)
                        </button>
                    </h2>

                    <div id="editItemAdvancedBody" class="accordion-collapse collapse" data-bs-parent="#editItemAdvanced">
                        <div class="accordion-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Discount Type</label>
                                    <select class="form-select" asp-for="EditItem.Item.DiscountType" id="ei-disctype">
                                        <option value="">-- none --</option>
                                        <option value="Percent">Percent</option>
                                        <option value="Amount">Amount</option>
                                        <option value="Fixed">Fixed</option>
                                    </select>
                                </div>

                                <div class="col-6">
                                    <label class="form-label">Discount Value</label>
                                    <input class="form-control" asp-for="EditItem.Item.DiscountValue" id="ei-discval" />
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="card border bg-transparent">
                                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="fw-semibold">Config</div>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="eiCfgResetBtn">
                                                Reset
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#eiCfgRawCollapse"
                                                    aria-expanded="false">
                                                Raw JSON
                                            </button>
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <div id="ei-cfgLoading" class="text-muted small d-none">Loading config schema…</div>

                                        <div id="ei-cfgEmpty" class="text-muted small d-none">
                                            This item has no config schema. Existing config will be shown as editable fields when possible.
                                        </div>

                                        <div id="ei-cfgFields" class="row g-3"></div>

                                        <div class="collapse mt-3" id="eiCfgRawCollapse">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="form-label mb-0">Config (JSON)</label>
                                                <button class="btn btn-sm btn-outline-secondary" type="button" onclick="formatJson('ei-config')">
                                                    Format
                                                </button>
                                            </div>

                                            <textarea class="form-control mt-2 font-monospace" rows="7" asp-for="EditItemConfigJson" id="ei-config"></textarea>
                                            <span class="text-danger small" asp-validation-for="EditItemConfigJson"></span>
                                        </div>

                                        <div class="alert alert-info mt-3 mb-0">
                                            PriceBreakdown will be recalculated automatically when you save.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ✅ Price preview -->
            <hr class="my-3" />
            <div class="card bg-transparent border">
                <div class="card-header fw-semibold">Price preview</div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <div class="text-muted">Subtotal</div>
                        <div class="fw-semibold" id="ei-prev-sub">0.00</div>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <div class="text-muted">Discount</div>
                        <div class="fw-semibold" id="ei-prev-disc">-0.00</div>
                    </div>
                   

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted">Total</div>
                        <div class="fs-4 fw-bold" id="ei-prev-total">0.00</div>
                    </div>

                    <div class="text-muted small mt-2">
                        *Preview is client-side. Final pricing is recalculated on Save.
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-primary" type="submit">Save changes</button>
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="offcanvas">Cancel</button>
            </div>
        </form>
    </div>
</div>
<div class="modal fade quote-confirm-modal" id="DeleteConfirmModal" tabindex="-1" aria-labelledby="DeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteConfirmModalLabel">Confirm delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="DeleteConfirmModalMessage">Are you sure?</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="DeleteConfirmModalSubmit">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/quotes/date-input-theme.js" asp-append-version="true"></script>

    <script>
        // Filter items table
        (function () {
            const search = document.getElementById('itemSearch');
            if (!search) return;

            function applyFilter() {
                const q = (search.value || '').trim().toLowerCase();
                document.querySelectorAll('#itemsTable tbody tr').forEach(tr => {
                    const title = (tr.getAttribute('data-title') || '');
                    tr.style.display = (!q || title.includes(q)) ? '' : 'none';
                });
            }

            search.addEventListener('input', applyFilter);
        })();

        function eiComputePreview() {
            const qty = parseFloat(document.getElementById('ei-qty')?.value || '0') || 0;
            const unit = parseFloat(document.getElementById('ei-unit')?.value || '0') || 0;

            const sub = qty * unit;

            const discType = (document.getElementById('ei-disctype')?.value || '').trim();
            const discVal = parseFloat(document.getElementById('ei-discval')?.value || '0') || 0;

            let discAmt = 0;
            if (discType === 'Percent') discAmt = sub * (discVal / 100.0);
            else if (discType === 'Amount') discAmt = discVal;
            else if (discType === 'Fixed') discAmt = discVal;

            if (discAmt > sub) discAmt = sub;
            if (discAmt < 0) discAmt = 0;

            const total = Math.max(0, sub - discAmt);

            const f = (n) => (Math.round((n + Number.EPSILON) * 100) / 100).toFixed(2);

            const elSub = document.getElementById('ei-prev-sub');
            const elDisc = document.getElementById('ei-prev-disc');
            const elTotal = document.getElementById('ei-prev-total');

            if (elSub) elSub.textContent = f(sub);
            if (elDisc) elDisc.textContent = '-' + f(discAmt);
            if (elTotal) elTotal.textContent = f(total);
        }

        const eiServiceSchemaEndpoint = '@Url.Page("/Quotes/Items/Create", "ServiceSchema")';
        let eiConfigBaseObject = {};
        let eiLastSchema = null;

        function eiEncodeHtml(value) {
            return (value ?? '')
                .toString()
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
        }

        function eiParseJsonSafe(text) {
            try {
                const parsed = JSON.parse(text || '{}');
                if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                    return parsed;
                }
                return {};
            } catch {
                return {};
            }
        }

        function eiDeepClone(obj) {
            return JSON.parse(JSON.stringify(obj || {}));
        }

        function eiSetConfigJson(obj) {
            const raw = document.getElementById('ei-config');
            if (!raw) return;
            raw.value = JSON.stringify(obj || {}, null, 2);
        }

        function eiBuildSchemaUrl(serviceId) {
            const url = new URL(eiServiceSchemaEndpoint, window.location.origin);
            url.searchParams.set('serviceId', serviceId);
            return url.toString();
        }

        function eiGuessFieldType(value) {
            if (typeof value === 'boolean') return 'boolean';
            if (typeof value === 'number') return Number.isInteger(value) ? 'integer' : 'number';
            return 'string';
        }

        function eiNormalizeSchemaFields(schema, currentConfig) {
            let fields = [];

            if (schema && typeof schema === 'object') {
                if (schema.properties && typeof schema.properties === 'object' && !Array.isArray(schema.properties)) {
                    const required = Array.isArray(schema.required) ? schema.required : [];

                    fields = Object.entries(schema.properties).map(([name, meta]) => {
                        const m = meta || {};
                        const enumValues = Array.isArray(m.enum) ? m.enum : null;
                        let type = (m.type || '').toString().toLowerCase();

                        if (enumValues) type = 'select';
                        if (!type) type = eiGuessFieldType(currentConfig?.[name]);

                        return {
                            name,
                            title: m.title || m.label || name,
                            description: m.description || '',
                            type,
                            enumValues,
                            required: required.includes(name),
                            defaultValue: m.default,
                            minimum: m.minimum,
                            maximum: m.maximum
                        };
                    });
                } else if (Array.isArray(schema.fields)) {
                    fields = schema.fields
                        .filter(x => x && (x.name || x.key))
                        .map(x => {
                            const enumValues = Array.isArray(x.enum) ? x.enum : null;
                            let type = (x.type || '').toString().toLowerCase();

                            if (enumValues) type = 'select';
                            if (!type) type = eiGuessFieldType(currentConfig?.[x.name || x.key]);

                            return {
                                name: x.name || x.key,
                                title: x.title || x.label || x.name || x.key,
                                description: x.description || '',
                                type,
                                enumValues,
                                required: !!x.required,
                                defaultValue: x.default,
                                minimum: x.minimum,
                                maximum: x.maximum
                            };
                        });
                }
            }

            if (!fields.length) {
                fields = Object.entries(currentConfig || {}).map(([name, value]) => ({
                    name,
                    title: name,
                    description: '',
                    type: eiGuessFieldType(value),
                    enumValues: null,
                    required: false,
                    defaultValue: value
                }));
            }

            return fields.filter(x => !!x.name);
        }

        function eiResolveFieldValue(field, currentConfig) {
            if (currentConfig && Object.prototype.hasOwnProperty.call(currentConfig, field.name)) {
                return currentConfig[field.name];
            }

            if (field.defaultValue !== undefined) {
                return field.defaultValue;
            }

            if (field.type === 'boolean') return false;
            return '';
        }

        function eiRenderConfigFields(schema, currentConfig) {
            const container = document.getElementById('ei-cfgFields');
            const emptyEl = document.getElementById('ei-cfgEmpty');

            if (!container || !emptyEl) return;

            const fields = eiNormalizeSchemaFields(schema, currentConfig);
            eiLastSchema = schema;

            if (!fields.length) {
                container.innerHTML = '';
                emptyEl.classList.remove('d-none');
                eiSetConfigJson(currentConfig || {});
                return;
            }

            emptyEl.classList.add('d-none');

            const html = fields.map((field, index) => {
                const id = `ei-cfg-${index}`;
                const label = eiEncodeHtml(field.title || field.name);
                const name = eiEncodeHtml(field.name);
                const desc = field.description ? `<div class="form-text">${eiEncodeHtml(field.description)}</div>` : '';
                const requiredMark = field.required ? ' <span class="text-danger">*</span>' : '';
                const value = eiResolveFieldValue(field, currentConfig);

                let type = (field.type || 'string').toString().toLowerCase();
                if (type === 'bool') type = 'boolean';
                if (type === 'int') type = 'integer';
                if (type === 'text') type = 'string';

                if (type === 'boolean') {
                    return `
                        <div class="col-12 col-md-6">
                            <div class="form-check mt-4">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="${id}"
                                       data-ei-config-input
                                       data-config-name="${name}"
                                       data-config-type="boolean"
                                       ${value ? 'checked' : ''} />
                                <label class="form-check-label" for="${id}">
                                    ${label}${requiredMark}
                                </label>
                            </div>
                            ${desc}
                        </div>
                    `;
                }

                if (type === 'select' && Array.isArray(field.enumValues) && field.enumValues.length > 0) {
                    const options = field.enumValues.map(opt => {
                        const optVal = opt?.toString() ?? '';
                        const selected = (value?.toString() ?? '') === optVal ? 'selected' : '';
                        return `<option value="${eiEncodeHtml(optVal)}" ${selected}>${eiEncodeHtml(optVal)}</option>`;
                    }).join('');

                    return `
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="${id}">${label}${requiredMark}</label>
                            <select class="form-select"
                                    id="${id}"
                                    data-ei-config-input
                                    data-config-name="${name}"
                                    data-config-type="string">
                                ${options}
                            </select>
                            ${desc}
                        </div>
                    `;
                }

                const isNumber = type === 'number' || type === 'integer';
                const inputType = isNumber ? 'number' : 'text';
                const step = type === 'integer' ? '1' : (type === 'number' ? 'any' : null);
                const minAttr = field.minimum !== undefined && field.minimum !== null ? `min="${field.minimum}"` : '';
                const maxAttr = field.maximum !== undefined && field.maximum !== null ? `max="${field.maximum}"` : '';

                return `
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="${id}">${label}${requiredMark}</label>
                        <input class="form-control"
                               id="${id}"
                               type="${inputType}"
                               value="${eiEncodeHtml(value)}"
                               data-ei-config-input
                               data-config-name="${name}"
                               data-config-type="${eiEncodeHtml(type)}"
                               ${step ? `step="${step}"` : ''}
                               ${minAttr}
                               ${maxAttr} />
                        ${desc}
                    </div>
                `;
            }).join('');

            container.innerHTML = html;

            container.querySelectorAll('[data-ei-config-input]').forEach(el => {
                el.addEventListener('input', eiSyncConfigFromFields);
                el.addEventListener('change', eiSyncConfigFromFields);
            });

            eiSyncConfigFromFields();
        }

        function eiSyncConfigFromFields() {
            const container = document.getElementById('ei-cfgFields');
            if (!container) return;

            const next = eiDeepClone(eiConfigBaseObject);

            container.querySelectorAll('[data-ei-config-input]').forEach(el => {
                const name = el.getAttribute('data-config-name');
                const type = (el.getAttribute('data-config-type') || 'string').toLowerCase();

                if (!name) return;

                delete next[name];

                if (type === 'boolean') {
                    next[name] = !!el.checked;
                    return;
                }

                const raw = (el.value || '').trim();
                if (raw === '') return;

                if (type === 'integer') {
                    const parsed = parseInt(raw, 10);
                    if (!Number.isNaN(parsed)) next[name] = parsed;
                    return;
                }

                if (type === 'number') {
                    const parsed = parseFloat(raw);
                    if (!Number.isNaN(parsed)) next[name] = parsed;
                    return;
                }

                next[name] = raw;
            });

            eiSetConfigJson(next);
        }

        async function eiLoadConfigEditor(serviceId, configText) {
            const loadingEl = document.getElementById('ei-cfgLoading');
            const emptyEl = document.getElementById('ei-cfgEmpty');
            const currentConfig = eiParseJsonSafe(configText);

            eiConfigBaseObject = eiDeepClone(currentConfig);

            if (loadingEl) loadingEl.classList.remove('d-none');
            if (emptyEl) emptyEl.classList.add('d-none');

            try {
                if (!serviceId) {
                    eiRenderConfigFields(null, currentConfig);
                    return;
                }

                const res = await fetch(eiBuildSchemaUrl(serviceId), {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                });

                const text = await res.text();
                let schema = null;

                if (res.ok && text && text.trim() && text.trim() !== 'null') {
                    schema = JSON.parse(text);
                }

                eiRenderConfigFields(schema, currentConfig);
            } catch {
                eiRenderConfigFields(null, currentConfig);
            } finally {
                if (loadingEl) loadingEl.classList.add('d-none');
            }
        }

        document.addEventListener('show.bs.offcanvas', function (e) {
            const el = e.target;
            if (!el || el.id !== 'EditItemCanvas') return;

            const btn = e.relatedTarget;

            if (btn) {
                document.getElementById('ei-id').value = btn.getAttribute('data-item-id') || '';
                document.getElementById('ei-service-id').value = btn.getAttribute('data-item-service-id') || '';
                document.getElementById('ei-title').value = btn.getAttribute('data-item-title') || '';
                document.getElementById('ei-qty').value = btn.getAttribute('data-item-qty') || '1';
                document.getElementById('ei-unit').value = btn.getAttribute('data-item-unit') || '0';
                document.getElementById('ei-pos').value = btn.getAttribute('data-item-pos') || '1';
                document.getElementById('ei-billing').value = btn.getAttribute('data-item-billingcycle') || '0';
                document.getElementById('ei-disctype').value = btn.getAttribute('data-item-disctype') || '';
                document.getElementById('ei-discval').value = btn.getAttribute('data-item-discval') || '';
                document.getElementById('ei-unitname').value = btn.getAttribute('data-item-unitname') || '';
                document.getElementById('ei-description').value = btn.getAttribute('data-item-description') || '';

                const b64 = btn.getAttribute('data-item-config-b64');
                let cfgText = '{}';

                try {
                    if (b64) {
                        const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
                        cfgText = new TextDecoder('utf-8').decode(bytes);
                    }
                } catch {
                    cfgText = '{}';
                }

                document.getElementById('ei-config').value = cfgText;
            }

            const serviceId = document.getElementById('ei-service-id')?.value || '';
            const cfgText = document.getElementById('ei-config')?.value || '{}';

            eiLoadConfigEditor(serviceId, cfgText);
            eiComputePreview();
        });

        (function () {
            const ids = ['ei-qty', 'ei-unit', 'ei-disctype', 'ei-discval'];
            ids.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('input', eiComputePreview);
                el.addEventListener('change', eiComputePreview);
            });

            const resetBtn = document.getElementById('eiCfgResetBtn');
            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    eiRenderConfigFields(eiLastSchema, eiDeepClone(eiConfigBaseObject));
                });
            }

            const rawConfigEl = document.getElementById('ei-config');
            if (rawConfigEl) {
                rawConfigEl.addEventListener('change', function () {
                    const current = eiParseJsonSafe(rawConfigEl.value);
                    eiRenderConfigFields(eiLastSchema, current);
                });
            }
        })();

        function formatJson(textareaId) {
            const el = document.getElementById(textareaId);
            if (!el) return;

            try {
                const obj = JSON.parse(el.value || "{}");
                el.value = JSON.stringify(obj, null, 2);

                if (textareaId === 'ei-config') {
                    eiRenderConfigFields(eiLastSchema, eiParseJsonSafe(el.value));
                }
            } catch {
                alert("Invalid JSON. Please fix it first.");
            }
        }
        window.formatJson = formatJson;

        (function () {
            const openAdd = @openAddCanvas.ToString().ToLowerInvariant();
            const openEdit = @openEditCanvas.ToString().ToLowerInvariant();

            if (openAdd) {
                const el = document.getElementById('AddItemCanvas');
                if (el) bootstrap.Offcanvas.getOrCreateInstance(el).show();
            }

            if (openEdit) {
                const el = document.getElementById('EditItemCanvas');
                if (el) bootstrap.Offcanvas.getOrCreateInstance(el).show();
            }
        })();

        (function () {
            if (window.quoteDateTheme) {
                window.quoteDateTheme.init(document);
            }
        })();

        (function () {
            const modalEl = document.getElementById('DeleteConfirmModal');
            const titleEl = document.getElementById('DeleteConfirmModalLabel');
            const messageEl = document.getElementById('DeleteConfirmModalMessage');
            const confirmBtn = document.getElementById('DeleteConfirmModalSubmit');

            if (!modalEl || !titleEl || !messageEl || !confirmBtn || !window.bootstrap) return;

            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            let pendingForm = null;

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.js-delete-open');
                if (!btn) return;

                pendingForm = btn.closest('form');
                if (!pendingForm) return;

                titleEl.textContent = btn.getAttribute('data-delete-title') || 'Confirm delete';
                messageEl.textContent = btn.getAttribute('data-delete-message') || 'Are you sure?';

                modal.show();
            });

            confirmBtn.addEventListener('click', function () {
                if (!pendingForm) return;

                const form = pendingForm;
                pendingForm = null;
                modal.hide();

                if (typeof form.requestSubmit === 'function') {
                    form.requestSubmit();
                } else {
                    form.submit();
                }
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                pendingForm = null;
            });
        })();

        (function () {
            const actionEl = document.getElementById('quoteAfterSignAction');
            const modeWrapEl = document.getElementById('quoteInvoiceSendModeWrap');
            const modeEl = document.getElementById('quoteInvoiceSendMode');

            function toggleInvoiceMode() {
                if (!actionEl) return;

                const isInvoice = actionEl.value === '@((int)QuoteAfterSignAction.Invoice)';
                if (modeWrapEl) modeWrapEl.classList.toggle('d-none', !isInvoice);
                if (modeEl) modeEl.disabled = !isInvoice;
            }

            if (actionEl) {
                actionEl.addEventListener('change', toggleInvoiceMode);
                toggleInvoiceMode();
            }
        })();
    </script>
}






