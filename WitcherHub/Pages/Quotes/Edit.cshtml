@page
@using System.Text
@using System.Text.Json
@using System.Globalization
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Quotes.EditModel

@{
    ViewData["Title"] = "Edit Quote";
}
<style>
    .wh-icon-btn {
        width: 38px;
        height: 38px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .wh-icon-btn i {
            font-size: 20px;
            line-height: 1;
        }

    .wh-btn-primary {
        background-color: rgb(107 76 230);
        border-color: rgb(107 76 230);
        color: #fff;
    }

        .wh-btn-primary:hover,
        .wh-btn-primary:focus,
        .wh-btn-primary:active,
        .wh-btn-primary.active,
        .show > .wh-btn-primary.dropdown-toggle {
            background-color: rgb(95 66 214);
            border-color: rgb(95 66 214);
            color: #fff;
        }

        .wh-btn-primary:focus {
            box-shadow: 0 0 0 .25rem rgba(107, 76, 230, .25);
        }

    .wh-icon-btn-plain {
        width: 38px;
        height: 38px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
    }

        .wh-icon-btn-plain:hover,
        .wh-icon-btn-plain:focus,
        .wh-icon-btn-plain:active {
            border: 0 !important;
            background: rgba(255, 255, 255, .06) !important;
            box-shadow: none !important;
        }

        .wh-icon-btn-plain i {
            font-size: 20px;
            line-height: 1;
        }
</style>
@if (Model.Quote is null)
{
    <div class="alert alert-danger">Quote not found.</div>
    return;
}

@functions {
    string FmtDate(DateTimeOffset? d) => d?.ToString("yyyy-MM-dd") ?? "";

    decimal ReadDec(JsonDocument? doc, string prop, decimal fallback = 0m)
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d)) return d;
            if (v.ValueKind == JsonValueKind.String && decimal.TryParse(v.GetString(), out var ds)) return ds;
            return fallback;
        }
        catch { return fallback; }
    }

    decimal ReadNestedDec(JsonDocument? doc, string parent, string prop, decimal fallback = 0m)
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(parent, out var p)) return fallback;
            if (p.ValueKind != JsonValueKind.Object) return fallback;
            if (!p.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d)) return d;
            if (v.ValueKind == JsonValueKind.String && decimal.TryParse(v.GetString(), out var ds)) return ds;
            return fallback;
        }
        catch { return fallback; }
    }

    string ReadNestedStr(JsonDocument? doc, string parent, string prop, string fallback = "")
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(parent, out var p)) return fallback;
            if (p.ValueKind != JsonValueKind.Object) return fallback;
            if (!p.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.String) return v.GetString() ?? fallback;
            return fallback;
        }
        catch { return fallback; }
    }

    // ✅ Base64 encode JSON safely for HTML attributes
    string ToB64(string s)
        => Convert.ToBase64String(Encoding.UTF8.GetBytes(s ?? "{}"));
}

@{
    var isDraft = Model.Quote.Status == DocumentStatus.Draft;
    var items = Model.Quote.Items.OrderBy(x => x.Position).ToList();

    // Totals for the sidebar
    decimal sumSub = 0m;   // subtotal before discount
    decimal sumDisc = 0m;
    decimal sumTax = 0m;
    decimal sumTotal = 0m;

    foreach (var it in items)
    {
        var gross = ReadDec(it.PriceBreakdown, "baseTotal", it.Quantity * it.UnitPrice);
        var discountAmt = ReadNestedDec(it.PriceBreakdown, "discount", "amount", 0m);

        sumSub += gross;
        sumDisc += discountAmt;
    }

    var net = Math.Max(0m, sumSub - sumDisc);
    sumTax = (Model.Quote.ApplyVat ? net * 0.19m : 0m);
    sumTotal = net + sumTax;

    // Re-open canvas if validation fails
    var openAddCanvas = ViewContext.ViewData.ModelState.Keys.Any(k => k.StartsWith("NewItem") || k == "NewItemConfigJson");
    var openEditCanvas = ViewContext.ViewData.ModelState.Keys.Any(k => k.StartsWith("EditItem") || k == "EditItemConfigJson");
}
@if (Model.Quote is null)
{
    <div class="alert alert-danger">Quote not found.</div>
    return;
}

<div class="mb-3">
    <div class="mb-1">
        <a class="text-decoration-none text-muted small"
           asp-page="/Projects/Workspace"
           asp-route-id="@Model.Quote.ProjectId"
           asp-route-tab="quotes"
           title="Back to Project Workspace - Quotes">
            Project Workspace / Quotes
        </a>
    </div>

    <h3 class="mb-0">Edit Quote</h3>
</div>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">@Model.Quote.QuoteNo</h3>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="badge @(isDraft ? "bg-success" : "bg-warning text-dark")">@Model.Quote.Status</span>
            <span class="text-muted">Currency: <strong>@Model.Quote.Currency</strong></span>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap align-items-center">
        <a class="btn btn-outline-primary wh-icon-btn"
           asp-page="/Quotes/Details"
           asp-route-id="@Model.Quote.Id"
           title="Preview"
           aria-label="Preview">
            <i class="material-icons-outlined">visibility</i>
        </a>

        <form method="post" asp-page-handler="DeleteQuote" asp-route-id="@Model.Id" class="d-inline js-delete-form">
            <button class="btn btn-outline-danger wh-icon-btn js-delete-open"
                    type="button"
                    data-delete-title="Delete quote"
                    data-delete-message="Are you sure you want to delete this quote?"
                    title="Delete"
                    aria-label="Delete">
                <i class="material-icons-outlined">delete</i>
            </button>
        </form>
    </div>
</div>

@if (!isDraft)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <div>
            <strong>Locked:</strong> Positions cannot be changed because status is <strong>@Model.Quote.Status</strong>.
        </div>
        <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#headerCollapse">
            Edit header anyway
        </button>
    </div>
}

<div class="row g-3 align-items-start js-pointer">
    <!-- MAIN -->
    <div class="col-12 col-lg-8">
        <!-- Header -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center quote-card-toggle"
                 role="button"
                 data-bs-toggle="collapse"
                 data-bs-target="#headerCollapse"
                 aria-expanded="true"
                 aria-controls="headerCollapse">
                <div class="fw-semibold mb-0">Header</div>
            </div>

            <div id="headerCollapse" class="collapse show">
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateHeader" asp-route-id="@Model.Id">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Header.Quote.ProjectId" />

                        <div class="row g-3 align-items-stretch">
                            <input type="hidden" name="Header.Quote.Currency" value="EUR" />

                            <div class="col-12 col-md-3">
                                <label class="form-label">Status</label>
                                <select class="form-select js-pointer-select" asp-for="Header.Quote.Status">
                                    <option value="Draft">Draft</option>
                                    <option value="Sent">Sent</option>
                                    <option value="Accepted">Accepted</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="Signed">Signed</option>
                                    <option value="Terminated">Terminated</option>
                                </select>
                                <span class="text-danger small" asp-validation-for="Header.Quote.Status"></span>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label js-pointer-label">Issued At</label>
                                <input type="date"
                                       class="form-control js-themed-date js-datepicker js-pointer-date"
                                       name="Header.Quote.IssuedAt"
                                       value="@FmtDate(Model.Header.Quote.IssuedAt)" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label js-pointer-label">Expires At</label>
                                <input type="date"
                                       class="form-control js-themed-date js-datepicker js-pointer-date"
                                       name="Header.Quote.ExpiresAt"
                                       value="@FmtDate(Model.Header.Quote.ExpiresAt)" />
                            </div>

                            <div class="col-12 col-md-3">
                                <div class="quote-vat-field">
                                    <label class="form-label">VAT</label>
                                    <div class="form-check d-flex align-items-center">
                                        <input class="form-check-input js-pointer-checkbox"
                                               asp-for="Header.Quote.ApplyVat"
                                               type="checkbox"
                                               id="QuoteApplyVat" />
                                        <label class="form-check-label js-pointer-label ms-2" for="QuoteApplyVat">
                                            Apply VAT (19%)
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">After customer signs</label>
                                <select class="form-select js-pointer-select"
                                        asp-for="Header.Quote.AfterCustomerSignAction"
                                        id="quoteAfterSignAction">
                                    <option value="@((int)QuoteAfterSignAction.Contract)">Create Contract</option>
                                    <option value="@((int)QuoteAfterSignAction.Invoice)">Send as Invoice</option>
                                </select>
                                <span class="text-danger small" asp-validation-for="Header.Quote.AfterCustomerSignAction"></span>
                            </div>

                            <div class="col-12 col-md-6" id="quoteInvoiceSendModeWrap">
                                <label class="form-label">Invoice Send Mode</label>
                                <select class="form-select js-pointer-select"
                                        asp-for="Header.Quote.InvoiceSendMode"
                                        id="quoteInvoiceSendMode">
                                    <option value="@((int)InvoiceSendMode.Automatic)">Automatic</option>
                                    <option value="@((int)InvoiceSendMode.Manual)">Manual</option>
                                </select>
                                <span class="text-danger small" asp-validation-for="Header.Quote.InvoiceSendMode"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" rows="3" asp-for="Header.Quote.Notes"></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button class="btn wh-btn-primary" type="submit">Save header</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Items -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div class="fw-semibold">Positions</div>
                    <div class="text-muted small">Quick edit totals, and open advanced edit only when needed.</div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn wh-btn-primary @(isDraft ? "" : "disabled") "
                       asp-page="/Quotes/Items/Create"
                       asp-route-quoteId="@Model.Quote.Id"
                       aria-disabled="@(!isDraft)"
                       tabindex="@(isDraft ? "0" : "-1")">
                        From Services
                    </a>

                    <button class="btn btn-outline-primary" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#AddItemCanvas"
                            @(isDraft ? "" : "disabled")>
                        Quick add
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-12 col-md-8">
                        <label class="form-label mb-1">Search items</label>
                        <input class="form-control" id="itemSearch" placeholder="Type to filter by title..." />
                    </div>
                    <div class="col-12 col-md-4 text-md-end">
                        <div class="text-muted small">Items: <strong>@items.Count</strong></div>
                    </div>
                </div>

                @if (items.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No items yet. Use <strong>From catalog</strong> or <strong>Quick add</strong>.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="itemsTable">
                            <thead>
                                <tr>
                                    <th style="width:70px;">#</th>
                                    <th>Item</th>
                                    <th class="text-end" style="width:90px;">Qty</th>
                                    <th class="text-end" style="width:120px;">Unit</th>
                                    <th class="text-end" style="width:180px;">Total</th>
                                    <th class="text-end" style="width:160px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in items)
                                {
                                    var subTotal = ReadDec(it.PriceBreakdown, "baseTotal", it.Quantity * it.UnitPrice);
                                    var discountAmt = ReadNestedDec(it.PriceBreakdown, "discount", "amount", 0m);
                                    var total = ReadDec(it.PriceBreakdown, "total", it.LineTotal);

                                    var dt = ReadNestedStr(it.PriceBreakdown, "discount", "type", "");
                                    var discVal = it.DiscountValue?.ToString() ?? "";
                                    var cfg = it.Config?.RootElement.GetRawText() ?? "{}";
                                    var cfgB64 = ToB64(cfg);

                                    <tr data-title="@(it.Title?.ToString()?.ToLowerInvariant() ?? "")">
                                        <td class="text-muted">@it.Position</td>

                                        <td>
                                            <div class="fw-semibold">@it.Title</div>

                                            @if (!string.IsNullOrWhiteSpace(it.Description))
                                            {
                                                <div class="text-muted small">@it.Description</div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(it.UnitName))
                                            {
                                                <div class="text-muted small">Unit: @it.UnitName</div>
                                            }

                                            <div class="text-muted small">
                                                Sub: <strong>@subTotal.ToString("0.00")</strong>
                                                &nbsp;•&nbsp; Disc: <strong>@discountAmt.ToString("0.00")</strong>
                                            </div>
                                        </td>

                                        <td class="text-end">@it.Quantity.ToString("0.##")</td>
                                        <td class="text-end">@it.UnitPrice.ToString("0.00")</td>
                                        <td class="text-end fw-semibold">@total.ToString("0.00")</td>

                                        <td class="text-end">
                                            @if (isDraft)
                                            {
                                                <button type="button"
                                                        class="btn text-primary wh-icon-btn-plain"
                                                        data-bs-toggle="offcanvas"
                                                        data-bs-target="#EditItemCanvas"
                                                        data-item-id="@it.Id"
                                                        data-item-service-id="@it.ServiceId"
                                                        data-item-title="@it.Title"
                                                        data-item-qty="@(it.Quantity.ToString("0.########", CultureInfo.InvariantCulture))"
                                                        data-item-unit="@(it.UnitPrice.ToString("0.########", CultureInfo.InvariantCulture))"
                                                        data-item-discval="@(it.DiscountValue?.ToString("0.########", CultureInfo.InvariantCulture) ?? "")"
                                                       data-item-unit="@it.UnitPrice"
                                                        data-item-pos="@it.Position"
                                                        data-item-description="@it.Description"
                                                        data-item-unitname="@it.UnitName"
                                                        data-item-billingcycle="@((int)it.BillingCycle)"
                                                        data-item-disctype="@dt"
                                                        data-item-discval="@discVal"
                                                        data-item-config-b64="@cfgB64"
                                                        title="Edit"
                                                        aria-label="Edit">
                                                    <i class="material-icons-outlined">edit</i>
                                                </button>

                                                <form method="post" asp-page-handler="DeleteItem" asp-route-id="@Model.Id" class="d-inline js-delete-form">
                                                    <input type="hidden" name="id" value="@Model.Quote.Id" />
                                                    <input type="hidden" name="itemId" value="@it.Id" />
                                                    <button class="btn text-danger wh-icon-btn-plain js-delete-open"
                                                            type="button"
                                                            data-delete-title="Delete item"
                                                            data-delete-message="Are you sure you want to delete this item?"
                                                            title="Delete"
                                                            aria-label="Delete">
                                                        <i class="material-icons-outlined">delete</i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Locked</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SIDEBAR -->
    <div class="col-12 col-lg-4">
        <div class="card sticky-top" style="top: 1rem;">
            <div class="card-header fw-semibold">Summary</div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <div class="text-muted">Subtotal</div>
                    <div class="fw-semibold">@sumSub.ToString("0.00")</div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <div class="text-muted">Discounts</div>
                    <div class="fw-semibold">-@sumDisc.ToString("0.00")</div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <div class="text-muted">Tax</div>
                    <div class="fw-semibold">@sumTax.ToString("0.00")</div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted">Total</div>
                    <div class="fs-4 fw-bold">@sumTotal.ToString("0.00")</div>
                </div>

                <div class="text-muted small mt-2">
                    Currency: <strong>@Model.Quote.Currency</strong>
                </div>
            </div>

           
        </div>
    </div>
</div>

<!-- OFFCANVAS: QUICK ADD -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="AddItemCanvas" aria-labelledby="AddItemCanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="AddItemCanvasLabel">Quick add item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <form method="post" asp-page-handler="AddItem" asp-route-id="@Model.Id" id="addItemForm">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" id="ni-service-id" value="" />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" asp-for="NewItem.Item.Title" id="ni-title" />
                <span class="text-danger small" asp-validation-for="NewItem.Item.Title"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Unit Name</label>
                <input class="form-control" asp-for="NewItem.Item.UnitName" id="ni-unitname" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" asp-for="NewItem.Item.Description" id="ni-description" rows="3"></textarea>
            </div>

            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label">Qty</label>
                    <input class="form-control"  asp-for="NewItem.Item.Quantity" id="ni-qty" />
                </div>

                <div class="col-4">
                    <label class="form-label">Unit</label>
                    <input class="form-control" asp-for="NewItem.Item.UnitPrice" id="ni-unit" />
                </div>

                <div class="col-4">
                    <label class="form-label">Pos</label>
                    <input class="form-control" asp-for="NewItem.Item.Position" id="ni-pos" />
                </div>

                <div class="mt-2">
                    <label class="form-label">BillingCycle</label>
                    <select class="form-select"
                            asp-for="NewItem.Item.BillingCycle"
                            asp-items="Html.GetEnumSelectList<BillingCycle>()"
                            id="ni-billing">
                    </select>
                </div>
            </div>

            <div class="accordion mt-3" id="addItemAdvanced">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="addItemAdvancedHeading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#addItemAdvancedBody">
                            Advanced (discounts / config)
                        </button>
                    </h2>

                    <div id="addItemAdvancedBody" class="accordion-collapse collapse" data-bs-parent="#addItemAdvanced">
                        <div class="accordion-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Discount Type</label>
                                    <select class="form-select" asp-for="NewItem.Item.DiscountType" id="ni-disctype">
                                        <option value="">-- none --</option>
                                        <option value="Percent">Percent</option>
                                        <option value="Amount">Amount</option>
                                        <option value="Fixed">Fixed</option>
                                    </select>
                                </div>

                                <div class="col-6">
                                    <label class="form-label">Discount Value</label>
                                    <input class="form-control" asp-for="NewItem.Item.DiscountValue" id="ni-discval" />
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="card border bg-transparent">
                                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="fw-semibold">Config</div>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="niCfgResetBtn">
                                                Reset
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#niCfgRawCollapse"
                                                    aria-expanded="false">
                                                Raw JSON
                                            </button>
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <div id="ni-cfgLoading" class="text-muted small d-none">Loading config schema…</div>

                                        <div id="ni-cfgEmpty" class="text-muted small d-none">
                                            This item has no config schema. Existing config will be shown as editable fields when possible.
                                        </div>

                                        <div id="ni-cfgFields" class="row g-3"></div>

                                        <div class="collapse mt-3" id="niCfgRawCollapse">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="form-label mb-0">Config (JSON)</label>
                                                <button class="btn btn-sm btn-outline-secondary" type="button" onclick="formatJson('ni-config')">
                                                    Format
                                                </button>
                                            </div>

                                            <textarea class="form-control mt-2 font-monospace" rows="7" asp-for="NewItemConfigJson" id="ni-config"></textarea>
                                            <span class="text-danger small" asp-validation-for="NewItemConfigJson"></span>
                                        </div>

                                        <div class="alert alert-info mt-3 mb-0">
                                            PriceBreakdown will be recalculated automatically when you add the item.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <div class="card bg-transparent border">
                <div class="card-header fw-semibold">Price preview</div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <div class="text-muted">Subtotal</div>
                        <div class="fw-semibold" id="ni-prev-sub">0.00</div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <div class="text-muted">Discount</div>
                        <div class="fw-semibold" id="ni-prev-disc">-0.00</div>
                    </div>

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted">Total</div>
                        <div class="fs-4 fw-bold" id="ni-prev-total">0.00</div>
