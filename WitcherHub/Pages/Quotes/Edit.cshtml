@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            const serviceSchemaEndpoint = '@Url.Page("/Quotes/Items/Create", "ServiceSchema")';

            const editors = {
                ni: { schema: null, baseObject: {} },
                ei: { schema: null, baseObject: {} }
            };

            function byId(id) {
                return document.getElementById(id);
            }

            function encodeHtml(value) {
                return (value ?? '')
                    .toString()
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function deepClone(obj) {
                return JSON.parse(JSON.stringify(obj || {}));
            }

            function parseJsonSafe(text) {
                try {
                    const parsed = JSON.parse(text || '{}');
                    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                        return parsed;
                    }
                    return {};
                } catch {
                    return {};
                }
            }

            function tryParseJsonObject(text) {
                try {
                    const parsed = JSON.parse(text || '{}');
                    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                        return parsed;
                    }
                    return {};
                } catch {
                    return null;
                }
            }

            function buildSchemaUrl(serviceId) {
                const url = new URL(serviceSchemaEndpoint, window.location.origin);
                url.searchParams.set('serviceId', serviceId);
                return url.toString();
            }

            function setConfigJson(prefix, obj) {
                const raw = byId(prefix + '-config');
                if (!raw) return;
                raw.value = JSON.stringify(obj || {}, null, 2);
            }

            function guessFieldType(value) {
                if (typeof value === 'boolean') return 'boolean';
                if (typeof value === 'number') return Number.isInteger(value) ? 'integer' : 'number';
                return 'string';
            }

            function normalizeSchemaFields(schema, currentConfig) {
                let fields = [];

                if (schema && typeof schema === 'object') {
                    if (schema.properties && typeof schema.properties === 'object' && !Array.isArray(schema.properties)) {
                        const required = Array.isArray(schema.required) ? schema.required : [];

                        fields = Object.entries(schema.properties).map(([name, meta]) => {
                            const m = meta || {};
                            const enumValues = Array.isArray(m.enum) ? m.enum : null;
                            let type = (m.type || '').toString().toLowerCase();

                            if (enumValues) type = 'select';
                            if (!type) type = guessFieldType(currentConfig?.[name]);

                            return {
                                name,
                                title: m.title || m.label || name,
                                description: m.description || '',
                                type,
                                enumValues,
                                required: required.includes(name),
                                defaultValue: m.default,
                                minimum: m.minimum,
                                maximum: m.maximum
                            };
                        });
                    }
                    else if (Array.isArray(schema.fields)) {
                        fields = schema.fields
                            .filter(x => x && (x.name || x.key))
                            .map(x => {
                                const enumValues = Array.isArray(x.enum) ? x.enum : null;
                                let type = (x.type || '').toString().toLowerCase();

                                if (enumValues) type = 'select';
                                if (!type) type = guessFieldType(currentConfig?.[x.name || x.key]);

                                return {
                                    name: x.name || x.key,
                                    title: x.title || x.label || x.name || x.key,
                                    description: x.description || '',
                                    type,
                                    enumValues,
                                    required: !!x.required,
                                    defaultValue: x.default,
                                    minimum: x.minimum,
                                    maximum: x.maximum
                                };
                            });
                    }
                }

                if (!fields.length) {
                    fields = Object.entries(currentConfig || {}).map(([name, value]) => ({
                        name,
                        title: name,
                        description: '',
                        type: guessFieldType(value),
                        enumValues: null,
                        required: false,
                        defaultValue: value
                    }));
                }

                return fields.filter(x => !!x.name);
            }

            function resolveFieldValue(field, currentConfig) {
                if (currentConfig && Object.prototype.hasOwnProperty.call(currentConfig, field.name)) {
                    return currentConfig[field.name];
                }

                if (field.defaultValue !== undefined) return field.defaultValue;
                if (field.type === 'boolean') return false;
                return '';
            }

            function syncConfigFromFields(prefix) {
                const state = editors[prefix];
                const container = byId(prefix + '-cfgFields');
                if (!container) return;

                const next = deepClone(state.baseObject);

                container.querySelectorAll('[data-' + prefix + '-config-input]').forEach(el => {
                    const name = el.getAttribute('data-config-name');
                    const type = (el.getAttribute('data-config-type') || 'string').toLowerCase();

                    if (!name) return;

                    delete next[name];

                    if (type === 'boolean') {
                        next[name] = !!el.checked;
                        return;
                    }

                    const raw = (el.value || '').trim();
                    if (raw === '') return;

                    if (type === 'integer') {
                        const parsed = parseInt(raw, 10);
                        if (!Number.isNaN(parsed)) next[name] = parsed;
                        return;
                    }

                    if (type === 'number') {
                        const parsed = parseFloat(raw);
                        if (!Number.isNaN(parsed)) next[name] = parsed;
                        return;
                    }

                    next[name] = raw;
                });

                setConfigJson(prefix, next);
            }

            function renderConfigFields(prefix, schema, currentConfig) {
                const state = editors[prefix];
                const container = byId(prefix + '-cfgFields');
                const emptyEl = byId(prefix + '-cfgEmpty');

                if (!container || !emptyEl) return;

                const fields = normalizeSchemaFields(schema, currentConfig);
                state.schema = schema;

                if (!fields.length) {
                    container.innerHTML = '';
                    emptyEl.classList.remove('d-none');
                    setConfigJson(prefix, currentConfig || {});
                    return;
                }

                emptyEl.classList.add('d-none');

                const html = fields.map((field, index) => {
                    const id = `${prefix}-cfg-${index}`;
                    const label = encodeHtml(field.title || field.name);
                    const name = encodeHtml(field.name);
                    const desc = field.description
                        ? `<div class="form-text">${encodeHtml(field.description)}</div>`
                        : '';
                    const requiredMark = field.required ? ' <span class="text-danger">*</span>' : '';
                    const value = resolveFieldValue(field, currentConfig);

                    let type = (field.type || 'string').toString().toLowerCase();
                    if (type === 'bool') type = 'boolean';
                    if (type === 'int') type = 'integer';
                    if (type === 'text') type = 'string';

                    if (type === 'boolean') {
                        return `
                                    <div class="col-12 col-md-6">
                                        <div class="form-check mt-4">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="${id}"
                                                   data-${prefix}-config-input
                                                   data-config-name="${name}"
                                                   data-config-type="boolean"
                                                   ${value ? 'checked' : ''} />
                                            <label class="form-check-label" for="${id}">
                                                ${label}${requiredMark}
                                            </label>
                                        </div>
                                        ${desc}
                                    </div>
                                `;
                    }

                    if (type === 'select' && Array.isArray(field.enumValues) && field.enumValues.length > 0) {
                        const options = field.enumValues.map(opt => {
                            const optVal = opt?.toString() ?? '';
                            const selected = (value?.toString() ?? '') === optVal ? 'selected' : '';
                            return `<option value="${encodeHtml(optVal)}" ${selected}>${encodeHtml(optVal)}</option>`;
                        }).join('');

                        return `
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="${id}">${label}${requiredMark}</label>
                                        <select class="form-select"
                                                id="${id}"
                                                data-${prefix}-config-input
                                                data-config-name="${name}"
                                                data-config-type="string">
                                            ${options}
                                        </select>
                                        ${desc}
                                    </div>
                                `;
                    }

                    const isNumber = type === 'number' || type === 'integer';
                    const inputType = isNumber ? 'number' : 'text';
                    const step = type === 'integer' ? '1' : (type === 'number' ? 'any' : null);
                    const minAttr = field.minimum !== undefined && field.minimum !== null ? `min="${field.minimum}"` : '';
                    const maxAttr = field.maximum !== undefined && field.maximum !== null ? `max="${field.maximum}"` : '';

                    return `
                                <div class="col-12 col-md-6">
                                    <label class="form-label" for="${id}">${label}${requiredMark}</label>
                                    <input class="form-control"
                                           id="${id}"
                                           type="${inputType}"
                                           value="${encodeHtml(value)}"
                                           data-${prefix}-config-input
                                           data-config-name="${name}"
                                           data-config-type="${encodeHtml(type)}"
                                           ${step ? `step="${step}"` : ''}
                                           ${minAttr}
                                           ${maxAttr} />
                                    ${desc}
                                </div>
                            `;
                }).join('');

                container.innerHTML = html;

                container.querySelectorAll('[data-' + prefix + '-config-input]').forEach(el => {
                    el.addEventListener('input', function() {
                        syncConfigFromFields(prefix);
                    });

                    el.addEventListener('change', function() {
                        syncConfigFromFields(prefix);
                    });
                });

                syncConfigFromFields(prefix);
            }

            async function loadConfigEditor(prefix, serviceId, configText) {
                const state = editors[prefix];
                const loadingEl = byId(prefix + '-cfgLoading');
                const emptyEl = byId(prefix + '-cfgEmpty');
                const currentConfig = parseJsonSafe(configText);

                state.baseObject = deepClone(currentConfig);

                if (loadingEl) loadingEl.classList.remove('d-none');
                if (emptyEl) emptyEl.classList.add('d-none');

                try {
                    if (!serviceId) {
                        renderConfigFields(prefix, null, currentConfig);
                        return;
                    }

                    const res = await fetch(buildSchemaUrl(serviceId), {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' },
                        credentials: 'same-origin'
                    });

                    const text = await res.text();
                    let schema = null;

                    if (res.ok && text && text.trim() && text.trim() !== 'null') {
                        schema = JSON.parse(text);
                    }

                    renderConfigFields(prefix, schema, currentConfig);
                } catch {
                    renderConfigFields(prefix, null, currentConfig);
                } finally {
                    if (loadingEl) loadingEl.classList.add('d-none');
                }
            }

            function computePreview(prefix) {
                const qty = parseFloat(byId(prefix + '-qty')?.value || '0') || 0;
                const unit = parseFloat(byId(prefix + '-unit')?.value || '0') || 0;

                const sub = qty * unit;

                const discType = (byId(prefix + '-disctype')?.value || '').trim();
                const discVal = parseFloat(byId(prefix + '-discval')?.value || '0') || 0;

                let discAmt = 0;

                if (discType === 'Percent') {
                    discAmt = sub * (discVal / 100.0);
                } else if (discType === 'Amount') {
                    discAmt = discVal;
                } else if (discType === 'Fixed') {
                    discAmt = discVal;
                }

                if (discAmt > sub) discAmt = sub;
                if (discAmt < 0) discAmt = 0;

                const total = Math.max(0, sub - discAmt);

                const format = (n) => {
                    return (Math.round((n + Number.EPSILON) * 100) / 100).toFixed(2);
                };

                const elSub = byId(prefix + '-prev-sub');
                const elDisc = byId(prefix + '-prev-disc');
                const elTotal = byId(prefix + '-prev-total');

                if (elSub) elSub.textContent = format(sub);
                if (elDisc) elDisc.textContent = '-' + format(discAmt);
                if (elTotal) elTotal.textContent = format(total);
            }

            function bindPreview(prefix) {
                ['qty', 'unit', 'disctype', 'discval'].forEach(suffix => {
                    const el = byId(prefix + '-' + suffix);
                    if (!el) return;

                    el.addEventListener('input', function() {
                        computePreview(prefix);
                    });

                    el.addEventListener('change', function() {
                        computePreview(prefix);
                    });
                });
            }

            function bindConfigReset(prefix) {
                const btn = byId(prefix + 'CfgResetBtn');
                if (!btn) return;

                btn.addEventListener('click', function() {
                    renderConfigFields(prefix, editors[prefix].schema, deepClone(editors[prefix].baseObject));
                });
            }

            function bindRawConfig(prefix) {
                const raw = byId(prefix + '-config');
                if (!raw) return;

                raw.addEventListener('change', function() {
                    const parsed = tryParseJsonObject(raw.value);
                    if (parsed === null) return;
                    renderConfigFields(prefix, editors[prefix].schema, parsed);
                });
            }

            function decodeBase64Utf8(b64) {
                try {
                    const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
                    return new TextDecoder('utf-8').decode(bytes);
                } catch {
                    return '{}';
                }
            }

            function populateEditFromButton(btn) {
                if (!btn) return;

                const mappings = [
                    ['ei-id', 'data-item-id'],
                    ['ei-service-id', 'data-item-service-id'],
                    ['ei-title', 'data-item-title'],
                    ['ei-qty', 'data-item-qty'],
                    ['ei-unit', 'data-item-unit'],
                    ['ei-pos', 'data-item-pos'],
                    ['ei-billing', 'data-item-billingcycle'],
                    ['ei-disctype', 'data-item-disctype'],
                    ['ei-discval', 'data-item-discval'],
                    ['ei-unitname', 'data-item-unitname'],
                    ['ei-description', 'data-item-description']
                ];

                mappings.forEach(([id, attr]) => {
                    const el = byId(id);
                    if (!el) return;
                    el.value = btn.getAttribute(attr) || '';
                });

                const cfgEl = byId('ei-config');
                if (cfgEl) {
                    const b64 = btn.getAttribute('data-item-config-b64');
                    cfgEl.value = b64 ? decodeBase64Utf8(b64) : '{}';
                }
            }

            function formatJson(textareaId) {
                const el = byId(textareaId);
                if (!el) return;

                try {
                    const obj = JSON.parse(el.value || '{}');
                    el.value = JSON.stringify(obj, null, 2);

                    if (textareaId === 'ni-config') {
                        renderConfigFields('ni', editors.ni.schema, parseJsonSafe(el.value));
                    } else if (textareaId === 'ei-config') {
                        renderConfigFields('ei', editors.ei.schema, parseJsonSafe(el.value));
                    }
                } catch {
                    alert('Invalid JSON. Please fix it first.');
                }
            }

            window.formatJson = formatJson;
            let pendingDeleteForm = null;

function submitDeleteForm(form) {
    if (!form) return;

    if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
    } else {
        form.submit();
    }
}

function bindDeleteConfirm() {
    if (window.__quoteDeleteConfirmBound) return;
    window.__quoteDeleteConfirmBound = true;

    const modalEl = byId('DeleteConfirmModal');
    const titleEl = byId('DeleteConfirmModalLabel');
    const messageEl = byId('DeleteConfirmModalMessage');
    const submitBtn = byId('DeleteConfirmModalSubmit');

    const modal = modalEl && window.bootstrap
        ? bootstrap.Modal.getOrCreateInstance(modalEl)
        : null;

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.js-delete-open');
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        pendingDeleteForm = btn.closest('form.js-delete-form') || btn.closest('form');

        if (!pendingDeleteForm) {
            console.warn('Delete button has no parent form.');
            return;
        }

        const title = btn.getAttribute('data-delete-title') || 'Confirm delete';
        const message = btn.getAttribute('data-delete-message') || 'Are you sure?';

        if (titleEl) titleEl.textContent = title;
        if (messageEl) messageEl.textContent = message;

        if (modal) {
            modal.show();
        } else {
            if (confirm(message)) {
                submitDeleteForm(pendingDeleteForm);
            }
        }
    });

    if (submitBtn) {
        submitBtn.addEventListener('click', function () {
            if (!pendingDeleteForm) return;

            submitBtn.disabled = true;
            submitDeleteForm(pendingDeleteForm);
        });
    }

    if (modalEl) {
        modalEl.addEventListener('hidden.bs.modal', function () {
            pendingDeleteForm = null;
            if (submitBtn) submitBtn.disabled = false;
        });
    }
}
            document.addEventListener('DOMContentLoaded', function() {
                bindPreview('ni');
                bindPreview('ei');

                bindConfigReset('ni');
                bindConfigReset('ei');

                bindRawConfig('ni');
                bindRawConfig('ei');
                bindDeleteConfirm();
                const addCanvas = byId('AddItemCanvas');
                if (addCanvas) {
                    addCanvas.addEventListener('show.bs.offcanvas', async function() {
                        const serviceId = byId('ni-service-id')?.value || '';
                        const configText = byId('ni-config')?.value || '{}';

                        await loadConfigEditor('ni', serviceId, configText);
                        computePreview('ni');
                    });
                }

                const editCanvas = byId('EditItemCanvas');
                if (editCanvas) {
                    editCanvas.addEventListener('show.bs.offcanvas', async function(e) {
                        const btn = e.relatedTarget;
                        if (btn) {
                            populateEditFromButton(btn);
                        }

                        const serviceId = byId('ei-service-id')?.value || '';
                        const configText = byId('ei-config')?.value || '{}';

                        await loadConfigEditor('ei', serviceId, configText);
                        computePreview('ei');
                    });
                }

                const openAdd = @openAddCanvas.ToString().ToLowerInvariant();
                const openEdit = @openEditCanvas.ToString().ToLowerInvariant();

                if (openAdd && addCanvas && window.bootstrap) {
                    bootstrap.Offcanvas.getOrCreateInstance(addCanvas).show();
                }

                if (openEdit && editCanvas && window.bootstrap) {
                    bootstrap.Offcanvas.getOrCreateInstance(editCanvas).show();
                }

                computePreview('ni');
                computePreview('ei');
            });
        })();
    </script>
}







