@page
@using Microsoft.AspNetCore.Authorization
@using WitcherHub.Domain.SeedData
@attribute [Authorize(Policy = AppPolicyPrefixes.Permission + AppPermissions.ManageNetwitcher)]
@model WitcherHub.Pages.ProjectsModel

@{
    ViewData["Title"] = "Projects";
}

<div id="projectsTableCard" class="wh-tablecard-scroll">
    <partial name="_TableCard" model="Model.ProjectsTable" />
</div>

<partial name="~/Pages/Shared/Modals/_ModalShell.cshtml" model="Model.CreateProjectModal" />

<form id="tblDeleteForm" method="post" asp-page-handler="DeleteProject" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="projectId" id="tblDeleteProjectId" />
</form>

<input type="hidden" id="vcProjectWorkspaceUrl" value="@Url.Page("/Projects/Workspace")" />

<div class="modal fade quote-confirm-modal" id="DeleteProjectConfirmModal" tabindex="-1" aria-labelledby="DeleteProjectConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteProjectConfirmModalLabel">Delete project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="DeleteProjectConfirmModalMessage">Are you sure you want to delete this project?</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="DeleteProjectConfirmModalSubmit">Delete</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/projects/projects.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const openProjectId = params.get('openProjectId');
            if (!openProjectId) return;

            const tab = params.get('tab') || 'overview';
            const baseUrl = document.getElementById('vcProjectWorkspaceUrl')?.value || '/Projects/Workspace';

            const url = new URL(baseUrl, window.location.origin);
            url.searchParams.set('id', openProjectId);
            url.searchParams.set('tab', tab);

            window.location.href = url.pathname + url.search;
        });
    </script>
}


@if (Model.CreateProjectModal?.AutoOpen == true)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('FormModal');
            if (!el) return;

            function focusFirstError() {
                const firstErr = el.querySelector('.field-validation-error, .text-danger:not(:empty)');
                if (!firstErr) return;

                const input = firstErr.closest('.col-md-2,.col-md-4,.col-md-6,.col-md-8,.col-12')
                    ?.querySelector('input,select,textarea');

                if (input) input.focus();
            }

            function tryOpenModal(attempt) {
                const bsModal = window.bootstrap && window.bootstrap.Modal
                    ? window.bootstrap.Modal
                    : null;

                if (!bsModal) {
                    if (attempt >= 20) return;
                    window.setTimeout(function () { tryOpenModal(attempt + 1); }, 50);
                    return;
                }

                const m = bsModal.getOrCreateInstance(el);
                m.show();
                focusFirstError();
            }

            tryOpenModal(0);
        });
    </script>
}



