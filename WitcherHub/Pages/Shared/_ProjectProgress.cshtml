@using WitcherHub.Domain.Projects
@model WitcherHub.Pages.Models.UI.ProjectProgressVm

@*
    The state of one kind of document inside a project.

    Deliberately not a project status badge. A project's own status and the
    progress of its quotes, contracts and invoices are separate facts, and the
    list used to have one column trying to be both — which is why it could not
    honestly be either.

    Rendered small and quiet: at a glance you should read the project's status
    first and these second.
*@

@{
    @*
        The colour is written out, not assembled from the tone.

        This used to render class="text-@@tone-main", which produced
        "text-neutral-main" for anything not yet created — a class no stylesheet
        defines — so "None" and "Closed" came out with no colour at all.
    *@
    var (label, colour, icon) = Model.Progress switch
    {
        DocumentProgress.NotCreated => ("None", "text-secondary-light", "ri-subtract-line"),
        DocumentProgress.Draft => ("Draft", "text-warning-main", "ri-draft-line"),
        DocumentProgress.Awaiting => ("Sent", "text-info-main", "ri-send-plane-line"),
        DocumentProgress.Settled => (Model.SettledLabel, "text-success-main", "ri-checkbox-circle-line"),
        DocumentProgress.Closed => ("Closed", "text-secondary-light", "ri-close-circle-line"),
        _ => ("—", "text-secondary-light", "ri-subtract-line")
    };

    var muted = Model.Progress == DocumentProgress.NotCreated;
}

<span class="wh-progress @(muted ? "wh-progress--muted" : "")" title="@Model.Kind: @label">
    <i class="@icon"></i>
    <span class="wh-progress__kind">@Model.Kind</span>
    <span class="wh-progress__state @colour">@label</span>
</span>
