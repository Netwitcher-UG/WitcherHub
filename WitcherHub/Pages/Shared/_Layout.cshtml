@*
    The signed-in application shell: WowDash sidebar, top bar and content area.
*@
@{
    var toastType = TempData["Toast.Type"]?.ToString();
    var toastTitle = TempData["Toast.Title"]?.ToString();
    var toastMessage = TempData["Toast.Message"]?.ToString();

    // Only pages that ask for it get a heading row. Every list page already
    // renders its own title next to its primary action button, so rendering
    // ViewData["Title"] here as well printed the word twice.
    var heading = ViewData["Heading"]?.ToString();
    var subheading = ViewData["Subtitle"]?.ToString();
}

<!doctype html>
<html lang="en" data-theme="light">
<head>
    <partial name="_ThemeHead" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_AppSidebar" />

    <main class="dashboard-main">
        <partial name="_AppNavbar" />

        <div class="dashboard-main-body">
            @if (!string.IsNullOrWhiteSpace(heading))
            {
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
                    <h6 class="fw-semibold mb-0">@heading</h6>
                    @if (!string.IsNullOrWhiteSpace(subheading))
                    {
                        <ul class="d-flex align-items-center gap-2">
                            <li class="fw-medium">
                                <a asp-page="/Index" class="d-flex align-items-center gap-1 hover-text-primary">
                                    <i class="ri-home-smile-line text-lg"></i>
                                    Home
                                </a>
                            </li>
                            <li>-</li>
                            <li class="fw-medium">@subheading</li>
                        </ul>
                    }
                </div>
            }

            @RenderBody()
        </div>

        <footer class="d-footer">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <p class="mb-0">© @DateTime.UtcNow.Year Netwitcher UG. All rights reserved.</p>
                </div>
                <div class="col-auto">
                    <p class="mb-0">WitcherHub</p>
                </div>
            </div>
        </footer>
    </main>

    <!-- UI Kit: Loading Overlay -->
    <div id="appLoading" class="app-loading d-none" aria-hidden="true">
        <div class="app-loading__panel" role="status" aria-live="polite" aria-atomic="true">
            <div class="spinner-border app-loading__spinner" aria-hidden="true"></div>
            <div class="app-loading__text">Loading…</div>
        </div>
    </div>

    <!-- UI Kit: Single Global Modal -->
    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="appModalTitle">Modal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="appModalBody"></div>
                <div class="modal-footer" id="appModalFooter"></div>
            </div>
        </div>
    </div>

    <partial name="_ThemeScripts" />

    <script src="~/js/ui-kit.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            window.UI?.init?.();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (!string.IsNullOrWhiteSpace(toastType) && !string.IsNullOrWhiteSpace(toastMessage))
    {
        @*
            Serialised as JSON rather than interpolated into a JavaScript string
            literal. Razor HTML-encodes an interpolated value, which is the wrong
            encoding inside a <script> block: a toast saying "1.558,80 €" arrived
            in the browser as "1.558,80 &#x20AC;". JSON gives correct JavaScript
            escaping and closes the injection hole that quoting by hand leaves open.
        *@
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.UI?.toast?.show) {
                    UI.toast.show({
                        type: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastType)),
                        title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastTitle ?? "")),
                        msg: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMessage)),
                        timeout: 3500
                    });
                }
            });
        </script>
    }

    @* A toast queued before a full page reload, replayed once the new page is up. *@
    <script>
        (function () {
            'use strict';

            const KEY = 'vc.toast.afterReload';

            function showToast(t) {
                if (!t) return;
                const UI = window.UI || {};
                const type = String(t.type || '').toLowerCase();
                const title = t.title || '';
                const msg = t.message || '';

                const fallback = (m) => alert((title ? title + ": " : "") + m);

                if (UI.toast?.success && type === 'success') return UI.toast.success(msg, title);
                if (UI.toast?.warning && (type === 'warning' || type === 'warn')) return UI.toast.warning(msg, title);
                if (UI.toast?.info && type === 'info') return UI.toast.info(msg, title);
                if (UI.toast?.error) return UI.toast.error(msg, title);

                return fallback(msg);
            }

            document.addEventListener('DOMContentLoaded', function () {
                try {
                    const raw = sessionStorage.getItem(KEY);
                    if (!raw) return;
                    sessionStorage.removeItem(KEY);
                    showToast(JSON.parse(raw));
                } catch {
                    try { sessionStorage.removeItem(KEY); } catch { }
                }
            });
        })();
    </script>
</body>
</html>
