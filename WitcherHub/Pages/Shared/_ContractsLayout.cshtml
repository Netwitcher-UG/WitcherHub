@*
    Shell for the pages a customer opens from a link in an email — contract and
    quote signing. Deliberately bare: no navigation, nothing that hints at an
    application behind it, and nothing that needs a session.
*@
@using System.Globalization
<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.Name" data-theme="light">
<head>
    <partial name="_ThemeHead" />
    <link rel="stylesheet" href="~/css/contracts/contract-sign.css" asp-append-version="true">

    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-neutral-50">
    <main class="py-24 px-16">
        @RenderBody()
    </main>

    <partial name="_ThemeScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
