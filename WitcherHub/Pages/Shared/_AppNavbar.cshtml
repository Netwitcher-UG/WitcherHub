@using System.Security.Claims

@{
    var email = User.FindFirstValue(ClaimTypes.Email)
             ?? User.FindFirstValue("email")
             ?? User.Identity?.Name
             ?? "Signed in";

    var roles = User.FindAll(ClaimTypes.Role).Select(r => r.Value).ToList();
    var roleLabel = roles.Count == 0 ? "No role" : string.Join(", ", roles);
    var initial = char.ToUpperInvariant(email.FirstOrDefault(char.IsLetter) is var c && c != '\0' ? c : 'W');
}

@*
    The theme ships this bar with a global search box, a language picker and
    message and notification dropdowns filled with sample data. None of them is
    backed by anything here, so they are left out rather than shipped as controls
    that look real and do nothing.
*@
<div class="navbar-header">
    <div class="row align-items-center justify-content-between">
        <div class="col-auto">
            <div class="d-flex flex-wrap align-items-center gap-4">
                <button type="button" class="sidebar-toggle" aria-label="Collapse navigation">
                    <i class="ri-menu-line icon text-2xl non-active"></i>
                    <i class="ri-arrow-right-line icon text-2xl active"></i>
                </button>
                <button type="button" class="sidebar-mobile-toggle" aria-label="Open navigation">
                    <i class="ri-menu-line icon"></i>
                </button>
            </div>
        </div>

        <div class="col-auto">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <button type="button" data-theme-toggle
                        class="w-40-px h-40-px bg-neutral-200 rounded-circle d-flex justify-content-center align-items-center"
                        aria-label="Switch between light and dark"></button>

                <div class="dropdown">
                    <button class="w-40-px h-40-px bg-primary-600 text-white rounded-circle d-flex justify-content-center align-items-center fw-semibold"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account">
                        @initial
                    </button>

                    <div class="dropdown-menu to-top dropdown-menu-sm dropdown-menu-end">
                        <div class="py-12 px-16 radius-8 bg-primary-50 mb-16">
                            <h6 class="text-md text-primary-light fw-semibold mb-2 text-break">@email</h6>
                            <span class="text-secondary-light fw-medium text-sm">@roleLabel</span>
                        </div>

                        <form method="post" asp-page="/Auth/Logout" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="dropdown-item text-black px-0 py-8 hover-bg-transparent hover-text-danger d-flex align-items-center gap-3">
                                <i class="ri-logout-box-r-line text-xl"></i> Sign out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
