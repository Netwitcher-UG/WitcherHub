@model WitcherHub.Pages.IndexModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<!-- Customer Information -->
<div class="form-section">
    <div class="form-section-header">
        <i class="material-icons-outlined">person</i>
        <span>Customer Information</span>
    </div>
    <div class="form-section-divider"></div>

    <div class="row g-3 mt-0">
        <div class="col-md-4">
            <label class="form-label text-light">
                Customer Type <span class="text-danger">*</span>
            </label>

            <!-- نثبت id=type عشان JS -->
            <select class="form-select" id="type" asp-for="Customer.Type">
                <option value="Individual">Individual</option>
                <option value="Company">Company</option>
            </select>
            <span class="text-danger" asp-validation-for="Customer.Type"></span>
        </div>

        <!-- ✅ Individual First/Last -->
        <div class="col-md-4 individual-only">
            <label class="form-label text-light">
                First Name <span class="text-danger">*</span>
            </label>
            <input class="form-control"
                   asp-for="Customer.FirstName"
                   id="firstName"
                   placeholder="e.g. Anas"
                   required
                   aria-required="true" />
            <span class="text-danger" asp-validation-for="Customer.FirstName"></span>
        </div>

        <div class="col-md-4 individual-only">
            <label class="form-label text-light">
                Last Name <span class="text-danger">*</span>
            </label>
            <input class="form-control"
                   asp-for="Customer.LastName"
                   id="lastName"
                   placeholder="e.g. Sadek"
                   required
                   aria-required="true" />
            <span class="text-danger" asp-validation-for="Customer.LastName"></span>
        </div>

        <!-- ✅ Company Name -->
        <div class="col-md-8 company-only">
            <label class="form-label text-light">
                Company Name <span class="text-danger">*</span>
            </label>
            <input class="form-control"
                   asp-for="Customer.Name"
                   id="companyName"
                   placeholder="e.g. ACME LLC"
                   required
                   aria-required="true" />
            <span class="text-danger" asp-validation-for="Customer.Name"></span>
        </div>

        @* Emails (multi) - nicer UI *@
        <div class="col-12">
            <div class="card rounded-4 border bg-transparent">
                <div class="card-body p-3">

                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold text-light">
                                Emails <span class="text-danger">*</span>
                            </div>
                            <div class="small text-muted">Add one or more email addresses for this customer.</div>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                id="create-email-add"
                                title="Add email">
                            <i class="material-icons-outlined align-middle" style="font-size:18px">add</i>
                            <span class="ms-1">Add</span>
                        </button>
                    </div>

                    @* Header (desktop only) *@
                    <div class="row mt-3 small text-muted d-none d-md-flex">
                        <div class="col-md-4">Kind</div>
                        <div class="col-md-8">Email</div>
                    </div>

                    <div class="mt-2 d-flex flex-column gap-2" id="create-email-list">
                        @for (var i = 0; i < (Model.Customer.EmailAddresses?.Count ?? 0); i++)
                        {
                            <div class="email-row" data-email-row="create">

                                <div class="input-group">
                                    <select class="form-select"
                                            asp-for="Customer.EmailAddresses[i].Kind"
                                            style="max-width:170px">
                                        <option value="business">business</option>
                                        <option value="private">private</option>
                                        <option value="other">other</option>
                                    </select>

                                    <input class="form-control"
                                           asp-for="Customer.EmailAddresses[i].Email"
                                           type="email"
                                           placeholder="name@domain.com"
                                           required />

                                    <button type="button"
                                            class="btn btn-outline-danger create-email-remove"
                                            title="Remove email">
                                        <i class="material-icons-outlined align-middle" style="font-size:18px">delete</i>
                                    </button>
                                </div>

                                @* validation lines *@
                                <div class="row g-2 mt-1">
                                    <div class="col-12 col-md-4">
                                        <span class="text-danger small" asp-validation-for="Customer.EmailAddresses[i].Kind"></span>
                                    </div>
                                    <div class="col-12 col-md-8">
                                        <span class="text-danger small" asp-validation-for="Customer.EmailAddresses[i].Email"></span>
                                    </div>
                                </div>

                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>


        <div class="col-md-6">
            <label class="form-label text-light opacity-75">
                Phone <small>(optional)</small>
            </label>
            <input class="form-control" asp-for="Customer.Phone" />
            <span class="text-danger" asp-validation-for="Customer.Phone"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label text-light opacity-75">
                Tax ID <small>(optional)</small>
            </label>
            <input class="form-control" asp-for="Customer.TaxId" />
            <span class="text-danger" asp-validation-for="Customer.TaxId"></span>
        </div>

        <div class="col-md-12">
            <label class="form-label text-light opacity-75">
                Notes <small>(optional)</small>
            </label>
            <input class="form-control" asp-for="Customer.Notes" />
            <span class="text-danger" asp-validation-for="Customer.Notes"></span>
        </div>
    </div>
</div>

<!-- Address -->
<div class="form-section">
    <div class="form-section-header">
        <i class="material-icons-outlined">location_on</i>
        <span>Address</span>
    </div>
    <div class="form-section-divider"></div>

    <div class="row g-3 mt-0">
        <div class="col-md-4">
            <label class="form-label text-light">
                Label <span class="text-danger">*</span>
            </label>
            <select class="form-select" asp-for="Address.Label" required aria-required="true">
                <option>Billing</option>
                <option>Shipping</option>
                <option>Office</option>
                <option>Home</option>
            </select>
            <span class="text-danger" asp-validation-for="Address.Label"></span>
        </div>
        <div class="col-md-8">
            <label class="form-label text-light">
                Full Name / Company <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Address.FullNameOrCompany" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Address.FullNameOrCompany"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label text-light">
                Country <span class="text-danger">*</span>
            </label>

            <div class="dropdown">
                <input type="text"
                       class="form-control dropdown-toggle"
                       id="create-country-combo"
                       data-country-combo="true"
                       data-country-menu="create-country-menu"
                       data-country-select="Address_CountryCode"
                       data-bs-toggle="dropdown"
                       aria-expanded="false"
                       autocomplete="off"
                       placeholder="Search & select country..."
                       required
                       aria-required="true" />

                <ul class="dropdown-menu w-100"
                    id="create-country-menu"
                    aria-labelledby="create-country-combo"
                    style="max-height:280px; overflow-y:auto;">
                </ul>
            </div>

            <select asp-for="Address.CountryCode"
                    asp-items="Model.CountryOptions"
                    id="Address_CountryCode"
                    class="form-select"
                    data-country-name-target="Address_Country"
                    tabindex="-1"
                    aria-hidden="true"
                    style="position:absolute !important; left:-10000px !important; top:auto !important; width:1px !important; height:1px !important; overflow:hidden !important; opacity:0 !important; pointer-events:none !important;"
                    required>
            </select>

            <input type="hidden" asp-for="Address.Country" id="Address_Country" />

            <span class="text-danger" asp-validation-for="Address.CountryCode"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label text-light">
                City <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Address.City" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Address.City"></span>
        </div>

        

        <div class="col-md-4">
            <label class="form-label text-light">
                Postal Code <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Address.PostalCode" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Address.PostalCode"></span>
        </div>

        

        <div class="col-md-6">
            <label class="form-label text-light">
                Street / Nr <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Address.StreetRaw" placeholder="streetName Nr" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Address.StreetRaw"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label text-light">
                Address Line 2 <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Address.AddressLine2" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Address.AddressLine2"></span>
        </div>


    </div>
</div>

<!-- Primary Contact -->
<div id="contactSection" class="form-section">
    <div class="form-section-header">
        <i class="material-icons-outlined">contacts</i>
        <span>Primary Contact</span>
    </div>
    <div class="form-section-divider"></div>

    <div class="row g-3 mt-0">
        <div class="col-md-6">
            <label class="form-label text-light">
                Contact Name <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Contact.Name" placeholder="e.g. Sara Ahmed" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Contact.Name"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label text-light">
                Position <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Contact.Position" placeholder="e.g. Manager" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Contact.Position"></span>
        </div>

        <div class="col-md-6">
            
            <label class="form-label text-light">
                Contact Email <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Contact.Email" type="email" placeholder="e.g. sara@company.com" required aria-required="true" />
            <span class="text-danger" asp-validation-for="Contact.Email"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label text-light">
                Contact Phone <span class="text-danger">*</span>
            </label>
            <input class="form-control" asp-for="Contact.Phone" placeholder="e.g. 49174..." required aria-required="true" />
            <span class="text-danger" asp-validation-for="Contact.Phone"></span>
        </div>
    </div>
</div>
