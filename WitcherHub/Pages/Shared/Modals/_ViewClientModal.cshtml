@* Pages/Shared/Modals/_ViewClientModal.cshtml *@

<div class="modal fade" id="ViewClientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header border-bottom-0 py-2 vc-purple-modal-header text-white">
                <div class="d-flex align-items-center gap-3">
                    <i class="ri-eye-line"></i>
                    <div>
                        <h5 class="modal-title mb-0">Client Details</h5>
                        <small class="opacity-75" id="vc-subtitle">—</small>
                    </div>
                </div>

                <a href="javascript:;" class="primaery-menu-close text-white" data-bs-dismiss="modal" aria-label="Close">
                    <i class="ri-close-line"></i>
                </a>
            </div>


            <!-- Body -->
            <div class="modal-body">

                <!-- Top Summary -->
                <div class="card rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                            <div>
                                <h3 class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                                    <span id="vc-name">—</span>
                                    <span id="vc-lexwareBadge"></span>
                                </h3>

                                <div class="d-flex align-items-center gap-2">
                                    <span id="vc-typeBadge"></span>
                                    <span class="text-muted" id="vc-idText">—</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <button type="button"
                                        id="vc-exportBtn"
                                        class="btn p-0 border-0 bg-transparent text-warning d-none"
                                        data-vc-action="export-lexware"
                                        title="Export to Lexware">
                                    <i class="ri-upload-2-line"></i>
                                </button>

                                <button type="button"
                                        class="btn p-0 border-0 bg-transparent text-danger"
                                        title="Delete Client"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#vc-deleteClientCollapse">
                                    <i class="ri-delete-bin-line"></i>
                                </button>
                            </div>


                        </div>

                        <!-- Global Delete confirm -->
                        <div class="collapse mt-4" id="vc-deleteClientCollapse">
                            <div class="card rounded-4 border border-danger bg-transparent">
                                <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ri-error-warning-line text-danger"></i>
                                        <div>
                                            <div class="fw-semibold">Delete this client?</div>
                                            <small class="text-muted">This action cannot be undone.</small>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-light btn-sm"
                                                data-bs-toggle="collapse" data-bs-target="#vc-deleteClientCollapse">
                                            Cancel
                                        </button>

                                        <form method="post" asp-page-handler="DeleteClient" class="m-0">
                                            <input type="hidden" name="ClientId" id="vc-clientId-deleteClient" value="" />
                                            <button type="submit" class="btn btn-danger btn-sm" data-vc-confirm="delete-client">
                                                Confirm
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Sections Grid -->
                <div class="row g-4">

                    <!-- 1) Basic Info (kept as-is) -->
                    <div class="col-12 col-xl-6">
                        <div class="card rounded-4 h-100">
                            <div class="card-body">

                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ri-user-line opacity-75"></i>
                                        <h5 class="mb-0 fw-bold">Basic Information</h5>
                                    </div>

                                    <div class="d-flex gap-3">
                                        <button type="button"
                                                class="btn p-0 border-0 bg-transparent text-info"
                                                title="Edit"
                                                data-vc-action="edit-basic">
                                            <i class="ri-edit-line"></i>
                                        </button>

                                        

                                    </div>
                                </div>

