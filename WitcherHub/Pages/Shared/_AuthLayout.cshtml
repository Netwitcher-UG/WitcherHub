@*
    Shell for the pages a visitor can reach without signing in: login, forgot
    password, reset password. No sidebar, no top bar, nothing that assumes an
    identity.
*@
<!doctype html>
<html lang="en" data-theme="light">
<head>
    <partial name="_ThemeHead" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <section class="auth bg-base d-flex flex-wrap">
    @*
        The theme fills this panel with a stock illustration. Shipping a purchased
        template's placeholder art on the front door of a company's own system is
        worse than shipping nothing, so it carries the mark and the product name
        instead.
    *@
        <div class="auth-left d-lg-block d-none">
            <div class="d-flex align-items-center flex-column h-100 justify-content-center text-center px-24">
                <img src="~/img/netwitcher-logo.png" alt="" class="wh-auth-mark mb-32">
                <h4 class="mb-12">WitcherHub</h4>
                <p class="text-secondary-light text-lg mb-0" style="max-width: 24rem;">
                    Customers, projects, quotes, contracts and invoices, in one place.
                </p>
            </div>
        </div>

        <div class="auth-right py-32 px-24 d-flex flex-column justify-content-center">
            <div class="max-w-464-px mx-auto w-100">
                @RenderBody()
            </div>
        </div>
    </section>

    <partial name="_ThemeScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
