<!doctype html>
<html lang="en" data-bs-theme="blue-theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - WitcherHub</title>

    <link rel="icon" href="~/theme/assets/images/favicon-32x32.png" type="image/png">

    <link href="~/theme/assets/css/pace.min.css" rel="stylesheet" asp-append-version="true">
    <script src="~/theme/assets/js/pace.min.js" asp-append-version="true"></script>

    <link href="~/theme/assets/plugins/perfect-scrollbar/css/perfect-scrollbar.css" rel="stylesheet" asp-append-version="true">
    <link href="~/theme/assets/plugins/metismenu/metisMenu.min.css" rel="stylesheet" asp-append-version="true">
    <link href="~/theme/assets/plugins/metismenu/mm-vertical.css" rel="stylesheet" asp-append-version="true">

    <link href="~/theme/assets/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Material+Icons+Outlined" rel="stylesheet">

    <link href="~/theme/assets/css/bootstrap-extended.css" rel="stylesheet" asp-append-version="true">
    <link href="~/theme/sass/main.css" rel="stylesheet" asp-append-version="true">
    <link href="~/theme/sass/dark-theme.css" rel="stylesheet" asp-append-version="true">
    <link href="~/theme/sass/blue-theme.css" rel="stylesheet" asp-append-version="true">
    <link href="~/theme/sass/responsive.css" rel="stylesheet" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>

<body>
    @RenderBody()

    <script src="~/theme/assets/js/jquery.min.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
