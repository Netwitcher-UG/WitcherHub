@model WitcherHub.Pages.Models.UI.TableCardVm

<div class="row">
    <div class="col-12 col-xl-11 col-xxl-10 mx-auto">

        <!-- Toolbar -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h4 class="mb-0 fw-semibold text-light">@Model.Title</h4>

            @if (!string.IsNullOrWhiteSpace(Model.PrimaryButtonText) &&
                        !string.IsNullOrWhiteSpace(Model.PrimaryButtonTarget))
            {
                <button type="button"
                        class="btn btn-grd-primary px-4"
                        data-bs-toggle="modal"
                        data-bs-target="@Model.PrimaryButtonTarget">
                    @Model.PrimaryButtonText
                </button>
            }
        </div>

        <!-- Table Card -->
        <div class="card w-100 rounded-4">
            <div class="card-body">

              
                    @if (Model.Pagination is not null)
{
    var p = Model.Pagination;

    <form method="get" class="order-search position-relative my-3 w-25 ms-4">
        <input class="form-control rounded-5 px-5"
               type="text"
               name="@p.SearchParam"
               value="@p.SearchQuery"
               placeholder="@Model.SearchPlaceholder" />

        <input type="hidden" name="@p.PageParam" value="1" />
        <input type="hidden" name="@p.PageSizeParam" value="@p.PageSize" />

        <span class="material-icons-outlined position-absolute ms-3 translate-middle-y start-0 top-50">search</span>
    </form>
}


                    

                <div class="table-responsive maxton-table-wrap mt-2">
                    <table class="table align-middle w-100 maxton-table mb-0">
                        <thead>
                            <tr>
                                @foreach (var col in Model.Columns)
                                {
                                    <th class="@col.HeaderClass" style="width:@col.Width">@col.Header</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    @for (int i = 0; i < row.Cells.Count; i++)
                                    {
                                        var cellClass = (i < Model.Columns.Count) ? Model.Columns[i].CellClass : null;
                                        <td class="@cellClass" style="width:@Model.Columns[i].Width">@row.Cells[i]</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* ✅ Pagination (Working with icons) *@
                @if (Model.Pagination?.HasPages == true)
                {
                    var p = Model.Pagination;

                    <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
                        <div class="text-muted small ms-2">
                            Page @p.Page of @p.TotalPages
                            <span class="mx-1">•</span>
                            Total @p.TotalItems
                        </div>

                        <nav aria-label="Table pagination">
                            <ul class="pagination mb-0">

                                @* Prev *@
                                <li class="page-item @(p.HasPrev ? "" : "disabled")">
                                    <a class="page-link"
                                       aria-label="Previous"
                                       href="@(p.HasPrev ? $"?{p.PageParam}={p.PrevPage}&{p.PageSizeParam}={p.PageSize}{(string.IsNullOrWhiteSpace(p.SearchQuery) ? "" : $"&{p.SearchParam}={Uri.EscapeDataString(p.SearchQuery)}")}" : "javascript:;")">
                                        <span aria-hidden="true">«</span>
                                    </a>
                                </li>

                                @* Numbers + ellipsis *@
                                @foreach (var it in p.BuildItems())
                                {
                                    if (it.IsEllipsis)
                                    {
                                        <li class="page-item disabled">
                                            <a class="page-link" href="javascript:;">…</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item @(it.IsActive ? "active" : "")">
                                            <a class="page-link"
                                               href="?@p.PageParam=@it.Page&@p.PageSizeParam=@p.PageSize@(string.IsNullOrWhiteSpace(p.SearchQuery) ? "" : $"&{p.SearchParam}={Uri.EscapeDataString(p.SearchQuery)}")">
                                                @it.Text
                                            </a>
                                        </li>
                                    }
                                }

                                @* Next *@
                                <li class="page-item @(p.HasNext ? "" : "disabled")">
                                    <a class="page-link"
                                       aria-label="Next"
                                       href="@(p.HasNext ? $"?{p.PageParam}={p.NextPage}&{p.PageSizeParam}={p.PageSize}{(string.IsNullOrWhiteSpace(p.SearchQuery) ? "" : $"&{p.SearchParam}={Uri.EscapeDataString(p.SearchQuery)}")}" : "javascript:;")">
                                        <span aria-hidden="true">»</span>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
