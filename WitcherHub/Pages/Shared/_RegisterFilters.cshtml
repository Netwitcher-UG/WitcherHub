@model WitcherHub.Pages.Models.UI.RegisterFilterVm

@*
    The filter bar shared by the quote, contract and invoice registers.

    A plain GET form: the state lives in the query string, so a filtered view can
    be bookmarked, shared, and reloaded after an edit without losing the filter.
*@
<form method="get" class="row g-3 align-items-end mb-24">
    <div class="col-12 col-md-4">
        <label class="form-label text-sm fw-medium mb-8">Search</label>
        <div class="icon-field">
            <span class="icon top-50 translate-middle-y">
                <i class="ri-search-line"></i>
            </span>
            <input type="search" name="search" value="@Model.Search"
                   class="form-control radius-8" placeholder="@Model.SearchPlaceholder">
        </div>
    </div>

    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label text-sm fw-medium mb-8">Status</label>
        <select name="status" class="form-select radius-8">
            <option value="">Any status</option>
            @foreach (var option in Model.StatusOptions)
            {
                <option value="@((int)option.Value)" selected="@(Model.Status == option.Value)">@option.Label</option>
            }
        </select>
    </div>

    <div class="col-6 col-md-3 col-lg-3">
        <label class="form-label text-sm fw-medium mb-8">Customer</label>
        <select name="customerId" class="form-select radius-8">
            <option value="">All customers</option>
            @foreach (var customer in Model.Customers)
            {
                <option value="@customer.Id" selected="@(Model.CustomerId == customer.Id)">@customer.Name</option>
            }
        </select>
    </div>

    @if (Model.ShowMoneyFilters)
    {
        <div class="col-12 col-lg-auto">
            <div class="d-flex flex-wrap gap-3 pb-8">
                <div class="form-check d-flex align-items-center gap-2 mb-0">
                    <input class="form-check-input" type="checkbox" id="outstandingOnly"
                           name="outstandingOnly" value="true" checked="@Model.OutstandingOnly">
                    <label class="form-check-label text-sm" for="outstandingOnly">Unpaid only</label>
                </div>
                <div class="form-check d-flex align-items-center gap-2 mb-0">
                    <input class="form-check-input" type="checkbox" id="overdueOnly"
                           name="overdueOnly" value="true" checked="@Model.OverdueOnly">
                    <label class="form-check-label text-sm" for="overdueOnly">Overdue only</label>
                </div>
            </div>
        </div>
    }

    <div class="col-12 col-md-auto">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2">
                <i class="ri-filter-3-line"></i> Apply
            </button>

            @if (Model.AnyApplied)
            {
                <a href="?" class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2">
                    <i class="ri-close-line"></i> Clear
                </a>
            }
        </div>
    </div>
</form>
