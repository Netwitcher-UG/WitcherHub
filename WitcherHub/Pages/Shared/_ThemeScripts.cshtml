@*
    The theme's scripts. jQuery first: app.js and every page script assume it.

    Only the libraries the application actually uses are shipped. WowDash also
    bundles chart, calendar, rich-text, slider and vector-map plugins; none of them
    appear in any page here, so loading them would cost every visitor about two
    megabytes to run nothing.
*@

<script src="~/wowdash/js/lib/jquery-3.7.1.min.js"></script>
<script src="~/wowdash/js/lib/bootstrap.bundle.min.js"></script>
<script src="~/wowdash/js/app.js"></script>
