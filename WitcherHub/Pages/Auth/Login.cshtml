@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@model WitcherHub.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}



<div class="auth-basic-wrapper d-flex align-items-center justify-content-center">
    <div class="container-fluid my-5 my-lg-0">
        <div class="row">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5 col-xxl-4 mx-auto">
                <div class="card rounded-4 mb-0 border-top border-4 border-primary border-gradient-1">
                    <div class="card-body p-5">
                        <img src="~/theme/assets/images/logo1.png" class="mb-4" width="145" alt="">

                        <h4 class="fw-bold">Get Started Now</h4>
                        <p class="mb-0">Enter your credentials to login your account</p>

                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
                        }

                        <div class="form-body my-5">
                            <form method="post" class="row g-3">
                                <input type="hidden" asp-for="ReturnUrl" />
                                <div class="col-12">
                                    <label class="form-label" asp-for="Email"></label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="jhon@example.com">
                                </div>

                                <div class="col-12">
                                    <label class="form-label" asp-for="Password"></label>
                                    <div class="input-group" id="show_hide_password">
                                        <input asp-for="Password" type="password" class="form-control border-end-0" placeholder="Enter Password">
                                        <a href="javascript:;" class="input-group-text bg-transparent"><i class="bi bi-eye-slash-fill"></i></a>
                                    </div>
                                </div>

                                <div class="col-12 text-end">
                                    <a asp-page="/Auth/ForgotPassword">Forgot password?</a>
                                </div>

                                <div class="col-12">
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-grd-primary">Login</button>
                                    </div>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
          $("#show_hide_password a").on('click', function (event) {
            event.preventDefault();
            if ($('#show_hide_password input').attr("type") == "text") {
              $('#show_hide_password input').attr('type', 'password');
              $('#show_hide_password i').addClass("bi-eye-slash-fill");
              $('#show_hide_password i').removeClass("bi-eye-fill");
            } else if ($('#show_hide_password input').attr("type") == "password") {
              $('#show_hide_password input').attr('type', 'text');
              $('#show_hide_password i').removeClass("bi-eye-slash-fill");
              $('#show_hide_password i').addClass("bi-eye-fill");
            }
          });
        });
    </script>
}

