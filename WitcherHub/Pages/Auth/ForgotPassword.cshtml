@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@model WitcherHub.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-basic-wrapper d-flex align-items-center justify-content-center">
    <div class="container-fluid my-5 my-lg-0">
        <div class="row">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5 col-xxl-4 mx-auto">
                <div class="card rounded-4 mb-0 border-top border-4 border-primary border-gradient-1">
                    <div class="card-body p-5">
                        <img src="~/theme/assets/images/logo1.png" class="mb-4" width="145" alt="">

                        <h4 class="fw-bold">Forgot Password</h4>
                        <p class="mb-0">Enter your email and we will send you a reset link</p>

                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
                        }

                        @if (Model.Submitted)
                        {
                            <div class="alert alert-success mt-4">
                                If an account exists for that address, a reset link is on its way.
                                The link is valid for 2 hours.
                            </div>

                            <div class="text-center mt-4">
                                <a asp-page="/Auth/Login">Back to login</a>
                            </div>
                        }
                        else
                        {
                            <div class="form-body my-5">
                                <form method="post" class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label" asp-for="Email">Email</label>
                                        <input asp-for="Email" type="email" class="form-control" placeholder="jhon@example.com" autocomplete="email">
                                        <span class="text-danger" asp-validation-for="Email"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-grd-primary">Send reset link</button>
                                        </div>
                                    </div>

                                    <div class="col-12 text-center">
                                        <a asp-page="/Auth/Login">Back to login</a>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
