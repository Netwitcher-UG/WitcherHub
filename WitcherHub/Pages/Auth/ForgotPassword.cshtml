@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@model WitcherHub.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div>
    <a asp-page="/Auth/Login" class="d-inline-flex align-items-center gap-2 mb-40 text-decoration-none">
        <img src="~/img/netwitcher-logo.png" alt="" width="40" height="40">
        <span class="fw-bold text-primary-light" style="font-size: 1.35rem;">WitcherHub</span>
    </a>
    <h4 class="mb-12">Forgot your password?</h4>
    <p class="mb-32 text-secondary-light text-lg">
        Enter the email address on your account and we will send a reset link.
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger radius-8 mb-24" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Submitted)
{
    <div class="alert alert-success radius-8 mb-24" role="alert">
        If an account exists for that address, a reset link is on its way. The link is valid for 2 hours.
    </div>

    <div class="text-center text-sm">
        <a asp-page="/Auth/Login" class="text-primary-600 fw-semibold">Back to sign in</a>
    </div>
}
else
{
    <form method="post">
        <div class="icon-field mb-16">
            <span class="icon top-50 translate-middle-y">
                <i class="ri-mail-line"></i>
            </span>
            <input asp-for="Email" type="email" class="form-control h-56-px bg-neutral-50 radius-12"
                   placeholder="Email" autocomplete="email" required>
        </div>
        <span class="text-danger text-sm" asp-validation-for="Email"></span>

        <button type="submit" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12 mt-32">
            Send reset link
        </button>

        <div class="mt-32 text-center text-sm">
            <a asp-page="/Auth/Login" class="text-primary-600 fw-semibold">Back to sign in</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
