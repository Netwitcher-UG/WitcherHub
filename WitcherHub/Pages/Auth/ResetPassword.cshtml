@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@model WitcherHub.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Set a new password";
    Layout = "_AuthLayout";
}

<div>
    <a asp-page="/Auth/Login" class="d-inline-flex align-items-center gap-2 mb-40 text-decoration-none">
        <img src="~/img/netwitcher-logo.png" alt="" width="40" height="40">
        <span class="fw-bold text-primary-light" style="font-size: 1.35rem;">WitcherHub</span>
    </a>
    <h4 class="mb-12">Set a new password</h4>
</div>

@if (Model.Completed)
{
    <div class="alert alert-success radius-8 mb-24" role="alert">
        Your password has been changed. You can sign in with it now.
    </div>

    <a asp-page="/Auth/Login" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12">
        Go to sign in
    </a>
}
else
{
    <p class="mb-32 text-secondary-light text-lg">Choose a password you have not used here before.</p>

    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger radius-8 mb-24" role="alert">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.LinkIsBroken)
    {
        <a asp-page="/Auth/ForgotPassword" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12">
            Request a new link
        </a>
    }
    else
    {
        <form method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="position-relative mb-20">
                <div class="icon-field">
                    <span class="icon top-50 translate-middle-y">
                        <i class="ri-lock-password-line"></i>
                    </span>
                    <input asp-for="NewPassword" type="password" class="form-control h-56-px bg-neutral-50 radius-12"
                           id="newPassword" placeholder="New password" autocomplete="new-password" required>
                </div>
                <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light"
                      data-toggle="#newPassword" role="button" aria-label="Show password"></span>
                <span class="text-danger text-sm" asp-validation-for="NewPassword"></span>
            </div>

            <div class="position-relative mb-20">
                <div class="icon-field">
                    <span class="icon top-50 translate-middle-y">
                        <i class="ri-lock-password-line"></i>
                    </span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control h-56-px bg-neutral-50 radius-12"
                           id="confirmPassword" placeholder="Repeat new password" autocomplete="new-password" required>
                </div>
                <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light"
                      data-toggle="#confirmPassword" role="button" aria-label="Show password"></span>
                <span class="text-danger text-sm" asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12 mt-32">
                Change password
            </button>

            <div class="mt-32 text-center text-sm">
                <a asp-page="/Auth/Login" class="text-primary-600 fw-semibold">Back to sign in</a>
            </div>
        </form>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('.toggle-password').on('click', function () {
            $(this).toggleClass('ri-eye-off-line');
            var input = $($(this).attr('data-toggle'));
            input.attr('type', input.attr('type') === 'password' ? 'text' : 'password');
        });
    </script>
}
