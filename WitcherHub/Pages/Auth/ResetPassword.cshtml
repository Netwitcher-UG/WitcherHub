@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@model WitcherHub.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="auth-basic-wrapper d-flex align-items-center justify-content-center">
    <div class="container-fluid my-5 my-lg-0">
        <div class="row">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5 col-xxl-4 mx-auto">
                <div class="card rounded-4 mb-0 border-top border-4 border-primary border-gradient-1">
                    <div class="card-body p-5">
                        <img src="~/theme/assets/images/logo1.png" class="mb-4" width="145" alt="">

                        <h4 class="fw-bold">Set a New Password</h4>

                        @if (Model.Completed)
                        {
                            <div class="alert alert-success mt-4">
                                Your password has been changed. You can sign in with it now.
                            </div>

                            <div class="d-grid mt-4">
                                <a asp-page="/Auth/Login" class="btn btn-grd-primary">Go to login</a>
                            </div>
                        }
                        else
                        {
                            <p class="mb-0">Choose a password you have not used here before</p>

                            @if (Model.Errors.Count > 0)
                            {
                                <div class="alert alert-danger mt-3 mb-0">
                                    <ul class="mb-0 ps-3">
                                        @foreach (var error in Model.Errors)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (Model.LinkIsBroken)
                            {
                                <div class="d-grid mt-4">
                                    <a asp-page="/Auth/ForgotPassword" class="btn btn-grd-primary">Request a new link</a>
                                </div>
                            }
                            else
                            {
                                <div class="form-body my-5">
                                    <form method="post" class="row g-3">
                                        <input type="hidden" asp-for="Email" />
                                        <input type="hidden" asp-for="Token" />

                                        <div class="col-12">
                                            <label class="form-label" asp-for="NewPassword">New password</label>
                                            <div class="input-group" id="show_hide_password">
                                                <input asp-for="NewPassword" type="password" class="form-control border-end-0"
                                                       placeholder="Enter new password" autocomplete="new-password">
                                                <a href="javascript:;" class="input-group-text bg-transparent"><i class="bi bi-eye-slash-fill"></i></a>
                                            </div>
                                            <span class="text-danger" asp-validation-for="NewPassword"></span>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label" asp-for="ConfirmPassword">Confirm password</label>
                                            <input asp-for="ConfirmPassword" type="password" class="form-control"
                                                   placeholder="Repeat new password" autocomplete="new-password">
                                            <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                                        </div>

                                        <div class="col-12">
                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-grd-primary">Change password</button>
                                            </div>
                                        </div>

                                        <div class="col-12 text-center">
                                            <a asp-page="/Auth/Login">Back to login</a>
                                        </div>
                                    </form>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $("#show_hide_password a").on('click', function (event) {
                event.preventDefault();
                var input = $('#show_hide_password input');
                var icon = $('#show_hide_password i');
                if (input.attr("type") === "text") {
                    input.attr('type', 'password');
                    icon.addClass("bi-eye-slash-fill").removeClass("bi-eye-fill");
                } else {
                    input.attr('type', 'text');
                    icon.removeClass("bi-eye-slash-fill").addClass("bi-eye-fill");
                }
            });
        });
    </script>
}
