@page "{id}"
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using WitcherHub.Domain.SeedData
@attribute [Authorize(Policy = AppPolicyPrefixes.Permission + AppPermissions.ManageNetwitcher)]
@model WitcherHub.Pages.Clients.DetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Client Details";
    ViewData["LexwareImportUrl"] = Url.Page("/Index", "LexwareImportContacts");
}

<div class="mb-3">
    <div class="mb-1">
        <a class="text-decoration-none text-muted small"
           asp-page="/Index"
           title="Back to Clients">
            Clients
        </a>
    </div>

    <h3 class="mb-0">Client Details</h3>
</div>

<input type="hidden" id="vcPageClientId" value="@Model.Id" />

<input type="hidden" id="vcLexwareImportUrl" value="@Url.Page("/Index", "LexwareImportContacts")" />
<input type="hidden" id="vcClientUrl" value="@Url.Page("./Details", "Client")" />
<input type="hidden" id="vcUpdateBasicUrl" value="@Url.Page("/Index", "UpdateBasic")" />
<input type="hidden" id="antiForgeryToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<input type="hidden" id="vcAddAddressUrl" value="@Url.Page("/Index", "AddAddress")" />
<input type="hidden" id="vcDeleteAddressUrl" value="@Url.Page("/Index", "DeleteAddress")" />
<input type="hidden" id="vcSetDefaultAddressUrl" value="@Url.Page("/Index", "SetDefaultAddress")" />
<input type="hidden" id="vcUpdateAddressUrl" value="@Url.Page("/Index", "UpdateAddress")" />

<input type="hidden" id="vcAddContactUrl" value="@Url.Page("/Index", "AddContact")" />
<input type="hidden" id="vcDeleteContactUrl" value="@Url.Page("/Index", "DeleteContact")" />
<input type="hidden" id="vcSetPrimaryContactUrl" value="@Url.Page("/Index", "SetPrimaryContact")" />
<input type="hidden" id="vcUpdateContactUrl" value="@Url.Page("/Index", "UpdateContact")" />

<input type="hidden" id="vcLexwareExportUrl" value="@Url.Page("/Index", "LexwareExport")" />
<input type="hidden" id="vcLexwareDeleteUrl" value="@Url.Page("/Index", "LexwareDelete")" />

<script type="application/json" id="countryOptionsJson">
    @Html.Raw(JsonSerializer.Serialize(Model.CountryOptions.Select(x => new { code = x.Value, name = x.Text })))
</script>

<div class="row">
    <div class="col-12">

        <!-- Top Summary -->
        <div class="card rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                    <div>
                        <h3 class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                            <span id="vc-name">—</span>
                            <span id="vc-lexwareBadge"></span>
                        </h3>

                        <div class="d-flex align-items-center gap-2">
                            <span id="vc-typeBadge"></span>
                            <span class="text-muted" id="vc-idText">—</span>
                        </div>
                        <div class="small text-muted mt-1" id="vc-subtitle">—</div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <button type="button"
                                id="vc-exportBtn"
                                class="btn p-0 border-0 bg-transparent text-warning d-none"
                                data-vc-action="export-lexware"
                                title="Export to Lexware">
                            <i class="ri-upload-2-line"></i>
                        </button>

                        <button type="button"
                                class="btn p-0 border-0 bg-transparent text-danger"
                                title="Delete Client"
                                data-bs-toggle="collapse"
                                data-bs-target="#vc-deleteClientCollapse">
                            <i class="ri-delete-bin-line"></i>
                        </button>
                    </div>
                </div>

                <div class="collapse mt-4" id="vc-deleteClientCollapse">
                    <div class="card rounded-4 border border-danger bg-transparent">
                        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="ri-error-warning-line text-danger"></i>
                                <div>
                                    <div class="fw-semibold">Delete this client?</div>
                                    <small class="text-muted">This action cannot be undone.</small>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-light btn-sm"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#vc-deleteClientCollapse">
                                    Cancel
                                </button>

                                <form method="post" asp-page="/Index" asp-page-handler="DeleteClient" class="m-0">
                                    <input type="hidden" name="ClientId" id="vc-clientId-deleteClient" value="" />
                                    <button type="submit" class="btn btn-danger btn-sm" data-vc-confirm="delete-client">
                                        Confirm
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- هنا الصق نفس المحتوى الداخلي الذي كان داخل modal-body -->
        <div class="row g-4">

            <!-- 1) Basic Info -->
            <div class="col-12 col-xl-6">
                <div class="card rounded-4 h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="ri-user-line opacity-75"></i>
                                <h5 class="mb-0 fw-bold">Basic Information</h5>
                            </div>

                            <div class="d-flex gap-3">
                                <button type="button"
                                        class="btn p-0 border-0 bg-transparent text-info"
                                        title="Edit"
                                        data-vc-action="edit-basic">
                                    <i class="ri-edit-line"></i>
                                </button>
                            </div>
                        </div>

                        <!-- VIEW -->
                        <div id="vc-basicView" class="row g-3">
                            <div class="col-12">
                                <div class="small text-muted">Emails</div>
                                <div class="mt-2 d-flex flex-wrap gap-2" id="vc-emailList">
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-muted">Phone</div>
                                <div id="vc-phone">—</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-muted">Tax ID</div>
                                <div id="vc-taxId">—</div>
                            </div>

                            <div class="col-12">
                                <div class="small text-muted">Notes</div>
                                <div id="vc-notes" class="text-muted">—</div>
                            </div>
                        </div>

                        <!-- EDIT -->
                        <div id="vc-basicEdit" class="row g-2 d-none mt-2">

                            <div class="col-12 col-md-12">
                                <label class="form-label">Type</label>
                                <select class="form-select form-select-sm" id="vc-basic-type">
                                    <option value="Individual">Individual</option>
                                    <option value="Company">Company</option>
                                </select>
                                <div class="text-danger small mt-1" id="err-vc-basic-type"></div>
                            </div>

                            <div class="col-12 col-md-6 vc-individual-only">
                                <label class="form-label">First Name</label>
                                <input class="form-control form-control-sm" id="vc-basic-firstName" />
                                <div class="text-danger small mt-1" id="err-vc-basic-firstName"></div>
                            </div>

                            <div class="col-12 col-md-6 vc-individual-only">
                                <label class="form-label">Last Name</label>
                                <input class="form-control form-control-sm" id="vc-basic-lastName" />
                                <div class="text-danger small mt-1" id="err-vc-basic-lastName"></div>
                            </div>

                            <div class="col-12 col-md-6 vc-company-only">
                                <label class="form-label">Company Name</label>
                                <input class="form-control form-control-sm" id="vc-basic-name" />
                                <div class="text-danger small mt-1" id="err-vc-basic-name"></div>
                            </div>

                            <div class="col-12">
                                <div class="card rounded-4 border bg-transparent">
                                    <div class="card-body p-3">

                                        <div class="d-flex align-items-center justify-content-between gap-2">
                                            <div>
                                                <div class="fw-semibold">Emails <span class="text-danger">*</span></div>
                                                <div class="small text-muted">You must keep at least one email.</div>
                                            </div>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    id="vc-basic-email-add"
                                                    title="Add email">
                                                <i class="ri-add-line align-middle" style="font-size:18px"></i>
                                                <span class="ms-1">Add</span>
                                            </button>
                                        </div>

                                        <div class="row mt-3 small text-muted d-none d-md-flex">
                                            <div class="col-md-4">Kind</div>
                                            <div class="col-md-8">Email</div>
                                        </div>

                                        <div class="mt-2 d-flex flex-column gap-2" id="vc-basic-email-list">
                                        </div>

                                        <div class="text-danger small mt-2 d-none" id="err-vc-basic-email-global"></div>

                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Phone</label>
                                <input class="form-control form-control-sm" id="vc-basic-phone" />
                                <div class="text-danger small mt-1" id="err-vc-basic-phone"></div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Tax ID</label>
                                <input class="form-control form-control-sm" id="vc-basic-taxId" />
                                <div class="text-danger small mt-1" id="err-vc-basic-taxId"></div>
                            </div>

                            <div class="col-12 col-md-6 d-none d-md-block"></div>

                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <input class="form-control form-control-sm" id="vc-basic-notes" />
                                <div class="text-danger small mt-1" id="err-vc-basic-notes"></div>
                            </div>

                            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                                <button type="button" class="btn btn-outline-secondary px-4" data-vc-action="cancel-basic">Cancel</button>
                                <button type="button" class="btn btn-primary px-4" data-vc-action="save-basic">Save</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- 1.5) Lexware -->
            <div class="col-12 col-xl-6">
                <div class="card rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="ri-refresh-line opacity-75"></i>
                            <h5 class="mb-0 fw-bold">Lexware</h5>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="small text-muted">Customer Number</div>
                                <div id="vc-lx-customerNumber">—</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-muted">Version</div>
                                <div id="vc-lx-version">—</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-muted">ContactId</div>
                                <div id="vc-lx-contactId" class="text-muted">—</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-muted">OrganizationId</div>
                                <div id="vc-lx-organizationId" class="text-muted">—</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-muted">Archived</div>
                                <div id="vc-lx-archived">—</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="small text-muted">Allow Tax Free Invoices</div>
                                <div id="vc-lx-taxFree">—</div>
                            </div>

                            <div class="col-12">
                                <div class="small text-muted">Synced At (UTC)</div>
                                <div id="vc-lx-syncedAt" class="text-muted">—</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2) Locations -->
            <div class="col-12">
                <div class="card rounded-4 h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="ri-map-pin-line opacity-75"></i>
                                <h5 class="mb-0 fw-bold">Locations</h5>
                                <span class="badge bg-neutral-200 text-neutral-600 border border-neutral-400 px-12 py-2 radius-4" id="vc-addressCount">0</span>
                            </div>

                            <button type="button"
                                    class="btn p-0 border-0 bg-transparent text-primary"
                                    title="Add Location"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#vc-addLocationCollapse">
                                <i class="ri-add-line"></i>
                            </button>
                        </div>

                        <div id="vc-addressList" class="d-flex flex-column gap-2">
                            <div class="text-muted">No locations.</div>
                        </div>

                        <div class="collapse mt-3" id="vc-addLocationCollapse">
                            <div class="card rounded-4 border-top border-4 border-primary border-gradient-1 mb-0">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="fw-bold">Add Location</div>
                                    </div>

                                    <form class="row g-3" id="vcAddLocationForm">
                                        <input type="hidden" id="vc-clientId-addLocation" value="" />

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Label</label>
                                            <input class="form-control" id="vc-add-loc-label" placeholder="Billing / Shipping / Home" />
                                            <div class="text-danger small mt-1" id="err-vc-add-loc-label"></div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Country</label>

                                            <div class="dropdown">
                                                <input type="text"
                                                       class="form-control form-control-sm dropdown-toggle"
                                                       id="vc-add-loc-country-combo"
                                                       data-country-combo="true"
                                                       data-country-menu="vc-add-loc-country-menu"
                                                       data-country-select="vc-add-loc-country-select"
                                                       data-bs-toggle="dropdown"
                                                       aria-expanded="false"
                                                       autocomplete="off"
                                                       placeholder="Search & select country..." />

                                                <ul class="dropdown-menu w-100"
                                                    id="vc-add-loc-country-menu"
                                                    aria-labelledby="vc-add-loc-country-combo"
                                                    style="max-height:280px; overflow-y:auto;">
                                                </ul>
                                            </div>

                                            <select id="vc-add-loc-country-select"
                                                    class="form-select"
                                                    tabindex="-1"
                                                    aria-hidden="true"
                                                    style="position:absolute !important; left:-10000px !important; top:auto !important; width:1px !important; height:1px !important; overflow:hidden !important; opacity:0 !important; pointer-events:none !important;">
                                            </select>

                                            <div class="text-danger small mt-1" id="err-vc-add-loc-country-select"></div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">City</label>
                                            <input class="form-control" id="vc-add-loc-city" />
                                            <div class="text-danger small mt-1" id="err-vc-add-loc-city"></div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Postal Code</label>
                                            <input class="form-control" id="vc-add-loc-postal" />
                                            <div class="text-danger small mt-1" id="err-vc-add-loc-postal"></div>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Street (raw)</label>
                                            <input class="form-control" id="vc-add-loc-streetRaw" />
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Address Line 2</label>
                                            <input class="form-control" id="vc-add-loc-line2" />
                                            <div class="text-danger small mt-1" id="err-vc-add-loc-line2"></div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Full Name / Company</label>
                                            <input class="form-control" id="vc-add-loc-fullname" readonly />
                                            <div class="text-danger small mt-1" id="err-vc-add-loc-fullname"></div>
                                        </div>

                                        <div class="col-12 d-flex align-items-center justify-content-between mt-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="vc-add-loc-default">
                                                <label class="form-check-label" for="vc-add-loc-default">
                                                    Set as default
                                                </label>
                                            </div>

                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-outline-secondary px-4"
                                                        data-bs-toggle="collapse" data-bs-target="#vc-addLocationCollapse">
                                                    Cancel
                                                </button>
                                                <button type="submit" class="btn btn-primary btn-sm" style="padding-left:25px;padding-right:25px;">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- 3) Company Contacts -->
            <div class="col-12 d-none" id="vc-companyContactSection">
                <div class="card rounded-4">
                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="ri-contacts-line opacity-75"></i>
                                <h5 class="mb-0 fw-bold">Company Contacts</h5>
                                <span class="badge bg-neutral-200 text-neutral-600 border border-neutral-400 px-12 py-2 radius-4" id="vc-contactCount">0</span>
                            </div>

                            <button type="button"
                                    class="btn p-0 border-0 bg-transparent text-primary"
                                    title="Add Contact"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#vc-addContactCollapse">
                                <i class="ri-add-line"></i>
                            </button>
                        </div>

                        <div id="vc-contactList" class="d-flex flex-column gap-2">
                            <div class="text-muted">No contacts.</div>
                        </div>

                        <div class="collapse mt-3" id="vc-addContactCollapse">
                            <div class="card rounded-4 border-top border-4 border-primary border-gradient-1 mb-0">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="fw-bold">Add Contact</div>
                                        <button type="button" class="btn btn-sm btn-light"
                                                data-bs-toggle="collapse" data-bs-target="#vc-addContactCollapse">
                                            Close
                                        </button>
                                    </div>

                                    <form class="row g-3" id="vcAddContactForm">
                                        <input type="hidden" id="vc-clientId-addContact" value="" />

                                        <div class="col-12 col-md-4">
                                            <label class="form-label">Salutation</label>
                                            <input class="form-control" id="vc-add-c-salutation" placeholder="Herr / Frau" />
                                            <div class="text-danger small mt-1" id="err-vc-add-c-salutation"></div>
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <label class="form-label">First Name</label>
                                            <input class="form-control" id="vc-add-c-firstName" />
                                            <div class="text-danger small mt-1" id="err-vc-add-c-firstName"></div>
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <label class="form-label">Last Name</label>
                                            <input class="form-control" id="vc-add-c-lastName" />
                                            <div class="text-danger small mt-1" id="err-vc-add-c-lastName"></div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Position</label>
                                            <input class="form-control" id="vc-add-c-position" />
                                            <div class="text-danger small mt-1" id="err-vc-add-c-position"></div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Email</label>
                                            <input class="form-control" id="vc-add-c-email" type="email" />
                                            <div class="text-danger small mt-1" id="err-vc-add-c-email"></div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Phone</label>
                                            <input class="form-control" id="vc-add-c-phone" />
                                            <div class="text-danger small mt-1" id="err-vc-add-c-phone"></div>
                                        </div>

                                        <div class="col-12 d-flex align-items-center justify-content-between mt-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="vc-add-c-primary">
                                                <label class="form-check-label" for="vc-add-c-primary">
                                                    Set as primary
                                                </label>
                                            </div>

                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-light btn-sm"
                                                        data-bs-toggle="collapse" data-bs-target="#vc-addContactCollapse">
                                                    Cancel
                                                </button>
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- 4) Projects -->
            <div class="col-12">
                <div class="card rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="ri-folder-line opacity-75"></i>
                                <h5 class="mb-0 fw-bold">Projects</h5>
                            </div>
                            <span class="badge bg-neutral-200 text-neutral-600 border border-neutral-400 px-12 py-2 radius-4" id="vc-projectCount">0</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle mb-0 vc-projects-table">
                                <colgroup>
                                    <col style="width:38%">
                                    <col style="width:16%">
                                    <col style="width:28%">
                                    <col style="width:18%">
                                </colgroup>

                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Status</th>
                                        <th>Dates</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>

                                <tbody id="vc-projects">
                                    <tr><td colspan="4" class="text-muted">No projects.</td></tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    
    </div>
</div>

<div class="modal fade quote-confirm-modal" id="DeleteClientConfirmModal" tabindex="-1" aria-labelledby="DeleteClientConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteClientConfirmModalLabel">Delete client</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="DeleteClientConfirmModalMessage">Are you sure you want to delete this client?</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="DeleteClientConfirmModalSubmit">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/clients/clients.js" asp-append-version="true"></script>
}