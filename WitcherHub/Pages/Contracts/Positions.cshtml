@page "{contractId:guid}"
@using System.Text.Json
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Contracts.PositionsModel
@{
    ViewData["Title"] = "Contract positions";
    // Enums must travel as names. Serialised as numbers, the builder's option
    // matching silently falls back to the first entry, so a Monthly position
    // renders as OneTime and a manual one is labelled Catalog.
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };
}

<div class="container-fluid px-0" id="positionsApp"
     data-contract-id="@Model.ContractId"
     data-currency="@(Model.Contract?.Currency ?? "EUR")">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h5 class="mb-1 fw-bold">Contract positions</h5>
            <p class="mb-0 text-secondary small">
                Add positions from the service catalog, or enter them by hand.
                A contract is valid with manual positions only.
            </p>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Contracts/Details" asp-route-id="@Model.ContractId">
            Back to contract
        </a>
    </div>

    <div class="row g-3">
        <!-- ============ positions ============ -->
        <div class="col-12 col-xl-8">
            <div class="card rounded-4">
                <div class="card-body">

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-grd-primary btn-sm" data-action="add-manual">
                            <i class="bi bi-plus-lg me-1"></i>Add manual position
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-action="add-catalog">
                            <i class="bi bi-box-seam me-1"></i>Add from catalog
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" data-action="organize">
                            <i class="bi bi-stars me-1"></i>Organize with AI
                        </button>
                    </div>

                    <!-- empty state -->
                    <div id="emptyState" class="text-center py-5 d-none">
                        <div class="mb-2"><i class="bi bi-list-ul fs-1 text-secondary"></i></div>
                        <p class="fw-semibold mb-1">No positions yet</p>
                        <p class="text-secondary small mb-3">
                            Add a manual position to describe work that is not in the catalog.
                        </p>
                        <button type="button" class="btn btn-grd-primary btn-sm" data-action="add-manual">
                            Add manual position
                        </button>
                    </div>

                    <div id="positionList" class="vstack gap-3"></div>
                </div>
            </div>

            <!-- ============ contract draft ============ -->
            <div class="card rounded-4 mt-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <h6 class="mb-0 fw-bold">Contract draft</h6>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="generate-draft">
                                Generate draft
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="approve-draft" disabled>
                                Approve
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-info small" role="note">
                        The assistant writes a draft from the positions above. It never sets or changes
                        prices. A person must review and approve the wording before it is sent.
                    </div>

                    <div id="draftArea">
                        @if (Model.Drafts.Count == 0)
                        {
                            <p class="text-secondary small mb-0">No draft generated yet.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush" id="draftList">
                                @foreach (var d in Model.Drafts)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0"
                                        data-version="@d.Version">
                                        <span>
                                            <strong>Version @d.Version</strong>
                                            <span class="text-secondary small ms-2">
                                                @d.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                @if (!string.IsNullOrWhiteSpace(d.Model))
                                                {
                                                    <text> · @d.Model</text>
                                                }
                                            </span>
                                        </span>
                                        @if (d.IsApproved)
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success"
                                                    data-action="approve-version" data-version="@d.Version">
                                                Approve
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ live summary ============ -->
        <div class="col-12 col-xl-4">
            <div class="card rounded-4 position-sticky" style="top:1rem;">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Summary</h6>

                    <dl class="row mb-0 small">
                        <dt class="col-7 fw-normal text-secondary">Positions</dt>
                        <dd class="col-5 text-end mb-2" data-total="count">@Model.Totals.PositionCount</dd>

                        <dt class="col-7 fw-normal text-secondary">Subtotal</dt>
                        <dd class="col-5 text-end mb-2" data-total="subtotal">—</dd>

                        <dt class="col-7 fw-normal text-secondary">Discount</dt>
                        <dd class="col-5 text-end mb-2" data-total="discount">—</dd>

                        <dt class="col-7 fw-normal text-secondary">VAT</dt>
                        <dd class="col-5 text-end mb-2" data-total="vat">—</dd>
                    </dl>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total</span>
                        <span class="fs-5 fw-bold" data-total="total">—</span>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <button type="button" class="btn btn-grd-primary" data-action="save">
                            Save positions
                        </button>
                    </div>

                    <p class="text-secondary mt-3 mb-0" style="font-size:.75rem;">
                        Totals are recalculated on the server when you save.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============ AI review modal ============ -->
<div class="modal fade" id="organizeModal" tabindex="-1" aria-labelledby="organizeTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title" id="organizeTitle">Organize positions with AI</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="organizeInputStep">
                    <label class="form-label" for="roughInput">Describe the work</label>
                    <textarea id="roughInput" class="form-control" rows="6"
                              placeholder="e.g. new website with 5 pages, monthly hosting, SEO setup"></textarea>
                    <p class="text-secondary small mt-2 mb-0">
                        Prices, quantities, VAT, discounts, dates and billing cycles stay exactly as you
                        entered them. The assistant only organizes and improves the wording.
                    </p>
                </div>

                <div id="organizeReviewStep" class="d-none">
                    <div id="rejectedBox" class="alert alert-warning d-none">
                        <strong>Commercial values were kept as you entered them.</strong>
                        <p class="small mb-2">The assistant proposed different figures. They were not applied:</p>
                        <ul class="small mb-0" id="rejectedList"></ul>
                    </div>

                    <div id="changesBox">
                        <p class="fw-semibold mb-2">Proposed changes</p>
                        <ul class="small" id="changesList"></ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-grd-primary" data-action="run-organize">Organize</button>
                <button type="button" class="btn btn-success d-none" data-action="apply-organize">Apply positions</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script id="initialPositions" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.Positions, jsonOptions))
    </script>
    <script id="catalogServices" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.CatalogServices, jsonOptions))
    </script>
    <script src="~/js/pages/contracts/positions-builder.js" asp-append-version="true"></script>
}
