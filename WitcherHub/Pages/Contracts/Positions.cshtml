@page "{contractId:guid}"
@using System.Text.Json
@using WitcherHub.Pages.Models.UI
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Contracts.PositionsModel
@{
    ViewData["Title"] = "Contract builder";

    // Enums must travel as names. Serialised as numbers, the builder's option
    // matching silently falls back to the first entry, so a Monthly position
    // renders as OneTime and a manual one is labelled Catalog.
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    var contract = Model.Contract!;
    var step = Model.CurrentStep;
}

@* ======================================================================
   Compact identity header. Contract number, who it is with, and its state —
   the four things needed to know which contract this is, on one line.
   ====================================================================== *@
<div class="wh-section d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <nav class="mb-8">
            <a asp-page="/Contracts/Index" class="text-secondary-light text-sm hover-text-primary d-inline-flex align-items-center gap-1">
                <i class="ri-arrow-left-line"></i> All contracts
            </a>
        </nav>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <h3 class="mb-0 fw-semibold">@contract.ContractNo</h3>
            <partial name="_StatusBadge" model="DocumentStatusPresentation.ForContract(contract.Status)" />
            <span class="text-secondary-light text-sm">@contract.Currency</span>
        </div>

        <p class="text-secondary-light mb-0 mt-8 text-sm">
            <a asp-page="/Clients/Details" asp-route-id="@contract.CustomerId" class="text-primary-600 fw-medium">@contract.CustomerName</a>
            ·
            <a asp-page="/Projects/Workspace" asp-route-id="@contract.ProjectId" asp-route-tab="contracts" class="hover-text-primary">@contract.ProjectTitle</a>
        </p>
    </div>

    <div class="wh-actions">
        <a asp-page="/Contracts/Details" asp-route-id="@Model.ContractId"
           class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2">
            <i class="ri-file-text-line"></i> View contract
        </a>
    </div>
</div>

@if (Model.IsLocked)
{
    <div class="wh-section alert alert-warning radius-8 d-flex align-items-start gap-2 mb-0" role="alert">
        <i class="ri-lock-line mt-1"></i>
        <span>
            This contract is <strong>@contract.Status.ToString().ToLowerInvariant()</strong>. Positions and terms are
            frozen so the document that was signed stays the document that was signed. Generate a new
            contract to change what was agreed.
        </span>
    </div>
}

@* ======================================================================
   Progress. Which parts are done, and what is left.
   ====================================================================== *@
<div class="wh-section">
    <ol class="wh-stepper" aria-label="Contract progress">
        <li class="wh-stepper__step @(step > 1 ? "is-done" : "is-current")">
            <span class="wh-stepper__mark">1</span>
            <span class="wh-stepper__label">Contract details</span>
        </li>
        <li class="wh-stepper__step @(step > 2 ? "is-done" : step == 2 ? "is-current" : "")">
            <span class="wh-stepper__mark">2</span>
            <span class="wh-stepper__label">What the contract covers</span>
        </li>
        <li class="wh-stepper__step @(step > 3 ? "is-done" : step == 3 ? "is-current" : "")">
            <span class="wh-stepper__mark">3</span>
            <span class="wh-stepper__label">Contract text</span>
        </li>
        <li class="wh-stepper__step @(step == 4 ? "is-current" : "")">
            <span class="wh-stepper__mark">4</span>
            <span class="wh-stepper__label">Review and approve</span>
        </li>
    </ol>

    @* Says once what the mark on the buttons means, rather than repeating it in
       every tooltip. Placed with the stepper because it describes the whole
       page, not any one action. *@
    <p class="wh-ai-legend mt-12 mb-0">
        <i class="ri-sparkling-2-line wh-ai-mark__icon" aria-hidden="true"></i>
        Buttons marked with this use the AI model. They propose — nothing they return
        is applied to the contract until you confirm it.
    </p>
</div>

<div class="row g-4" id="positionsApp"
     data-contract-id="@Model.ContractId"
     data-currency="@(contract.Currency ?? "EUR")"
     data-locked="@Model.IsLocked.ToString().ToLowerInvariant()"
     data-has-text="@Model.HasContractText.ToString().ToLowerInvariant()"
     data-supplied-version="@(Model.SuppliedSource?.Version ?? 0)"
     data-supplied-draft-id="@(Model.SuppliedSource?.Id.ToString() ?? "")"
     data-empty-message="@Model.Source.EmptyPositionsMessage">

    <div class="col-12 col-xl-8">

        @* ============ step 1: contract details ============ *@
        <section class="card radius-12 border wh-section mt-0">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-16">
                    <div>
                        <h6 class="fw-semibold mb-4">Contract details</h6>
                        <p class="text-secondary-light text-sm mb-0">
                            The parties come from the customer record. Dates and billing apply to the whole contract.
                        </p>
                    </div>
                </div>

                @* The two parties, stated plainly. A contract that does not name
                   who it is between is not a contract. *@
                <div class="row g-3 mb-24">
                    <div class="col-12 col-md-6">
                        <div class="wh-party">
                            <span class="wh-party__role">Provider</span>
                            <span class="wh-party__name">Netwitcher UG</span>
                            <span class="wh-party__detail">Company details are taken from the contract template.</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="wh-party">
                            <span class="wh-party__role">Customer</span>
                            <span class="wh-party__name">@contract.CustomerName</span>
                            <a asp-page="/Clients/Details" asp-route-id="@contract.CustomerId"
                               class="wh-party__detail text-primary-600">Check address and representative</a>
                        </div>
                    </div>
                </div>

                <form method="post" asp-page-handler="Basics">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contractId" value="@Model.ContractId" />

                    <div class="wh-form-grid">
                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsStatus">Status</label>
                            <select asp-for="BasicsStatus" class="form-select radius-8" disabled="@Model.IsLocked">
                                <option value="@((int)DocumentStatus.Draft)">Draft</option>
                                <option value="@((int)DocumentStatus.Sent)">Sent</option>
                                <option value="@((int)DocumentStatus.Signed)">Signed</option>
                                <option value="@((int)DocumentStatus.Terminated)">Terminated</option>
                                <option value="@((int)DocumentStatus.Cancelled)">Cancelled</option>
                            </select>
                        </div>

                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsStartDate">Start date</label>
                            <input asp-for="BasicsStartDate" type="date" class="form-control radius-8 js-datepicker"
                                   disabled="@Model.IsLocked">
                        </div>

                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsEndDate">End date</label>
                            <input asp-for="BasicsEndDate" type="date" class="form-control radius-8 js-datepicker"
                                   disabled="@Model.IsLocked">
                            <span class="wh-hint">Leave empty for an open-ended contract.</span>
                        </div>

                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsInvoiceSendMode">Invoicing</label>
                            <select asp-for="BasicsInvoiceSendMode" class="form-select radius-8" disabled="@Model.IsLocked">
                                <option value="@((int)InvoiceSendMode.Automatic)">Send invoices automatically</option>
                                <option value="@((int)InvoiceSendMode.Manual)">Create invoices, send them myself</option>
                            </select>
                            <span class="wh-hint">What happens when an invoice falls due.</span>
                        </div>

                        <div class="wh-col-full">
                            <label class="form-label" asp-for="BasicsIntroduction">Contract introduction</label>
                            <textarea asp-for="BasicsIntroduction" class="form-control radius-8 wh-textarea-sm"
                                      placeholder="Optional. Wording that appears before the positions — the purpose of the agreement, or a specific arrangement made with this customer."
                                      disabled="@Model.IsLocked"></textarea>
                            <span class="wh-hint">Optional. Appears at the top of the generated contract, above the positions.</span>
                        </div>
                    </div>

                    @if (!Model.IsLocked)
                    {
                        <div class="wh-actions wh-actions--end mt-16">
                            <button type="submit" class="btn btn-outline-primary text-sm px-20 py-11 radius-8">
                                Save contract details
                            </button>
                        </div>
                    }
                </form>
            </div>
        </section>

        @* ============ step 2: what the contract covers ============ *@
        <section class="card radius-12 border wh-section">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-16">
                    <div>
                        <h6 class="fw-semibold mb-4">What the contract covers</h6>
                        <p class="text-secondary-light text-sm mb-0">
                            Positions can come from your saved services, be typed in by hand, or both.
                            A saved service is not required.
                        </p>
                    </div>
                    <span class="text-secondary-light text-sm" data-total="count-label">
                        @Model.Totals.PositionCount @(Model.Totals.PositionCount == 1 ? "position" : "positions")
                    </span>
                </div>

                @if (!Model.IsLocked)
                {
                    <div class="wh-actions mb-16">
                        <button type="button" class="btn btn-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2"
                                data-action="add-manual">
                            <i class="ri-add-line"></i> Add manual position
                        </button>
                        <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2"
                                data-action="add-catalog">
                            <i class="ri-box-3-line"></i> Add from saved services
                        </button>
                        <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2 ms-auto wh-ai-action"
                                data-action="organize" data-ai="true"
                                title="Sends your positions to the AI model and proposes a tidied version for you to review.">
                            <partial name="_AiMark" /> Organise with AI
                        </button>
                    </div>
                }

                @* The empty state offers all three routes, because an empty
                   contract does not have one obvious next move — and once there
                   is supplied text, an empty list is a finished state rather
                   than a missing step, so it says so instead of asking for a
                   position that is not required. *@
                <div id="emptyState" class="d-none">
                    @if (Model.HasContractText)
                    {
                        <div class="wh-empty text-center">
                            <div class="wh-empty__icon"><i class="ri-file-text-line"></i></div>
                            <h6 class="fw-semibold mb-8">Generated from the supplied contract text</h6>
                            <p class="text-secondary-light text-sm mb-16">@Model.Source.EmptyPositionsMessage</p>
                            <div class="wh-actions justify-content-center">
                                <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8" data-action="add-manual">
                                    <i class="ri-add-line"></i> Add manual position
                                </button>
                                <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8" data-action="add-catalog">
                                    <i class="ri-box-3-line"></i> Add from saved services
                                </button>
                                @if (Model.SuppliedSource is not null)
                                {
                                    <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8 wh-ai-action"
                                            data-action="extract-positions" data-version="@Model.SuppliedSource.Version"
                                            data-ai="true"
                                            title="Reads the contract text with the AI model and proposes positions for you to review.">
                                        <partial name="_AiMark" /> Extract positions from the text
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <partial name="_EmptyState" model="@(new EmptyStateVm
                               {
                                   Title = "No contract positions yet",
                                   Message = Model.Source.EmptyPositionsMessage,
                                   Icon = "ri-list-check-2",
                                   Actions =
                                   [
                                       new EmptyStateAction { Text = "Add manual position", Url = "add-manual", Icon = "ri-add-line", IsPrimary = true, IsButton = true },
                                       new EmptyStateAction { Text = "Add from saved services", Url = "add-catalog", Icon = "ri-box-3-line", IsButton = true },
                                       new EmptyStateAction { Text = "Paste contract text", Url = "focus-paste", Icon = "ri-clipboard-line", IsButton = true }
                                   ]
                               })" />
                    }
                </div>

                <div id="positionList" class="d-flex flex-column gap-3"></div>
            </div>
        </section>

        @* ============ step 3: contract text ============ *@
        <section class="card radius-12 border wh-section" id="contractTextSection">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-16">
                    <div>
                        <h6 class="fw-semibold mb-4">Contract text</h6>
                        <p class="text-secondary-light text-sm mb-0">
                            Generate the wording from the positions above, or supply text you already have.
                        </p>
                    </div>
                    <div class="wh-actions">
                        <button type="button" class="btn btn-outline-primary text-sm px-16 py-8 radius-8 d-inline-flex align-items-center gap-2"
                                data-action="toggle-paste">
                            <i class="ri-clipboard-line"></i> Paste existing text
                        </button>
                    </div>
                </div>

                @* Paste panel — a contract may be built entirely from supplied
                   wording, with no positions at all. *@
                <div id="pastePanel" class="d-none mb-24">
                    <label class="form-label" for="pastedText">Existing contract text</label>
                    <textarea id="pastedText" class="form-control radius-8 wh-textarea-lg"
                              placeholder="Paste the contract you already have. It is stored exactly as you paste it — nothing rewrites it."></textarea>
                    <span class="wh-hint">
                        Stored as its own version, unchanged. You can generate an improved version from it afterwards,
                        and compare the two before approving either.
                    </span>

                    <div class="wh-actions mt-12">
                        <button type="button" class="btn btn-primary text-sm px-20 py-11 radius-8" data-action="import-text">
                            Store this text
                        </button>
                        <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8" data-action="toggle-paste">
                            Cancel
                        </button>
                    </div>
                </div>

                @* ---- what this contract is built from, and how far it has got ---- *@
                @if (Model.SuppliedSource is not null)
                {
                    var supplied = Model.SuppliedSource;

                    <div class="border radius-8 p-16 mb-24" id="sourceStatus">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-12">
                            <h6 class="fw-semibold mb-0">
                                <i class="ri-file-text-line me-1"></i> Contract source: @Model.Source.ModeLabel
                            </h6>
                            <span class="badge bg-primary-focus text-primary-600 border border-primary-600 px-16 py-4 radius-4">
                                Source version @supplied.Version
                            </span>
                        </div>

                        <dl class="row mb-0 text-sm">
                            <dt class="col-6 col-md-4 fw-medium text-secondary-light py-4">Saved</dt>
                            <dd class="col-6 col-md-8 py-4 mb-0">
                                Yes, @Format.DateTime(supplied.GeneratedAt), kept unchanged
                            </dd>

                            <dt class="col-6 col-md-4 fw-medium text-secondary-light py-4">Language</dt>
                            <dd class="col-6 col-md-8 py-4 mb-0">@(supplied.SourceLanguage ?? "not detected")</dd>

                            <dt class="col-6 col-md-4 fw-medium text-secondary-light py-4">Analysis</dt>
                            <dd class="col-6 col-md-8 py-4 mb-0">
                                @switch (supplied.ExtractionStatus)
                                {
                                    case ContractExtractionStatus.Confirmed:
                                        <text>Reviewed and confirmed</text>
                                        break;
                                    case ContractExtractionStatus.Analysed:
                                        <text>Analysed — waiting for your review</text>
                                        break;
                                    case ContractExtractionStatus.Failed:
                                        <text>Last attempt failed. The contract text is unaffected.</text>
                                        break;
                                    default:
                                        <text>Not analysed. Optional — the contract can go ahead without it.</text>
                                        break;
                                }
                            </dd>

                            <dt class="col-6 col-md-4 fw-medium text-secondary-light py-4">Approval</dt>
                            <dd class="col-6 col-md-8 py-4 mb-0">
                                @(Model.ApprovedVersion is null
                                    ? "No version approved yet"
                                    : $"Version {Model.ApprovedVersion.Version} approved")
                            </dd>

                            <dt class="col-6 col-md-4 fw-medium text-secondary-light py-4">Positions</dt>
                            <dd class="col-6 col-md-8 py-4 mb-0">
                                @if (!Model.HasPositions)
                                {
                                    <text>None — optional for this contract</text>
                                }
                                else
                                {
                                    @($"{Model.Totals.PositionCount} added")
                                }
                            </dd>
                        </dl>

                        @if (!Model.IsLocked)
                        {
                            <div class="wh-actions mt-16">
                                <button type="button" class="btn btn-outline-primary text-sm px-16 py-8 radius-8 wh-ai-action"
                                        data-action="analyze-source" data-version="@supplied.Version"
                                        data-ai="true"
                                        title="Reads this document with the AI model. Nothing it finds is applied until you confirm it.">
                                    <partial name="_AiMark" />
                                    @(supplied.ExtractionStatus == ContractExtractionStatus.NotAnalysed
                                        ? "Analyse this contract" : "Analyse again")
                                </button>
                            </div>
                        }
                    </div>
                }

                @* Was a four-line paragraph restating the same guarantee three
                   ways. One sentence carries it; the detail belongs in the docs,
                   not above every contract. *@
                <div class="alert alert-info radius-8 text-sm" role="note">
                    <i class="ri-information-line"></i>
                    The assistant never changes a figure — prices and dates come from the positions or the
                    document itself, and you approve the wording before it is sent.
                </div>

                @* ---- review of what analysis read out of the document ---- *@
                <div id="extractionReview" class="@(Model.Extraction is null ? "d-none" : "") border radius-8 p-16 mb-24">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-12">
                        <h6 class="fw-semibold mb-0">What the contract says</h6>
                        <span class="text-secondary-light text-sm">
                            Nothing here changes the contract until you confirm it.
                        </span>
                    </div>

                    <div id="extractionWarnings" class="d-none alert alert-warning radius-8 text-sm">
                        <ul class="mb-0 ps-16" id="extractionWarningList"></ul>
                    </div>

                    @*
                        What the money adds up to, and what it does not.

                        One number cannot honestly describe a contract that mixes a
                        fixed fee, an hourly rate with no agreed hours, and an
                        optional extra. These are the engine's own buckets: the
                        arithmetic is the application's and is reproducible, and
                        anything it would not total is named below with the reason
                        rather than quietly left out of the figure.
                    *@
                    @if (Model.Financials is not null)
                    {
                        var money = Model.Financials;
                        var currency = string.IsNullOrWhiteSpace(money.Currency) ? "EUR" : money.Currency;

                        <div class="border radius-8 p-16 mb-16">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-12">
                                <h6 class="fw-semibold mb-0 text-sm">What this adds up to</h6>

                                @if (money.IsPartial)
                                {
                                    @Badge.Html("Partial", "warning")
                                }
                            </div>

                            <dl class="row mb-0 text-sm">
                                @if (money.CommittedOneTime != 0m)
                                {
                                    <dt class="col-7 fw-medium text-secondary-light py-4">Committed, one-off</dt>
                                    <dd class="col-5 text-end py-4 mb-0">@Format.Money(money.CommittedOneTime, currency)</dd>
                                }

                                @if (money.CommittedRecurringTotal != 0m)
                                {
                                    <dt class="col-7 fw-medium text-secondary-light py-4">Committed, over the term</dt>
                                    <dd class="col-5 text-end py-4 mb-0">@Format.Money(money.CommittedRecurringTotal, currency)</dd>

                                    <dt class="col-7 fw-medium text-secondary-light py-4">— per month</dt>
                                    <dd class="col-5 text-end py-4 mb-0">@Format.Money(money.CommittedMonthlyEquivalent, currency)</dd>
                                }

                                @if (money.Discounts != 0m)
                                {
                                    <dt class="col-7 fw-medium text-secondary-light py-4">Discounts</dt>
                                    <dd class="col-5 text-end py-4 mb-0">-@Format.Money(money.Discounts, currency)</dd>
                                }

                                @if (money.CommittedTax != 0m)
                                {
                                    <dt class="col-7 fw-medium text-secondary-light py-4">Tax on committed</dt>
                                    <dd class="col-5 text-end py-4 mb-0">@Format.Money(money.CommittedTax, currency)</dd>
                                }
                            </dl>

                            <hr class="my-12">

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-sm">Committed net</span>
                                <span class="fw-bold">
                                    @if (money.HasNoCommittedValue)
                                    {
                                        @* Not "0,00 €": nothing committed is not the
                                           same claim as a contract that is free. *@
                                        <text>Nothing committed</text>
                                    }
                                    else
                                    {
                                        @Format.Money(money.CommittedNet, currency)
                                    }
                                </span>
                            </div>

                            @* Money that is real but that nobody has agreed to owe.
                               Kept out of the committed figure and shown anyway, so
                               it is neither counted nor hidden. *@
                            @if (money.Estimated != 0m || money.VariableRateTotal != 0m || money.Optional != 0m)
                            {
                                <dl class="row mb-0 text-sm mt-12 pt-12 border-top">
                                    @if (money.Estimated != 0m)
                                    {
                                        <dt class="col-7 fw-medium text-secondary-light py-4">Estimated</dt>
                                        <dd class="col-5 text-end py-4 mb-0">@Format.Money(money.Estimated, currency)</dd>
                                    }

                                    @if (money.VariableRateTotal != 0m)
                                    {
                                        <dt class="col-7 fw-medium text-secondary-light py-4">Depends on usage</dt>
                                        <dd class="col-5 text-end py-4 mb-0">@Format.Money(money.VariableRateTotal, currency)</dd>
                                    }

                                    @if (money.Optional != 0m)
                                    {
                                        <dt class="col-7 fw-medium text-secondary-light py-4">Optional</dt>
                                        <dd class="col-5 text-end py-4 mb-0">@Format.Money(money.Optional, currency)</dd>
                                    }
                                </dl>

                                <p class="wh-hint mt-8 mb-0">
                                    Not included in the committed total. Nobody has agreed to owe these.
                                </p>
                            }

                            @if (money.Unresolved.Count > 0)
                            {
                                <div class="mt-12 pt-12 border-top">
                                    <div class="fw-medium text-sm mb-8">Not counted, and why</div>

                                    <ul class="mb-0 ps-16 text-sm text-secondary-light">
                                        @foreach (var item in money.Unresolved)
                                        {
                                            <li><span class="fw-medium">@item.TermName</span> — @item.Reason</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table text-sm mb-0" id="extractionTable">
                            <thead>
                                <tr>
                                    <th style="width: 22%">Field</th>
                                    <th style="width: 30%">Value</th>
                                    <th style="width: 30%">Read from</th>
                                    <th style="width: 18%" class="text-end">Confirm</th>
                                </tr>
                            </thead>
                            <tbody id="extractionBody"></tbody>
                        </table>
                    </div>

                    <div id="extractedPositionsBlock" class="d-none mt-20">
                        <h6 class="fw-semibold mb-8">Positions found in the text</h6>
                        <p class="text-secondary-light text-sm">
                            Optional. Tick the ones you want as contract positions, then add them — they arrive in
                            the list above, editable, and are only stored when you save.
                        </p>
                        <div class="table-responsive">
                            <table class="table text-sm mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 6%"></th>
                                        <th>Service</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Unit price</th>
                                        <th class="text-end">Line total</th>
                                    </tr>
                                </thead>
                                <tbody id="extractedPositionsBody"></tbody>
                            </table>
                        </div>
                        <div class="wh-actions mt-12">
                            <button type="button" class="btn btn-outline-primary text-sm px-16 py-8 radius-8"
                                    data-action="add-extracted-positions">
                                <i class="ri-add-line"></i> Add the ticked positions
                            </button>
                        </div>
                    </div>

                    @if (!Model.IsLocked)
                    {
                        <div class="wh-actions mt-16">
                            <button type="button" class="btn btn-primary text-sm px-20 py-11 radius-8"
                                    data-action="confirm-extraction"
                                    data-version="@(Model.SuppliedSource?.Version ?? 0)">
                                <i class="ri-check-line"></i> Save the confirmed values
                            </button>
                        </div>
                    }
                </div>

                <div id="draftArea">
                    @if (Model.Drafts.Count == 0)
                    {
                        <p class="text-secondary-light text-sm mb-0">No contract text yet.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush" id="draftList">
                            @foreach (var d in Model.Drafts)
                            {
                                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0"
                                    id="version-@d.Version" data-version="@d.Version">
                                    <span>
                                        <strong>Version @d.Version</strong>

                                        @* What kind of version this is, and where it stands. Two
                                           separate facts: an approved supplied original and an
                                           approved prepared draft are both approved and are not
                                           the same thing. Showing only a date left it impossible
                                           to tell the source from the analysis from the draft
                                           that was ready to sign. *@
                                        <span class="badge bg-neutral-200 text-neutral-600 px-12 py-2 radius-4 ms-2">
                                            @d.KindLabel
                                        </span>

                                        <span class="text-secondary-light text-sm ms-2">
                                            @Format.DateTime(d.GeneratedAt)
                                            @if (!string.IsNullOrWhiteSpace(d.Model))
                                            {
                                                <text> · @d.Model</text>
                                            }
                                            @if (d.IsImmutableSource)
                                            {
                                                <text> · kept unchanged</text>
                                            }
                                        </span>
                                    </span>
                                    <span class="d-inline-flex align-items-center gap-2">
                                        @switch (d.Status)
                                        {
                                            case ContractDraftStatus.Approved:
                                                <span class="badge bg-success-focus text-success-main border border-success-main px-16 py-4 radius-4">Approved</span>
                                                break;
                                            case ContractDraftStatus.Superseded:
                                                @* Superseded, not deleted: it is still the text somebody may have signed. *@
                                                <span class="badge bg-neutral-200 text-neutral-600 px-16 py-4 radius-4">Superseded</span>
                                                break;
                                            case ContractDraftStatus.Signed:
                                                <span class="badge bg-success-focus text-success-main border border-success-main px-16 py-4 radius-4">Signed</span>
                                                break;
                                            default:
                                                <span class="badge bg-warning-focus text-warning-main border border-warning-main px-16 py-4 radius-4">Draft</span>
                                                break;
                                        }

                                        @* Reading comes before agreeing: every version can be
                                           opened on the contract page, where the wording renders
                                           as the document it will become. Approval used to be the
                                           only act on offer, on text nobody had been shown. *@
                                        <a class="btn btn-sm btn-outline-primary radius-8"
                                           asp-page="/Contracts/Details"
                                           asp-route-id="@Model.ContractId"
                                           asp-route-version="@d.Version">
                                            <i class="ri-eye-line"></i> View
                                        </a>

                                        @if (!Model.IsLocked && d.Status != ContractDraftStatus.Approved)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary radius-8"
                                                    data-action="approve-version" data-version="@d.Version">
                                                Approve
                                            </button>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </section>
    </div>

    @* ============ sticky summary and the primary action ============ *@
    <div class="col-12 col-xl-4">
        <div class="wh-sticky-panel">
            <div class="card radius-12 border">
                <div class="card-body">
                    <h6 class="fw-semibold mb-16">Summary</h6>

                    <dl class="row mb-0 text-sm">
                        <dt class="col-7 fw-medium text-secondary-light py-4">Positions</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="count">@Model.Totals.PositionCount</dd>

                        <dt class="col-7 fw-medium text-secondary-light py-4">Subtotal</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="subtotal">—</dd>

                        <dt class="col-7 fw-medium text-secondary-light py-4">Discount</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="discount">—</dd>

                        <dt class="col-7 fw-medium text-secondary-light py-4">VAT</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="vat">—</dd>
                    </dl>

                    <hr class="my-12">

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Total</span>
                        <span class="fs-5 fw-bold" data-total="total">
                            @if (!Model.HasPositions && Model.Money.AgreedTotalNet is null)
                            {
                                @* 0,00 € for a contract whose text names a price is a claim
                                   the system has no basis for. *@
                                <text>Not specified</text>
                            }
                            else if (!Model.HasPositions)
                            {
                                @Format.Money(Model.Money.AgreedTotalNet!.Value, Model.Money.Currency)
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </span>
                    </div>

                    <p class="wh-hint mt-8 mb-0 @(Model.HasPositions ? "d-none" : "")" id="contractTotalNote">
                        @if (Model.Money.AgreedTotalNet is not null)
                        {
                            <text>Contract-level total from the supplied contract.</text>
                        }
                        else if (Model.Money.PriceDeliberatelyUnspecified)
                        {
                            <text>Confirmed: this contract deliberately names no price.</text>
                        }
                        else
                        {
                            <text>No total is stated in the supplied contract.</text>
                        }
                    </p>

                    @if (!Model.IsLocked)
                    {
                        <div class="d-grid gap-2 mt-20">
                            @* Offered while there are positions to save, and only
                               then — on a supplied-text contract with none it is
                               an action with nothing to act on.

                               "While", not "when the page loaded". It used to be
                               rendered server-side from the saved positions, so a
                               new contract never got the button at all: you could
                               add a position and then had no way to save it. The
                               builder shows and hides it as the list changes; the
                               class here is only the state the page opens in. *@
                            <button type="button"
                                    id="savePositionsBtn"
                                    class="btn btn-outline-primary radius-8 @(Model.HasPositions ? "" : "d-none")"
                                    data-action="save">
                                <i class="ri-save-line me-1"></i> Save positions
                            </button>

                            @* The action names what it will actually do, which
                               depends on what the contract is built from. It is
                               disabled only when there is genuinely no source —
                               not when there happen to be no positions. *@
                            <button type="button" class="btn btn-primary radius-8 wh-ai-action" data-action="generate-draft"
                                    disabled="@(!Model.CanGenerate)" data-ai="true"
                                    title="Writes the contract wording with the AI model. It is created as a draft for you to review before approval.">
                                <partial name="_AiMark" /> @Model.Source.PrimaryActionLabel
                            </button>
                        </div>

                        @* What to do next, from where the contract actually stands. *@
                        <div class="alert alert-info radius-8 text-sm mt-16 mb-0" id="nextStep">
                            <i class="ri-guide-line me-1"></i> @Model.NextStepHint
                        </div>

                        <p class="wh-hint mt-12 mb-0" id="generateHint">
                            @if (Model.CanGenerate)
                            {
                                <text>Contract source: <strong>@Model.Source.ModeLabel</strong>.</text>
                                @if (!Model.HasPositions)
                                {
                                    <text> Positions are optional for this contract.</text>
                                }
                            }
                            else
                            {
                                @Model.Source.BlockingReason
                            }
                        </p>
                    }

                    <p class="wh-hint mt-12 mb-0">
                        Totals are recalculated on the server when you save. The figures shown here are a preview.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@* ============ saved-service picker ============ *@
<div class="modal fade" id="catalogModal" tabindex="-1" aria-labelledby="catalogTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content radius-12">
            <div class="modal-header wh-modal-header">
                <h5 class="modal-title" id="catalogTitle">Add from saved services</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-24">
                <div class="icon-field mb-16">
                    <span class="icon top-50 translate-middle-y"><i class="ri-search-line"></i></span>
                    <input type="search" id="catalogSearch" class="form-control radius-8"
                           placeholder="Search saved services…" autocomplete="off">
                </div>

                <p class="wh-hint mb-16">
                    The service is copied into a position you can then edit freely. The saved service itself is
                    not changed, and editing it later does not alter this contract.
                </p>

                <div class="list-group list-group-flush" id="catalogPickerList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary radius-8" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>

@* ============ AI review modal ============ *@
<div class="modal fade" id="organizeModal" tabindex="-1" aria-labelledby="organizeTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content radius-12">
            <div class="modal-header wh-modal-header">
                <h5 class="modal-title" id="organizeTitle">Organise positions with AI</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-24">
                <div id="organizeInputStep">
                    <label class="form-label" for="roughInput">Describe the work</label>
                    <textarea id="roughInput" class="form-control radius-8" rows="6"
                              placeholder="e.g. monthly support 2.380 EUR per month; SEO setup, one-off 1.500 EUR; 8 hours training at 120 EUR"></textarea>
                    @* Both halves of the rule, because they are different and the
                       old wording only stated one of them — which read as a promise
                       that a price written here would be ignored. *@
                    <span class="wh-hint">
                        Write a price, a quantity or a billing cycle for work you are describing for the
                        first time and it will be filled in for you. Positions already in the list keep the
                        figures you entered — the assistant may only improve their wording.
                    </span>
                </div>

                <div id="organizeReviewStep" class="d-none">
                    <div id="rejectedBox" class="alert alert-warning radius-8 d-none">
                        <strong>Commercial values were kept as you entered them.</strong>
                        <p class="text-sm mb-2">The assistant proposed different figures. They were not applied:</p>
                        <ul class="text-sm mb-0" id="rejectedList"></ul>
                    </div>

                    <div id="changesBox">
                        <p class="fw-semibold mb-2">Proposed changes</p>
                        <ul class="text-sm" id="changesList"></ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary radius-8" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary radius-8 wh-ai-action" data-action="run-organize" data-ai="true"
                        title="Sends the text above to the AI model and proposes positions for you to review.">
                    <partial name="_AiMark" /> Organise
                </button>
                <button type="button" class="btn btn-success radius-8 d-none" data-action="apply-organize">Apply positions</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script id="initialPositions" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.Positions, jsonOptions))
    </script>
    <script id="catalogServices" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.CatalogServices, jsonOptions))
    </script>
    <script id="contractMoney" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.Money, jsonOptions))
    </script>
    <script id="initialExtraction" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.Extraction, jsonOptions))
    </script>
    <script src="~/js/decimal-culture.js" asp-append-version="true"></script>
    <script src="~/js/pages/contracts/positions-builder.js" asp-append-version="true"></script>
}
