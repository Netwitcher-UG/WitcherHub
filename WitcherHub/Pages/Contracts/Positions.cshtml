@page "{contractId:guid}"
@using System.Text.Json
@using WitcherHub.Pages.Models.UI
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Contracts.PositionsModel
@{
    ViewData["Title"] = "Contract builder";

    // Enums must travel as names. Serialised as numbers, the builder's option
    // matching silently falls back to the first entry, so a Monthly position
    // renders as OneTime and a manual one is labelled Catalog.
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    var contract = Model.Contract!;
    var step = Model.CurrentStep;
}

@* ======================================================================
   Compact identity header. Contract number, who it is with, and its state —
   the four things needed to know which contract this is, on one line.
   ====================================================================== *@
<div class="wh-section d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <nav class="mb-8">
            <a asp-page="/Contracts/Index" class="text-secondary-light text-sm hover-text-primary d-inline-flex align-items-center gap-1">
                <i class="ri-arrow-left-line"></i> All contracts
            </a>
        </nav>

        <div class="d-flex flex-wrap align-items-center gap-3">
            <h3 class="mb-0 fw-semibold">@contract.ContractNo</h3>
            <partial name="_StatusBadge" model="DocumentStatusPresentation.ForContract(contract.Status)" />
            <span class="text-secondary-light text-sm">@contract.Currency</span>
        </div>

        <p class="text-secondary-light mb-0 mt-8 text-sm">
            <a asp-page="/Clients/Details" asp-route-id="@contract.CustomerId" class="text-primary-600 fw-medium">@contract.CustomerName</a>
            ·
            <a asp-page="/Projects/Workspace" asp-route-id="@contract.ProjectId" asp-route-tab="contracts" class="hover-text-primary">@contract.ProjectTitle</a>
        </p>
    </div>

    <div class="wh-actions">
        <a asp-page="/Contracts/Details" asp-route-id="@Model.ContractId"
           class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2">
            <i class="ri-file-text-line"></i> View contract
        </a>
    </div>
</div>

@if (Model.IsLocked)
{
    <div class="wh-section alert alert-warning radius-8 d-flex align-items-start gap-2 mb-0" role="alert">
        <i class="ri-lock-line mt-1"></i>
        <span>
            This contract is <strong>@contract.Status.ToString().ToLowerInvariant()</strong>. Positions and terms are
            frozen so the document that was signed stays the document that was signed. Generate a new
            contract to change what was agreed.
        </span>
    </div>
}

@* ======================================================================
   Progress. Which parts are done, and what is left.
   ====================================================================== *@
<div class="wh-section">
    <ol class="wh-stepper" aria-label="Contract progress">
        <li class="wh-stepper__step @(step > 1 ? "is-done" : "is-current")">
            <span class="wh-stepper__mark">1</span>
            <span class="wh-stepper__label">Contract details</span>
        </li>
        <li class="wh-stepper__step @(step > 2 ? "is-done" : step == 2 ? "is-current" : "")">
            <span class="wh-stepper__mark">2</span>
            <span class="wh-stepper__label">What the contract covers</span>
        </li>
        <li class="wh-stepper__step @(step > 3 ? "is-done" : step == 3 ? "is-current" : "")">
            <span class="wh-stepper__mark">3</span>
            <span class="wh-stepper__label">Contract text</span>
        </li>
        <li class="wh-stepper__step @(step == 4 ? "is-current" : "")">
            <span class="wh-stepper__mark">4</span>
            <span class="wh-stepper__label">Review and approve</span>
        </li>
    </ol>
</div>

<div class="row g-4" id="positionsApp"
     data-contract-id="@Model.ContractId"
     data-currency="@(contract.Currency ?? "EUR")"
     data-locked="@Model.IsLocked.ToString().ToLowerInvariant()">

    <div class="col-12 col-xl-8">

        @* ============ step 1: contract details ============ *@
        <section class="card radius-12 border wh-section mt-0">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-16">
                    <div>
                        <h6 class="fw-semibold mb-4">Contract details</h6>
                        <p class="text-secondary-light text-sm mb-0">
                            The parties come from the customer record. Dates and billing apply to the whole contract.
                        </p>
                    </div>
                </div>

                @* The two parties, stated plainly. A contract that does not name
                   who it is between is not a contract. *@
                <div class="row g-3 mb-24">
                    <div class="col-12 col-md-6">
                        <div class="wh-party">
                            <span class="wh-party__role">Provider</span>
                            <span class="wh-party__name">Netwitcher UG</span>
                            <span class="wh-party__detail">Company details are taken from the contract template.</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="wh-party">
                            <span class="wh-party__role">Customer</span>
                            <span class="wh-party__name">@contract.CustomerName</span>
                            <a asp-page="/Clients/Details" asp-route-id="@contract.CustomerId"
                               class="wh-party__detail text-primary-600">Check address and representative</a>
                        </div>
                    </div>
                </div>

                <form method="post" asp-page-handler="Basics">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contractId" value="@Model.ContractId" />

                    <div class="wh-form-grid">
                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsStatus">Status</label>
                            <select asp-for="BasicsStatus" class="form-select radius-8" disabled="@Model.IsLocked">
                                <option value="@((int)DocumentStatus.Draft)">Draft</option>
                                <option value="@((int)DocumentStatus.Sent)">Sent</option>
                                <option value="@((int)DocumentStatus.Signed)">Signed</option>
                                <option value="@((int)DocumentStatus.Terminated)">Terminated</option>
                                <option value="@((int)DocumentStatus.Cancelled)">Cancelled</option>
                            </select>
                        </div>

                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsStartDate">Start date</label>
                            <input asp-for="BasicsStartDate" type="date" class="form-control radius-8 js-datepicker"
                                   disabled="@Model.IsLocked">
                        </div>

                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsEndDate">End date</label>
                            <input asp-for="BasicsEndDate" type="date" class="form-control radius-8 js-datepicker"
                                   disabled="@Model.IsLocked">
                            <span class="wh-hint">Leave empty for an open-ended contract.</span>
                        </div>

                        <div class="wh-col-quarter">
                            <label class="form-label" asp-for="BasicsInvoiceSendMode">Invoicing</label>
                            <select asp-for="BasicsInvoiceSendMode" class="form-select radius-8" disabled="@Model.IsLocked">
                                <option value="@((int)InvoiceSendMode.Automatic)">Send invoices automatically</option>
                                <option value="@((int)InvoiceSendMode.Manual)">Create invoices, send them myself</option>
                            </select>
                            <span class="wh-hint">What happens when an invoice falls due.</span>
                        </div>

                        <div class="wh-col-full">
                            <label class="form-label" asp-for="BasicsIntroduction">Contract introduction</label>
                            <textarea asp-for="BasicsIntroduction" class="form-control radius-8 wh-textarea-sm"
                                      placeholder="Optional. Wording that appears before the positions — the purpose of the agreement, or a specific arrangement made with this customer."
                                      disabled="@Model.IsLocked"></textarea>
                            <span class="wh-hint">Optional. Appears at the top of the generated contract, above the positions.</span>
                        </div>
                    </div>

                    @if (!Model.IsLocked)
                    {
                        <div class="wh-actions wh-actions--end mt-16">
                            <button type="submit" class="btn btn-outline-primary text-sm px-20 py-11 radius-8">
                                Save contract details
                            </button>
                        </div>
                    }
                </form>
            </div>
        </section>

        @* ============ step 2: what the contract covers ============ *@
        <section class="card radius-12 border wh-section">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-16">
                    <div>
                        <h6 class="fw-semibold mb-4">What the contract covers</h6>
                        <p class="text-secondary-light text-sm mb-0">
                            Positions can come from your saved services, be typed in by hand, or both.
                            A saved service is not required.
                        </p>
                    </div>
                    <span class="text-secondary-light text-sm" data-total="count-label">
                        @Model.Totals.PositionCount @(Model.Totals.PositionCount == 1 ? "position" : "positions")
                    </span>
                </div>

                @if (!Model.IsLocked)
                {
                    <div class="wh-actions mb-16">
                        <button type="button" class="btn btn-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2"
                                data-action="add-manual">
                            <i class="ri-add-line"></i> Add manual position
                        </button>
                        <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2"
                                data-action="add-catalog">
                            <i class="ri-box-3-line"></i> Add from saved services
                        </button>
                        <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2 ms-auto"
                                data-action="organize">
                            <i class="ri-magic-line"></i> Organise with AI
                        </button>
                    </div>
                }

                @* The empty state offers all three routes, because an empty
                   contract does not have one obvious next move. *@
                <div id="emptyState" class="d-none">
                    <partial name="_EmptyState" model="@(new EmptyStateVm
                           {
                               Title = "No contract positions yet",
                               Message = "Add a saved service, create a manual position, or paste an existing contract text. None of these is required by the others.",
                               Icon = "ri-list-check-2",
                               Actions =
                               [
                                   new EmptyStateAction { Text = "Add manual position", Url = "add-manual", Icon = "ri-add-line", IsPrimary = true, IsButton = true },
                                   new EmptyStateAction { Text = "Add from saved services", Url = "add-catalog", Icon = "ri-box-3-line", IsButton = true },
                                   new EmptyStateAction { Text = "Paste contract text", Url = "focus-paste", Icon = "ri-clipboard-line", IsButton = true }
                               ]
                           })" />
                </div>

                <div id="positionList" class="d-flex flex-column gap-3"></div>
            </div>
        </section>

        @* ============ step 3: contract text ============ *@
        <section class="card radius-12 border wh-section" id="contractTextSection">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-16">
                    <div>
                        <h6 class="fw-semibold mb-4">Contract text</h6>
                        <p class="text-secondary-light text-sm mb-0">
                            Generate the wording from the positions above, or supply text you already have.
                        </p>
                    </div>
                    <div class="wh-actions">
                        <button type="button" class="btn btn-outline-primary text-sm px-16 py-8 radius-8 d-inline-flex align-items-center gap-2"
                                data-action="toggle-paste">
                            <i class="ri-clipboard-line"></i> Paste existing text
                        </button>
                    </div>
                </div>

                @* Paste panel — a contract may be built entirely from supplied
                   wording, with no positions at all. *@
                <div id="pastePanel" class="d-none mb-24">
                    <label class="form-label" for="pastedText">Existing contract text</label>
                    <textarea id="pastedText" class="form-control radius-8 wh-textarea-lg"
                              placeholder="Paste the contract you already have. It is stored exactly as you paste it — nothing rewrites it."></textarea>
                    <span class="wh-hint">
                        Stored as its own version, unchanged. You can generate an improved version from it afterwards,
                        and compare the two before approving either.
                    </span>

                    <div class="wh-actions mt-12">
                        <button type="button" class="btn btn-primary text-sm px-20 py-11 radius-8" data-action="import-text">
                            Store this text
                        </button>
                        <button type="button" class="btn btn-outline-primary text-sm px-20 py-11 radius-8" data-action="toggle-paste">
                            Cancel
                        </button>
                    </div>
                </div>

                <div class="alert alert-info radius-8 text-sm" role="note">
                    <i class="ri-information-line"></i>
                    The assistant writes wording from the positions. It never sets or changes a price, quantity,
                    VAT rate, discount, currency, date or duration — those come from the positions exactly as you
                    entered them. A person must review and approve the wording before it is sent.
                </div>

                <div id="draftArea">
                    @if (Model.Drafts.Count == 0)
                    {
                        <p class="text-secondary-light text-sm mb-0">No contract text yet.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush" id="draftList">
                            @foreach (var d in Model.Drafts)
                            {
                                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0"
                                    data-version="@d.Version">
                                    <span>
                                        <strong>Version @d.Version</strong>
                                        <span class="text-secondary-light text-sm ms-2">
                                            @Format.DateTime(d.GeneratedAt)
                                            @if (string.Equals(d.GeneratedBy, "pasted", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <text> · supplied text</text>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(d.Model))
                                            {
                                                <text> · @d.Model</text>
                                            }
                                        </span>
                                    </span>
                                    @if (d.IsApproved)
                                    {
                                        <span class="badge bg-success-focus text-success-main border border-success-main px-16 py-4 radius-4">Approved</span>
                                    }
                                    else if (!Model.IsLocked)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary radius-8"
                                                data-action="approve-version" data-version="@d.Version">
                                            Approve
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </section>
    </div>

    @* ============ sticky summary and the primary action ============ *@
    <div class="col-12 col-xl-4">
        <div class="wh-sticky-panel">
            <div class="card radius-12 border">
                <div class="card-body">
                    <h6 class="fw-semibold mb-16">Summary</h6>

                    <dl class="row mb-0 text-sm">
                        <dt class="col-7 fw-medium text-secondary-light py-4">Positions</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="count">@Model.Totals.PositionCount</dd>

                        <dt class="col-7 fw-medium text-secondary-light py-4">Subtotal</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="subtotal">—</dd>

                        <dt class="col-7 fw-medium text-secondary-light py-4">Discount</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="discount">—</dd>

                        <dt class="col-7 fw-medium text-secondary-light py-4">VAT</dt>
                        <dd class="col-5 text-end py-4 mb-0" data-total="vat">—</dd>
                    </dl>

                    <hr class="my-12">

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Total</span>
                        <span class="fs-5 fw-bold" data-total="total">—</span>
                    </div>

                    @if (!Model.IsLocked)
                    {
                        <div class="d-grid gap-2 mt-20">
                            <button type="button" class="btn btn-outline-primary radius-8" data-action="save">
                                <i class="ri-save-line me-1"></i> Save positions
                            </button>
                            <button type="button" class="btn btn-primary radius-8" data-action="generate-draft">
                                <i class="ri-magic-line me-1"></i> Generate contract draft
                            </button>
                        </div>

                        <p class="wh-hint mt-12 mb-0" id="generateHint">
                            @if (Model.CanGenerate)
                            {
                                <text>A draft can be generated from the positions, the supplied text, or both.</text>
                            }
                            else
                            {
                                <text>Add a position or paste contract text first.</text>
                            }
                        </p>
                    }

                    <p class="wh-hint mt-12 mb-0">
                        Totals are recalculated on the server when you save. The figures shown here are a preview.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@* ============ saved-service picker ============ *@
<div class="modal fade" id="catalogModal" tabindex="-1" aria-labelledby="catalogTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content radius-12">
            <div class="modal-header wh-modal-header">
                <h5 class="modal-title" id="catalogTitle">Add from saved services</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-24">
                <div class="icon-field mb-16">
                    <span class="icon top-50 translate-middle-y"><i class="ri-search-line"></i></span>
                    <input type="search" id="catalogSearch" class="form-control radius-8"
                           placeholder="Search saved services…" autocomplete="off">
                </div>

                <p class="wh-hint mb-16">
                    The service is copied into a position you can then edit freely. The saved service itself is
                    not changed, and editing it later does not alter this contract.
                </p>

                <div class="list-group list-group-flush" id="catalogPickerList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary radius-8" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>

@* ============ AI review modal ============ *@
<div class="modal fade" id="organizeModal" tabindex="-1" aria-labelledby="organizeTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content radius-12">
            <div class="modal-header wh-modal-header">
                <h5 class="modal-title" id="organizeTitle">Organise positions with AI</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-24">
                <div id="organizeInputStep">
                    <label class="form-label" for="roughInput">Describe the work</label>
                    <textarea id="roughInput" class="form-control radius-8" rows="6"
                              placeholder="e.g. new website with 5 pages, monthly hosting, SEO setup"></textarea>
                    <span class="wh-hint">
                        Prices, quantities, VAT, discounts, dates and billing cycles stay exactly as you
                        entered them. The assistant only organises and improves the wording.
                    </span>
                </div>

                <div id="organizeReviewStep" class="d-none">
                    <div id="rejectedBox" class="alert alert-warning radius-8 d-none">
                        <strong>Commercial values were kept as you entered them.</strong>
                        <p class="text-sm mb-2">The assistant proposed different figures. They were not applied:</p>
                        <ul class="text-sm mb-0" id="rejectedList"></ul>
                    </div>

                    <div id="changesBox">
                        <p class="fw-semibold mb-2">Proposed changes</p>
                        <ul class="text-sm" id="changesList"></ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary radius-8" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary radius-8" data-action="run-organize">Organise</button>
                <button type="button" class="btn btn-success radius-8 d-none" data-action="apply-organize">Apply positions</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script id="initialPositions" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.Positions, jsonOptions))
    </script>
    <script id="catalogServices" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(Model.CatalogServices, jsonOptions))
    </script>
    <script src="~/js/decimal-culture.js" asp-append-version="true"></script>
    <script src="~/js/pages/contracts/positions-builder.js" asp-append-version="true"></script>
}
