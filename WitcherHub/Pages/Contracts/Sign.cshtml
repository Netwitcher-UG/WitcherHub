@page "/contracts/sign/{id:guid?}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using System.Text.Json
@using WitcherHub.Resources
@attribute [AllowAnonymous]
@model WitcherHub.Pages.Contracts.SignModel
@inject IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["contractPage_Title"];
    Layout = "_ContractsLayout";
}

<!-- Anti-forgery token (we will send it via header from JS) -->
<form method="post" id="afForm">
    @Html.AntiForgeryToken()
</form>

<input type="hidden" id="signEndpoint"
       value="@Url.Page("/Contracts/Sign", "Sign", new { id = Model.Id, t = Model.Token })" />

<script>
    window.contractServerState = @Html.Raw(JsonSerializer.Serialize(new {
        isSigned = Model.IsSigned,
        signedAtIso = Model.SignedAtIso ?? "",
        signatureDataUrl = Model.SignatureDataUrl ?? "",
        signerName = Model.SignerNamePrefill ?? "",
        signerEmail = Model.SignerEmailPrefill ?? ""
    }));
</script>

<div class="contractPage">
    <div class="contractPage__langFab" aria-label="Language switch">
        <button class="contractPage__langBtn" type="button" data-culture="en">EN</button>
        <button class="contractPage__langBtn" type="button" data-culture="de">DE</button>
    </div>

    <div class="contractPage__container">
        <div class="contractPage__paper" id="paper">

            <div class="contractPage__contractHtml contractPdfScope">
                @Html.Raw(Model.ContractHtml)
            </div>

            <div class="contractActions" id="contractActions">
                @* Two confirmations, each its own box.

                   The second one used to be the sentence "Please review both
                   documents carefully before signing" — advice, sitting where a
                   decision belongs. Accepting the terms is now something the
                   signer does rather than something they are told to do, and
                   Sign & Accept stays disabled until both boxes are ticked. *@
                <label class="contractActions__agree" for="chkAgree">
                    <input type="checkbox" id="chkAgree" />

                    <span class="contractActions__agreeBody">
                        <span class="contractActions__agreeLine">
                            @T["contractPage_AgreePrefix"]
                            <a id="termsLink"
                               href="https://netwitcher.com/de/agb-fuer-agenturen"
                               target="_blank"
                               rel="noopener noreferrer">
                                @T["contractPage_AgreeTermsLink"]
                            </a>
                            @T["contractPage_AgreeMiddle"]
                            @* Points at the contract's own clauses, above on this
                               page. It used to open the public privacy policy in
                               a new tab, under a link that says "Vertrag". *@
                            <a id="contractLink" href="@Model.ContractTermsAnchor">
                                @T["contractPage_AgreeContractLink"]
                            </a>@T["contractPage_AgreeSuffix"]
                        </span>
                    </span>
                </label>

                <label class="contractActions__agree" for="chkTerms">
                    <input type="checkbox" id="chkTerms" />

                    <span class="contractActions__agreeBody">
                        <span class="contractActions__agreeLine">
                            @T["contractPage_AcceptTermsLine"]
                        </span>
                    </span>
                </label>

                <div class="contractActions__right">
                    <div class="contractActions__badge" id="signedBadge">@T["contractPage_Unsigned"]</div>

                    <button class="contractActions__btn contractActions__btn--primary" type="button" id="btnOpen" disabled>
                        @T["contractPage_SignAccept"]
                    </button>

                    <button class="contractActions__btn" type="button" id="btnPrint">@T["contractPage_Print"]</button>
                    <button class="contractActions__btn" type="button" id="btnReset">@T["contractPage_Reset"]</button>
                </div>
            </div>

            <section class="contractSign" aria-label="@T["contractPage_SignaturesTitle"]">
                <h2 class="contractSign__title">@T["contractPage_SignaturesTitle"]</h2>

                <div class="contractSign__grid">
                    <div>
                        <div class="contractSign__party">@T["contractPage_CustomerParty"]</div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@T["contractPage_LabelName"]</div>
                            <input id="customerName"
                                   class="contractSign__input"
                                   type="text"
                                   value="@Model.SignerNamePrefill"
                                   autocomplete="name" />
                        </div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@T["contractPage_LabelEmail"]</div>
                            <input id="customerEmail"
                                   class="contractSign__input"
                                   type="email"
                                   value="@Model.SignerEmailPrefill"
                                   autocomplete="email" />
                        </div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@T["contractPage_LabelDate"]</div>
                            <div class="contractSign__line"><span id="customerDate"></span></div>
                        </div>

                        <div class="contractSign__row">
                            <div class="contractSign__label">@T["contractPage_LabelSignature"]</div>
                            <div id="sigBoxClick"
                                 class="contractSign__sigLine"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@T["contractPage_AddSignatureAria"]">
                                <img id="sigImage" class="contractSign__sigImg" alt="@T["contractPage_LabelSignature"]" />
                                <span id="sigPlaceholder" class="contractSign__placeholder"></span>
                            </div>
                        </div>

                        <div class="contractSign__meta">
                            @T["contractPage_SignedAtLabel"]: <span id="signedAt"></span>
                        </div>
                    </div>

                    <div>
                        <div class="contractSign__party">@T["contractPage_ProviderParty"]</div>

                        <div class="contractSign__providerBlock">
                            <div class="contractSign__providerName">@Model.ProviderName</div>
                            <div class="contractSign__providerAddress">@Model.ProviderAddress</div>
                        </div>

                        <div class="contractSign__providerNote">
                            (@T["contractPage_ProviderSignsInternally"])
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </div>

    <div class="contractPage__toast" id="toast"></div>

    <div class="contractPage__modal" id="sigModal" aria-hidden="true">
        <div class="contractPage__modalCard" role="dialog" aria-modal="true">
            <div class="contractPage__modalHead">
                <div>@T["contractPage_ModalTitle"]</div>
                <button class="contractPage__btn" type="button" id="btnClose" aria-label="@T["contractPage_Close"]">✕</button>
            </div>

            <div class="contractPage__modalBody">
                <div class="contractPage__modalHint">@T["contractPage_ModalHint"]</div>

                <div class="contractPage__sigPad">
                    <canvas id="sigCanvas" tabindex="0"></canvas>
                </div>

                <div class="contractPage__modalActions">
                    <button class="contractPage__btn" type="button" id="btnClear">@T["contractPage_Clear"]</button>
                    <button class="contractPage__btn contractPage__btn--primary" type="button" id="btnAccept">
                        @T["contractPage_AcceptSignature"]
                    </button>
                    <button class="contractPage__btn" type="button" id="btnCancel">@T["contractPage_Cancel"]</button>
                </div>
               @*  <form method="post" asp-page-handler="SendInvoice">
    <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
    <button type="submit" class="btn btn-primary">Send Invoice</button>
</form> *@
                <div class="contractPage__modalStatus" id="modalStatus"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.contractPageI18n = {
            fillName: "@T["contractPage_ErrFillName"]",
            fillEmail: "@T["contractPage_ErrFillEmail"]",
            fillFields: "@T["contractPage_ErrFillFields"]",
            invalidEmail: "@T["contractPage_ErrInvalidEmail"]",
            emptyCanvas: "@T["contractPage_ErrEmptyCanvas"]",
            mustAgree: "@T["contractPage_ErrMustAgree"]",
            mustAcceptTerms: "@T["contractPage_ErrMustAcceptTerms"]",
            cleared: "@T["contractPage_Cleared"]",
            signedOk: "@T["contractPage_SignedOk"]",
            signed: "@T["contractPage_Signed"]",
            unsigned: "@T["contractPage_Unsigned"]"
        };
    </script>
    <script src="~/js/pages/contracts/contract-sign.js" asp-append-version="true"></script>
}

