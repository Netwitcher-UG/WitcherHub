@page "{id:guid?}"
@using Microsoft.Extensions.Localization
@using WitcherHub.Resources
@model WitcherHub.Pages.Contracts.DetailsModel
@inject IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["contractPage_Title"];
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contracts/contract-sign.css" asp-append-version="true" />
}
@*
    Everything that can be done with this contract, in one bar.

    The positions builder in particular was reachable only by typing
    /Contracts/Positions/{id} into the address bar — nothing anywhere linked to
    it, so the manual-position editor was effectively invisible.
*@
@{
    var header = new PageHeaderVm
    {
        Title = Model.Contract?.ContractNo ?? "Contract",
        BackLabel = "All contracts",
        BackPage = "/Contracts/Index",

        Status = Model.Contract is null
            ? null
            : DocumentStatusPresentation.ForContract(Model.Contract.Status),

        @* Whether a signature exists is a separate fact from the contract's status,
           so it gets its own badge — in the same vocabulary as every other status
           in the application. It used to be a bespoke pill in a sticky bar of its
           own further down the page, so the state was given twice on one screen in
           two different visual languages. *@
        Badges =
        [
            (Model.IsSigned ? T["contractPage_Signed"].Value : T["contractPage_Unsigned"].Value,
             Model.IsSigned ? "success" : "neutral")
        ],

        Context = Model.Contract?.Project?.Customer is null
            ? []
            :
            [
                new PageLink
                {
                    Label = Model.Contract.Project.Customer.Name,
                    Page = "/Clients/Details",
                    RouteValues = new Dictionary<string, string?> { ["id"] = Model.Contract.Project.CustomerId.ToString() },
                    Emphasised = true
                },
                new PageLink
                {
                    Label = Model.Contract.Project.Title,
                    Page = "/Projects/Workspace",
                    RouteValues = new Dictionary<string, string?>
                    {
                        ["id"] = Model.ProjectId.ToString(),
                        ["tab"] = "contracts"
                    }
                }
            ],

        Actions =
        [
            new PageAction
            {
                Label = "Positions",
                Icon = "ri-list-check-2",
                Page = "/Contracts/Positions",
                RouteValues = new Dictionary<string, string?> { ["contractId"] = Model.ContractId.ToString() }
            },
            new PageAction
            {
                Label = "Edit",
                Icon = "ri-edit-line",
                Page = "/Contracts/Edit",
                RouteValues = new Dictionary<string, string?> { ["id"] = Model.ContractId.ToString() }
            },
            new PageAction
            {
                Label = T["contractPage_Print"].Value,
                Icon = "ri-printer-line",
                Style = PageActionStyle.Primary,
                Id = "btnPrint"
            }
        ]
    };
}

<partial name="_PageHeader" model="header" />

<div class="contractPage">

    <div class="contractPage__container">
        <div class="contractPage__paper" id="paper">
            <div class="contractPage__contractHtml">
                @Html.Raw(Model.ContractHtml)
            </div>
        </div>
    </div>

    <div class="contractPage__toast" id="toast"></div>
</div>

@section Scripts {
    <script>
        (function () {
            document.getElementById('btnPrint')?.addEventListener('click', function () {
                window.print();
            });
        })();
    </script>
}




