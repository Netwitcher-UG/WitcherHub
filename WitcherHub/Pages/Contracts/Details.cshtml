@page "{id:guid?}"
@using Microsoft.Extensions.Localization
@using WitcherHub.Resources
@model WitcherHub.Pages.Contracts.DetailsModel
@inject IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["contractPage_Title"];
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contracts/contract-sign.css" asp-append-version="true" />
}
@*
    Everything that can be done with this contract, in one bar.

    The positions builder in particular was reachable only by typing
    /Contracts/Positions/{id} into the address bar — nothing anywhere linked to
    it, so the manual-position editor was effectively invisible.
*@
@{
    var header = new PageHeaderVm
    {
        Title = Model.Contract?.ContractNo ?? "Contract",
        BackLabel = "All contracts",
        BackPage = "/Contracts/Index",

        Status = Model.Contract is null
            ? null
            : DocumentStatusPresentation.ForContract(Model.Contract.Status),

        @* Whether a signature exists is a separate fact from the contract's status,
           so it gets its own badge — in the same vocabulary as every other status
           in the application. It used to be a bespoke pill in a sticky bar of its
           own further down the page, so the state was given twice on one screen in
           two different visual languages. *@
        Badges =
        [
            (Model.IsSigned ? T["contractPage_Signed"].Value : T["contractPage_Unsigned"].Value,
             Model.IsSigned ? "success" : "neutral")
        ],

        Context = Model.Contract?.Project?.Customer is null
            ? []
            :
            [
                new PageLink
                {
                    Label = Model.Contract.Project.Customer.Name,
                    Page = "/Clients/Details",
                    RouteValues = new Dictionary<string, string?> { ["id"] = Model.Contract.Project.CustomerId.ToString() },
                    Emphasised = true
                },
                new PageLink
                {
                    Label = Model.Contract.Project.Title,
                    Page = "/Projects/Workspace",
                    RouteValues = new Dictionary<string, string?>
                    {
                        ["id"] = Model.ProjectId.ToString(),
                        ["tab"] = "contracts"
                    }
                }
            ],

        Actions =
        [
            new PageAction
            {
                Label = "Positions",
                Icon = "ri-list-check-2",
                Page = "/Contracts/Positions",
                RouteValues = new Dictionary<string, string?> { ["contractId"] = Model.ContractId.ToString() }
            },
            new PageAction
            {
                Label = "Edit",
                Icon = "ri-edit-line",
                Page = "/Contracts/Edit",
                RouteValues = new Dictionary<string, string?> { ["id"] = Model.ContractId.ToString() }
            },
            new PageAction
            {
                Label = T["contractPage_Print"].Value,
                Icon = "ri-printer-line",
                Style = PageActionStyle.Primary,
                Id = "btnPrint"
            }
        ]
    };
}

<partial name="_PageHeader" model="header" />

@if (Model.IsPreview)
{
    @* Says whose wording is on the paper below. A preview that looked identical
       to the approved contract would be worse than no preview at all. *@
    <div class="alert alert-info radius-8 d-flex flex-wrap align-items-center gap-3" role="status">
        <span>
            <i class="ri-eye-line me-1"></i>
            <strong>Preview of version @Model.Version</strong> — @Model.PreviewStatusLabel.
            @(Model.PreviewCanApprove
                ? "This is not the approved wording until you approve it."
                : "")
        </span>
        <span class="ms-auto d-inline-flex gap-2">
            @if (Model.PreviewCanApprove)
            {
                <a class="btn btn-sm btn-primary radius-8"
                   asp-page="/Contracts/Positions"
                   asp-route-contractId="@Model.ContractId"
                   asp-fragment="version-@Model.Version">
                    Approve on the builder
                </a>
            }
            <a class="btn btn-sm btn-outline-primary radius-8"
               asp-page="/Contracts/Details" asp-route-id="@Model.ContractId">
                Show the approved wording
            </a>
        </span>
    </div>
}

<div class="contractPage">

    <div class="contractPage__container">
        <div class="contractPage__paper" id="paper">
            @if (!Model.IsPreview && string.IsNullOrEmpty(Model.ContractHtml))
            {
                @* Wording exists as versions and none is approved — or there is
                   none at all. The old single not-generated message was the
                   wrong diagnosis for the first case and a dead end for both. *@
                @if (Model.Versions.Count > 0)
                {
                    <div class="alert alert-info radius-8">
                        No version has been approved yet, so there is no active contract wording.
                        Read a version below, then approve the one that is right.
                    </div>

                    <ul class="list-group list-group-flush">
                        @foreach (var v in Model.Versions)
                        {
                            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
                                <span>
                                    <strong>Version @v.Version</strong>
                                    <span class="badge bg-neutral-200 text-neutral-600 px-12 py-2 radius-4 ms-2">@v.KindLabel</span>
                                    <span class="text-secondary-light text-sm ms-2">@Format.DateTime(v.GeneratedAt)</span>
                                </span>
                                <a class="btn btn-sm btn-outline-primary radius-8"
                                   asp-page="/Contracts/Details"
                                   asp-route-id="@Model.ContractId"
                                   asp-route-version="@v.Version">
                                    <i class="ri-eye-line"></i> Preview
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-info radius-8">
                        This contract has no wording yet. Generate it from the positions, or paste a
                        document you already have —
                        <a asp-page="/Contracts/Positions" asp-route-contractId="@Model.ContractId">both live on the builder</a>.
                    </div>
                }
            }
            else
            {
                @* The company's mark and the document's reference at the head of
                   the sheet. Outside the stored document on purpose: the contract
                   text carries the Vertragsnummer because that is part of the
                   contract, while the logo is the paper it is printed on. *@
                <partial name="_ContractLetterhead" model="Model.Letterhead" />

                <div class="contractPage__contractHtml">
                    @Html.Raw(Model.ContractHtml)
                </div>
            }
        </div>
    </div>

    <div class="contractPage__toast" id="toast"></div>
</div>

@section Scripts {
    @* Draws where the page breaks fall and counts the sheets. It measures; it
       does not scale, clip or resize anything — a contract is as long as it is. *@
    <script src="~/js/pages/contracts/contract-pages.js" asp-append-version="true"></script>

    <script>
        (function () {
            document.getElementById('btnPrint')?.addEventListener('click', function () {
                window.print();
            });
        })();
    </script>
}




