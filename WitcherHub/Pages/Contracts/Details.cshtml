@page "{id:guid?}"
@using Microsoft.Extensions.Localization
@using WitcherHub.Resources
@model WitcherHub.Pages.Contracts.DetailsModel
@inject IStringLocalizer<SharedResource> T

@{
    ViewData["Title"] = T["contractPage_Title"];
    Layout = "_ContractsLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contracts/contract-sign.css" asp-append-version="true" />
    <style>
        /* ===== Topbar (Back right, other actions left) ===== */
        .contractTopbar {
            position: sticky;
            top: 12px;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 12px;
            margin-bottom: 12px;
            border-radius: 14px;
            background: rgba(255,255,255,.88);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0,0,0,.06);
        }

        .contractTopbar__leftActions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-start; /* أقصى اليسار */
        }

        .contractTopbar__rightActions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end; /* أقصى اليمين */
        }

        .contractTopbar__badge {
            font-size: 12px;
            font-weight: 700;
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid rgba(0,0,0,.08);
            background: rgba(0,0,0,.03);
        }
    </style>
}

<div class="contractPage">

    <div class="contractTopbar">
        <!-- ✅ Left side: badge + print -->
        <div class="contractTopbar__leftActions">
            <button class="btn btn-outline-secondary btn-sm" type="button" id="btnPrint">
                @T["contractPage_Print"]
            </button>
            <span class="contractTopbar__badge" id="signedBadge">
                @(Model.IsSigned? T["contractPage_Signed"] : T["contractPage_Unsigned"])
            </span>

            
        </div>

        <!-- ✅ Right side: Back (arrow reversed) -->
        <div class="contractTopbar__rightActions">
            <a class="btn btn-outline-secondary btn-sm"
               href="/Projects?openProjectId=@Model.ProjectId&tab=contracts">
                Back →
            </a>
        </div>
    </div>

    <div class="contractPage__container">
        <div class="contractPage__paper" id="paper">
            <div class="contractPage__contractHtml">
                @Html.Raw(Model.ContractHtml)
            </div>
        </div>
    </div>

    <div class="contractPage__toast" id="toast"></div>
</div>

@section Scripts {
    <script src="~/js/navigation/forced-back.js" asp-append-version="true"></script>

    <script>
        (function () {
            const backUrl = '@Url.Page("/Projects", new { openProjectId = Model.ProjectId, tab = "contracts" })';

            window.forcedBackNavigation.bind(
                backUrl,
                "__contractDetailsBackRedirect"
            );

            document.getElementById('btnPrint')?.addEventListener('click', function () {
                window.print();
            });
        })();
    </script>
}




