@page
@model WitcherHub.Pages.Contracts.DetailsModel

@{
    ViewData["Title"] = "Contract Details";
}

@if (Model.Contract is null)
{
    <div class="alert alert-danger">Contract not found.</div>
    return;
}

@{
    var items = (Model.Contract.Items ?? new List<WitcherHub.Application.Models.View.Contracts.ContractViews.ContractItemItemView>())
        .OrderBy(x => x.Position)
        .ToList();

    decimal total = 0m;
    foreach (var it in items)
        total += it.AgreedPrice ?? 0m;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <div class="text-muted small">Contract</div>
        <h3 class="mb-1">@Model.Contract.ContractNo</h3>
        <div class="text-muted small">
            Status: <strong>@Model.Contract.Status</strong> | Currency: <strong>@Model.Contract.Currency</strong>
        </div>

        <div class="text-muted small mt-1">
            Created: <strong>@Model.Contract.CreatedAt.ToString("yyyy-MM-dd")</strong>
            @if (Model.Contract.StartDate is not null)
            {
                <span> | Start: <strong>@Model.Contract.StartDate.Value.ToString("yyyy-MM-dd")</strong></span>
            }
            @if (Model.Contract.EndDate is not null)
            {
                <span> | End: <strong>@Model.Contract.EndDate.Value.ToString("yyyy-MM-dd")</strong></span>
            }
            @if (Model.Contract.SignedAt is not null)
            {
                <span> | Signed: <strong>@Model.Contract.SignedAt.Value.ToString("yyyy-MM-dd")</strong></span>
            }
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-page="/Contracts/Edit" asp-route-id="@Model.Contract.Id">Back to edit</a>
        <a class="btn btn-outline-secondary"
           asp-page="/Projects"
           asp-route-openProjectId="@Model.Contract.ProjectId"
           asp-route-tab="overview">Project</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="text-muted small">Notes / Terms</div>
                <div>@(string.IsNullOrWhiteSpace(Model.Contract.Terms) ? "—" : Model.Contract.Terms)</div>
            </div>
            <div class="col-12 col-md-6 text-md-end">
                <div class="text-muted small">Total</div>
                <div class="fs-3 fw-bold">@total.ToString("0.00")</div>
            </div>
        </div>

        <hr />

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width:70px;">#</th>
                        <th>Item</th>
                        <th class="text-end" style="width:90px;">Qty</th>
                        <th class="text-end" style="width:120px;">Unit</th>
                        <th class="text-end" style="width:160px;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-muted">No items.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var it in items)
                        {
                            var qty = 1m;
                            var unit = it.AgreedPrice ?? 0m;
                            var lineTotal = unit * qty;

                            <tr>
                                <td class="text-muted">@it.Position</td>
                                <td>
                                    @it.Title
                                    @if (!string.IsNullOrWhiteSpace(it.ServiceName))
                                    {
                                        <div class="text-muted small">@it.ServiceName</div>
                                    }
                                </td>
                                <td class="text-end">@qty.ToString("0.##")</td>
                                <td class="text-end">@unit.ToString("0.00")</td>
                                <td class="text-end fw-semibold">@lineTotal.ToString("0.00")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
