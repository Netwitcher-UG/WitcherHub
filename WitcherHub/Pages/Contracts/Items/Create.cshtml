@page
@model WitcherHub.Pages.Contracts.Items.CreateModel
@using static WitcherHub.Infrastructure.Data.Models.Enums

@{
    ViewData["Title"] = "Add Contract Position";
}

@if (Model.Contract is null)
{
    <div class="alert alert-danger">Contract not found.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Add Position</h3>
        <div class="text-muted small">
            Contract: <strong>@Model.Contract.ContractNo</strong> |
            Status: <strong>@Model.Contract.Status</strong> |
            Currency: <strong>@Model.Contract.Currency</strong>
        </div>
    </div>

    <a class="btn btn-outline-secondary"
       asp-page="/Contracts/Details"
       asp-route-id="@Model.Contract.Id">Back</a>
</div>

@if (Model.Contract.Status != DocumentStatus.Draft)
{
    <div class="alert alert-warning">
        This contract is not in Draft status. Items are locked.
    </div>
    return;
}

<form method="post" class="card">
    <div class="card-body">
        <input type="hidden" asp-for="ContractId" />
        <input type="hidden" asp-for="Form.ContractId" />

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Service</label>

                <div class="dropdown">
                    <input type="text"
                           class="form-control dropdown-toggle"
                           id="serviceCombo"
                           data-bs-toggle="dropdown"
                           aria-expanded="false"
                           autocomplete="off"
                           placeholder="Search & select service..." />

                    <ul class="dropdown-menu w-100" id="serviceMenu" aria-labelledby="serviceCombo"></ul>
                </div>

                <!-- hidden select for model binding -->
                <select asp-for="SelectedServiceId"
                        asp-items="Model.ServiceOptions"
                        id="serviceSelect"
                        class="form-select"
                        style="position:absolute; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden;">
                    <option value="">-- choose --</option>
                </select>

                <span class="text-danger small" asp-validation-for="SelectedServiceId"></span>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label">Agreed Price</label>
                <input class="form-control" asp-for="Form.Item.AgreedPrice" />
                <span class="text-danger small" asp-validation-for="Form.Item.AgreedPrice"></span>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label">Position</label>
                <input class="form-control" asp-for="Form.Item.Position" />
                <span class="text-danger small" asp-validation-for="Form.Item.Position"></span>
            </div>

            <div class="col-12">
                <label class="form-label">Config (JSON)</label>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-sm btn-outline-secondary" type="button" onclick="formatJson('cfg-json')">Format</button>
                </div>
                <textarea class="form-control mt-2" rows="7" asp-for="ConfigJson" id="cfg-json"></textarea>
                <div class="form-text">Example: {"hours": 12, "rush": true}</div>
                <span class="text-danger small" asp-validation-for="ConfigJson"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" type="submit">Add Item</button>
            <a class="btn btn-outline-secondary"
               asp-page="/Contracts/Edit"
               asp-route-id="@Model.Contract.Id">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
                
        (function () {

            const combo = document.getElementById('serviceCombo');
            const menu = document.getElementById('serviceMenu');
            const select = document.getElementById('serviceSelect');

            if (!combo || !menu || !select) return;

            const options = Array.from(select.options)
                .filter(o => o.value);

            function render(filter) {
                menu.innerHTML = '';

                const q = (filter || '').toLowerCase();

                const filtered = options.filter(o =>
                    !q || o.text.toLowerCase().includes(q)
                );

                if (filtered.length === 0) {
                    const li = document.createElement('li');
                    li.innerHTML = `<span class="dropdown-item text-muted">No results</span>`;
                    menu.appendChild(li);
                    return;
                }

                filtered.forEach(o => {
                    const li = document.createElement('li');
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'dropdown-item';
                    btn.textContent = o.text;

                    btn.addEventListener('click', function () {
                        combo.value = o.text;
                        select.value = o.value;
                    });

                    li.appendChild(btn);
                    menu.appendChild(li);
                });
            }

            combo.addEventListener('input', function () {
                render(this.value);
            });

            combo.addEventListener('focus', function () {
                render(this.value);
            });

            // preselect first item if exists
            if (select.value) {
                const selected = options.find(o => o.value === select.value);
                if (selected) combo.value = selected.text;
            }

        })();
    

        function formatJson(textareaId) {
            const el = document.getElementById(textareaId);
            if (!el) return;

            try {
                const obj = JSON.parse(el.value || "{}");
                el.value = JSON.stringify(obj, null, 2);
            } catch {
                alert("Invalid JSON. Please fix it first.");
            }
        }
        window.formatJson = formatJson;
    </script>
}
