@page
@using System.Text
@using System.Text.Json
@using static WitcherHub.Infrastructure.Data.Models.Enums
@model WitcherHub.Pages.Contracts.Items.ManageModel

@{
    ViewData["Title"] = "Contract Positions";
}

@if (Model.Contract is null)
{
    <div class="alert alert-danger">Contract not found.</div>
    return;
}

@functions {
    decimal ReadDec(JsonDocument? doc, string prop, decimal fallback = 0m)
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d)) return d;
            if (v.ValueKind == JsonValueKind.String && decimal.TryParse(v.GetString(), out var ds)) return ds;
            return fallback;
        }
        catch { return fallback; }
    }

    decimal ReadNestedDec(JsonDocument? doc, string parent, string prop, decimal fallback = 0m)
    {
        try
        {
            if (doc is null) return fallback;
            var root = doc.RootElement;
            if (!root.TryGetProperty(parent, out var p)) return fallback;
            if (p.ValueKind != JsonValueKind.Object) return fallback;
            if (!p.TryGetProperty(prop, out var v)) return fallback;
            if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var d)) return d;
            if (v.ValueKind == JsonValueKind.String && decimal.TryParse(v.GetString(), out var ds)) return ds;
            return fallback;
        }
        catch { return fallback; }
    }

    string ToB64(string s)
        => Convert.ToBase64String(Encoding.UTF8.GetBytes(s ?? "{}"));
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="mb-1">Contract Positions</h3>
        <div class="text-muted small">
            Contract: <strong>@Model.Contract.ContractNo</strong> |
            Status: <strong>@Model.Contract.Status</strong> |
            Currency: <strong>@Model.Contract.Currency</strong>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary"
           href="/Projects?openProjectId=@Model.Contract.ProjectId&tab=contracts">
            Back to Project
        </a>
        @if (Model.HasSavedOverrideDraft)
        {
            <a class="btn btn-outline-info"
               asp-page="/Contracts/Override"
               asp-route-id="@Model.ContractId">
                Open Override
            </a>
        }
        <!-- ✅ نفس Quotes: From Services -->
        <a class="btn btn-outline-primary @(Model.IsLocked ? "disabled" : "")"
           asp-page="/Contracts/Items/Create"
           asp-route-contractId="@Model.ContractId"
           aria-disabled="@(Model.IsLocked)">
            From Services
        </a>

        <form method="post" asp-page-handler="GenerateContract" class="d-inline"
              onsubmit="window.UI?.loading?.show?.('Generating contract...');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ContractId" value="@Model.ContractId" />
            <button class="btn btn-primary d-inline-flex align-items-center gap-2"
                    type="submit"
                    @(Model.IsLocked || (Model.Contract.Items?.Count ?? 0) == 0 ? "disabled" : "")>
                <span>Generate Contract</span>
                <i class="material-icons-outlined" style="font-size:22px;">auto_awesome</i>
            </button>
        </form>
    </div>
</div>

@if (Model.IsLocked)
{
    <div class="alert alert-warning">
        This contract is locked (signed or not editable). You can view items, but you cannot edit/delete.
    </div>
}

@{
    var items = (Model.Contract.Items ?? new List<WitcherHub.Application.Models.View.Contracts.ContractViews.ContractItemItemView>())
        .OrderBy(x => x.Position).ThenBy(x => x.Id).ToList();
}
@{
    var disabledAttr = Model.IsLocked ? "disabled" : null;
}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="fw-semibold">Header</div>
        <button class="btn btn-sm btn-outline-secondary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#contractHeaderCollapse">
            Toggle
        </button>
    </div>

    <div class="collapse show" id="contractHeaderCollapse">
        <div class="card-body">
            <form method="post" asp-page-handler="SaveHeader" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ContractId" value="@Model.ContractId" />

                <div class="col-12 col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" asp-for="HeaderStatus"
                            asp-items="Html.GetEnumSelectList<DocumentStatus>()"
                            disabled="@disabledAttr">
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label js-pointer-label">Start Date</label>
                    <input class="form-control js-themed-date js-datepicker js-pointer-date"
                           type="date"
                           asp-for="HeaderStartDate"
                           disabled="@disabledAttr" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label js-pointer-label">End Date</label>
                    <input class="form-control js-themed-date js-datepicker js-pointer-date"
                           type="date"
                           asp-for="HeaderEndDate"
                           disabled="@disabledAttr" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Send the Invoice</label>
                    <select class="form-select" asp-for="HeaderInvoiceSendMode" disabled="@disabledAttr">
                        <option value="0">Automatic</option>
                        <option value="1">Manual</option>
                    </select>
                </div>

                <textarea class="form-control" rows="4" asp-for="HeaderTerms" disabled="@disabledAttr"></textarea>

                <div class="col-12 d-flex justify-content-end">
                    <button class="btn btn-primary" type="submit" disabled="@disabledAttr">
                        Save header
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <div class="fw-semibold">Positions</div>
            <div class="text-muted small">Quick edit totals, and open advanced edit only when needed.</div>
        </div>

        <div class="text-muted small">Items: <strong>@items.Count</strong></div>
    </div>

    <div class="card-body">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-8">
                <label class="form-label mb-1">Search items</label>
                <input class="form-control" id="itemSearch" placeholder="Type to filter by title..." />
            </div>
        </div>

        @if (items.Count == 0)
        {
            <div class="alert alert-light border mb-0">
                No Positions yet. Click <strong>From Services</strong> to create the first one.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="itemsTable">
                    <thead>
                        <tr>
                            <th style="width:70px;">#</th>
                            <th>Item</th>
                            <th class="text-end" style="width:90px;">Qty</th>
                            <th class="text-end" style="width:120px;">Unit</th>
                            <th class="text-end" style="width:180px;">Total</th>
                            <th class="text-end" style="width:90px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in items)
                        {
                            var cfg = it.Config?.RootElement.GetRawText() ?? "{}";
                            var cfgB64 = ToB64(cfg);

                            var total = ReadDec(it.PriceBreakdown, "total", it.AgreedPrice ?? 0m);
                            var subTotal = ReadDec(it.PriceBreakdown, "subTotal", total);
                            var discountAmt = ReadNestedDec(it.PriceBreakdown, "discount", "amount", 0m);

                            var discTypeStr = it.DiscountType?.ToString() ?? "";
                            var discValStr = it.DiscountValue?.ToString() ?? "";

                            <tr data-title="@(it.Title?.ToLowerInvariant() ?? "")">
                                <td class="text-muted">@it.Position</td>

                                <td>
                                    <div class="fw-semibold">@it.Title</div>

                                    @if (!string.IsNullOrWhiteSpace(it.Description))
                                    {
                                        <div class="text-muted small">@it.Description</div>
                                    }

                                    <div class="text-muted small">
                                        @(it.ServiceName ?? "—")
                                        @if (!string.IsNullOrWhiteSpace(it.UnitName))
                                        {
                                            <text>&nbsp;•&nbsp; Unit: <strong>@it.UnitName</strong></text>
                                        }
                                        &nbsp;•&nbsp; Sub: <strong>@subTotal.ToString("0.00")</strong>
                                        &nbsp;•&nbsp; Disc: <strong>@discountAmt.ToString("0.00")</strong>
                                    </div>
                                </td>

                                <td class="text-end">@it.Quantity.ToString("0.##")</td>
                                <td class="text-end">@it.UnitPrice.ToString("0.00")</td>
                                <td class="text-end fw-semibold">@total.ToString("0.00")</td>

                                <td class="text-end">
                                    @if (!Model.IsLocked)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1 justify-content-end">
                                            <button type="button"
                                                    class="btn vc-icon-btn text-primary"
                                                    title="Edit"
                                                    aria-label="Edit"
                                                    data-bs-toggle="offcanvas"
                                                    data-bs-target="#EditItemCanvas"
                                                    data-item-id="@it.Id"
                                                    data-item-serviceid="@(it.ServiceId?.ToString() ?? "")"
                                                    data-item-servicename="@(it.ServiceName ?? "")"
                                                    data-item-title="@it.Title"
                                                    data-item-qty="@it.Quantity"
                                                    data-item-unit="@it.UnitPrice"
                                                    data-item-pos="@it.Position"
                                                    data-item-description="@it.Description"
                                                    data-item-unitname="@it.UnitName"
                                                    data-item-billingcycle="@((int)it.BillingCycle)"
                                                    data-item-disctype="@discTypeStr"
                                                    data-item-discval="@discValStr"
                                                    data-item-config-b64="@cfgB64">
                                                <i class="material-icons-outlined">edit</i>
                                            </button>

                                            <form method="post" asp-page-handler="DeleteItem" class="d-inline js-delete-form mb-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ContractId" value="@Model.ContractId" />
                                                <input type="hidden" name="ItemId" value="@it.Id" />
                                                <button class="btn vc-icon-btn text-danger js-delete-open"
                                                        type="button"
                                                        title="Delete"
                                                        aria-label="Delete"
                                                        data-delete-title="Delete item"
                                                        data-delete-message="Are you sure you want to delete this item?">
                                                    <i class="material-icons-outlined">delete</i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Locked</span>
                                    }
                                </td>
                            
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- OFFCANVAS: EDIT ITEM (✅ same as Quotes) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="EditItemCanvas" aria-labelledby="EditItemCanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="EditItemCanvasLabel">Edit item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <form method="post" asp-page-handler="UpdateItem" id="editItemForm">
            @Html.AntiForgeryToken()

            <input type="hidden" name="ContractId" value="@Model.ContractId" />
            <input type="hidden" name="EditItemId" id="ci-id" />
            <input type="hidden" name="EditServiceId" id="ci-svc" />
            <div class="mb-3">
                <label class="form-label">Service</label>
                <input class="form-control" id="ci-svc-name" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" name="EditTitle" id="ci-title" />
            </div>
            <div class="mb-3">
                <label class="form-label">Unit Name</label>
                <input class="form-control" name="EditUnitName" id="ci-unitname" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" name="EditDescription" id="ci-description" rows="3"></textarea>
            </div>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label">Qty</label>
                    <input class="form-control" name="EditQuantity" id="ci-qty" />
                </div>

                <div class="col-4">
                    <label class="form-label">Unit</label>
                    <input class="form-control" name="EditUnitPrice" id="ci-unit" />
                </div>

                <div class="col-4">
                    <label class="form-label">Pos</label>
                    <input class="form-control" name="EditPosition" id="ci-pos" />
                </div>

                <div class="mt-2">
                    <label class="form-label">BillingCycle</label>
                    <select class="form-select" name="EditBillingCycle" id="ci-billing">
                        @foreach (var opt in Html.GetEnumSelectList<BillingCycle>())
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div class="accordion mt-3" id="editItemAdvanced">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="editItemAdvancedHeading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#editItemAdvancedBody">
                            Advanced (discounts / config)
                        </button>
                    </h2>

                    <div id="editItemAdvancedBody" class="accordion-collapse collapse" data-bs-parent="#editItemAdvanced">
                        <div class="accordion-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Discount Type</label>
                                    <select class="form-select" name="EditDiscountType" id="ci-disctype">
                                        <option value="">-- none --</option>
                                        <option value="Percent">Percent</option>
                                        <option value="Amount">Amount</option>
                                        <option value="Fixed">Fixed</option>
                                    </select>
                                </div>

                                <div class="col-6">
                                    <label class="form-label">Discount Value</label>
                                    <input class="form-control" name="EditDiscountValue" id="ci-discval" />
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="card border bg-transparent">
                                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="fw-semibold">Config</div>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="ci-cfg-reset-btn">
                                                Reset
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#ciCfgRawCollapse"
                                                    aria-expanded="false">
                                                Raw JSON
                                            </button>
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <div id="ci-cfg-loading" class="text-muted small d-none">Loading config schema…</div>

                                        <div id="ci-cfg-empty" class="text-muted small d-none">
                                            This service has no config schema. You can still use Raw JSON if needed.
                                        </div>

                                        <div id="ci-cfg-fields" class="row g-3"></div>

                                        <div class="collapse mt-3" id="ciCfgRawCollapse">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="form-label mb-0">Config (JSON)</label>
                                                <button class="btn btn-sm btn-outline-secondary" type="button" id="ci-cfg-format-btn">Format</button>
                                            </div>

                                            <textarea class="form-control mt-2 font-monospace" rows="6" name="EditConfigJson" id="ci-config"></textarea>
                                            <div class="form-text">You normally don’t need to edit this manually.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-info mt-3 mb-0">
                                PriceBreakdown will be recalculated automatically when you save.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ✅ Price preview -->
            <hr class="my-3" />
            <div class="card bg-transparent border">
                <div class="card-header fw-semibold">Price preview</div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <div class="text-muted">Subtotal</div>
                        <div class="fw-semibold" id="ci-prev-sub">0.00</div>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <div class="text-muted">Discount</div>
                        <div class="fw-semibold" id="ci-prev-disc">-0.00</div>
                    </div>

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted">Total</div>
                        <div class="fs-4 fw-bold" id="ci-prev-total">0.00</div>
                    </div>

                    <div class="text-muted small mt-2">
                        *Preview is client-side. Final pricing is recalculated on Save.
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-primary" type="submit" @(Model.IsLocked ? "disabled" : "")>Save changes</button>
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="offcanvas">Cancel</button>
            </div>
        </form>
    </div>
</div>
<div class="modal fade quote-confirm-modal" id="DeleteConfirmModal" tabindex="-1" aria-labelledby="DeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteConfirmModalLabel">Delete item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="DeleteConfirmModalMessage">Are you sure?</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="DeleteConfirmModalSubmit">Delete</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        

        // Filter items table
        (function () {
            const search = document.getElementById('itemSearch');
            if (!search) return;

            function applyFilter() {
                const q = (search.value || '').trim().toLowerCase();
                document.querySelectorAll('#itemsTable tbody tr').forEach(tr => {
                    const title = (tr.getAttribute('data-title') || '');
                    tr.style.display = (!q || title.includes(q)) ? '' : 'none';
                });
            }
            search.addEventListener('input', applyFilter);
        })();

        function ciComputePreview() {
            const qty = parseFloat(document.getElementById('ci-qty')?.value || '0') || 0;
            const unit = parseFloat(document.getElementById('ci-unit')?.value || '0') || 0;

            const sub = qty * unit;

            const discType = (document.getElementById('ci-disctype')?.value || '').trim();
            const discVal = parseFloat(document.getElementById('ci-discval')?.value || '0') || 0;

            let discAmt = 0;
            if (discType === 'Percent') discAmt = sub * (discVal / 100.0);
            else if (discType === 'Amount') discAmt = discVal;
            else if (discType === 'Fixed') discAmt = discVal;

            if (discAmt > sub) discAmt = sub;
            if (discAmt < 0) discAmt = 0;

            const total = Math.max(0, sub - discAmt);

            const f = (n) => (Math.round((n + Number.EPSILON) * 100) / 100).toFixed(2);

            document.getElementById('ci-prev-sub').textContent = f(sub);
            document.getElementById('ci-prev-disc').textContent = '-' + f(discAmt);
            document.getElementById('ci-prev-total').textContent = f(total);
        }

        // Populate edit offcanvas
                function ciTryParseJson(raw) {
            try { return JSON.parse(raw || "{}"); } catch { return {}; }
        }

        function ciStringifyJson(obj, pretty) {
            return JSON.stringify(obj ?? {}, null, pretty ? 2 : 0);
        }

        let ciSchema = null;
        let ciCfg = {};

        function ciSyncJson(pretty) {
            const el = document.getElementById('ci-config');
            if (!el) return;
            el.value = ciStringifyJson(ciCfg, pretty);
        }

        function ciNormalizeCfgBySchema() {
            if (!ciSchema || ciSchema.type !== 'object' || !ciSchema.properties) return;

            if (ciSchema.additionalProperties === false) {
                const allowed = new Set(Object.keys(ciSchema.properties));
                Object.keys(ciCfg).forEach(k => {
                    if (!allowed.has(k)) delete ciCfg[k];
                });
            }

            Object.entries(ciSchema.properties).forEach(([key, def]) => {
                if (ciCfg[key] === undefined && def && typeof def === 'object' && def.default !== undefined) {
                    ciCfg[key] = def.default;
                }
            });
        }

        function ciIsRequired(key) {
            return !!(ciSchema && Array.isArray(ciSchema.required) &&
                ciSchema.required.some(x => (x || '').toLowerCase() === key.toLowerCase()));
        }

        function ciFieldId(key) {
            return `ci_cfg_${key}`;
        }

        function ciSetControlValue(def, control, val) {
            const hasEnum = Array.isArray(def.enum);
            const t = (def.type || (hasEnum ? 'string' : 'string'));

            if (t === 'boolean') {
                control.checked = !!val;
                return;
            }

            if (val === undefined || val === null) {
                control.value = '';
                return;
            }

            control.value = String(val);
        }

        function ciWriteValueFromControl(key, def, control) {
            const hasEnum = Array.isArray(def.enum);
            const t = (def.type || (hasEnum ? 'string' : 'string'));

            if (t === 'boolean') {
                ciCfg[key] = !!control.checked;
                ciSyncJson(false);
                return;
            }

            if (control.value === '' || control.value === null || control.value === undefined) {
                delete ciCfg[key];
                ciSyncJson(false);
                return;
            }

            if (hasEnum) {
                ciCfg[key] = control.value;
                ciSyncJson(false);
                return;
            }

            if (t === 'integer') {
                const n = Number(control.value);
                if (!Number.isFinite(n)) delete ciCfg[key];
                else ciCfg[key] = Math.trunc(n);

                ciSyncJson(false);
                return;
            }

            if (t === 'number') {
                const n = Number(control.value);
                if (!Number.isFinite(n)) delete ciCfg[key];
                else ciCfg[key] = n;

                ciSyncJson(false);
                return;
            }

            ciCfg[key] = control.value;
            ciSyncJson(false);
        }

        function ciRenderField(key, def) {
            const col = document.createElement('div');
            col.className = 'col-12 col-md-6';

            const title = def.title || def.label || key;
            const desc = def.description || '';
            const required = ciIsRequired(key);

            const wrapper = document.createElement('div');

            const label = document.createElement('label');
            label.className = 'form-label';
            label.setAttribute('for', ciFieldId(key));
            label.innerHTML = `${title}${required ? ' <span class="text-danger">*</span>' : ''}`;
            wrapper.appendChild(label);

            const hasEnum = Array.isArray(def.enum);
            const t = (def.type || (hasEnum ? 'string' : 'string'));

            let control;

            if (t === 'boolean') {
                const div = document.createElement('div');
                div.className = 'form-check form-switch';

                control = document.createElement('input');
                control.type = 'checkbox';
                control.className = 'form-check-input';
                control.id = ciFieldId(key);

                const lab2 = document.createElement('label');
                lab2.className = 'form-check-label';
                lab2.setAttribute('for', ciFieldId(key));
                lab2.textContent = title;

                div.appendChild(control);
                div.appendChild(lab2);
                wrapper.appendChild(div);
            }
            else if (hasEnum) {
                control = document.createElement('select');
                control.className = 'form-select';
                control.id = ciFieldId(key);

                const empty = document.createElement('option');
                empty.value = '';
                empty.textContent = '-- select --';
                control.appendChild(empty);

                def.enum.forEach(v => {
                    const opt = document.createElement('option');
                    opt.value = String(v);
                    opt.textContent = String(v);
                    control.appendChild(opt);
                });

                wrapper.appendChild(control);
            }
            else if (t === 'integer' || t === 'number') {
                control = document.createElement('input');
                control.type = 'number';
                control.className = 'form-control';
                control.id = ciFieldId(key);

                if (t === 'integer') control.step = '1';
                if (typeof def.minimum === 'number') control.min = String(def.minimum);
                if (typeof def.maximum === 'number') control.max = String(def.maximum);

                wrapper.appendChild(control);
            }
            else {
                control = document.createElement('input');
                control.type = 'text';
                control.className = 'form-control';
                control.id = ciFieldId(key);
                wrapper.appendChild(control);
            }

            if (desc) {
                const help = document.createElement('div');
                help.className = 'form-text';
                help.textContent = desc;
                wrapper.appendChild(help);
            }

            control.addEventListener('input', () => ciWriteValueFromControl(key, def, control));
            control.addEventListener('change', () => ciWriteValueFromControl(key, def, control));

            ciSetControlValue(def, control, ciCfg[key]);
            col.appendChild(wrapper);
            return col;
        }

        function ciRenderConfigFields() {
            const fields = document.getElementById('ci-cfg-fields');
            const empty = document.getElementById('ci-cfg-empty');
            if (!fields || !empty) return;

            fields.innerHTML = '';

            if (!ciSchema || ciSchema.type !== 'object' || !ciSchema.properties || typeof ciSchema.properties !== 'object') {
                empty.classList.remove('d-none');
                ciSyncJson(false);
                return;
            }

            empty.classList.add('d-none');

            Object.entries(ciSchema.properties).forEach(([key, def]) => {
                if (!def || typeof def !== 'object') return;
                fields.appendChild(ciRenderField(key, def));
            });

            ciSyncJson(false);
        }

        async function ciLoadSchemaAndRender(serviceId, rawJson) {
            const loading = document.getElementById('ci-cfg-loading');
            const fields = document.getElementById('ci-cfg-fields');
            const empty = document.getElementById('ci-cfg-empty');

            ciSchema = null;
            ciCfg = ciTryParseJson(rawJson);

            if (fields) fields.innerHTML = '';
            if (empty) empty.classList.add('d-none');

            if (!serviceId) {
                ciSyncJson(false);
                return;
            }

            if (loading) loading.classList.remove('d-none');

            try {
                const url = `?handler=ServiceSchema&serviceId=${encodeURIComponent(serviceId)}`;
                const res = await fetch(url, { headers: { 'Accept': 'application/json' } });

                if (!res.ok) {
                    ciSchema = null;
                    ciRenderConfigFields();
                    return;
                }

                const txt = (await res.text()).trim();
                ciSchema = txt ? ciTryParseJson(txt) : null;

                ciNormalizeCfgBySchema();
                ciRenderConfigFields();
            } finally {
                if (loading) loading.classList.add('d-none');
            }
        }

        document.getElementById('ci-cfg-reset-btn')?.addEventListener('click', function () {
            ciCfg = {};
            ciNormalizeCfgBySchema();
            ciRenderConfigFields();
        });

        document.getElementById('ci-cfg-format-btn')?.addEventListener('click', function () {
            const raw = document.getElementById('ci-config');
            if (!raw) return;

            try {
                ciCfg = JSON.parse(raw.value || "{}");
                ciNormalizeCfgBySchema();
                ciSyncJson(true);
                ciRenderConfigFields();
            } catch {
                alert("Invalid JSON. Please fix it first.");
            }
        });

        document.addEventListener('show.bs.offcanvas', async function (e) {
            const el = e.target;
            if (!el || el.id !== 'EditItemCanvas') return;

            const btn = e.relatedTarget;
            if (!btn) return;

            const serviceId = btn.getAttribute('data-item-serviceid') || '';
            const serviceName = btn.getAttribute('data-item-servicename') || '';

            document.getElementById('ci-id').value = btn.getAttribute('data-item-id') || '';
            document.getElementById('ci-svc').value = serviceId;
            document.getElementById('ci-svc-name').value = serviceName;
            document.getElementById('ci-title').value = btn.getAttribute('data-item-title') || '';
            document.getElementById('ci-qty').value = btn.getAttribute('data-item-qty') || '1';
            document.getElementById('ci-unit').value = btn.getAttribute('data-item-unit') || '0';
            document.getElementById('ci-pos').value = btn.getAttribute('data-item-pos') || '1';
            document.getElementById('ci-billing').value = btn.getAttribute('data-item-billingcycle') || '0';
            document.getElementById('ci-disctype').value = btn.getAttribute('data-item-disctype') || '';
            document.getElementById('ci-discval').value = btn.getAttribute('data-item-discval') || '';
                    document.getElementById('ci-unitname').value = btn.getAttribute('data-item-unitname') || '';
        document.getElementById('ci-description').value = btn.getAttribute('data-item-description') || '';
            const b64 = btn.getAttribute('data-item-config-b64');
            let cfgText = '{}';

            try {
                if (b64) {
                    const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
                    cfgText = new TextDecoder('utf-8').decode(bytes);
                }
            } catch {
                cfgText = '{}';
            }

            document.getElementById('ci-config').value = cfgText;

            await ciLoadSchemaAndRender(serviceId, cfgText);
            ciComputePreview();
        });


        (function () {
            const ids = ['ci-qty', 'ci-unit', 'ci-disctype', 'ci-discval'];
            ids.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('input', ciComputePreview);
                el.addEventListener('change', ciComputePreview);
            });
        })();

        

             (function () {
            const modalEl = document.getElementById('DeleteConfirmModal');
            const titleEl = document.getElementById('DeleteConfirmModalLabel');
            const messageEl = document.getElementById('DeleteConfirmModalMessage');
            const confirmBtn = document.getElementById('DeleteConfirmModalSubmit');

            if (!modalEl || !titleEl || !messageEl || !confirmBtn || !window.bootstrap) return;

            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            let pendingForm = null;

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.js-delete-open');
                if (!btn) return;

                pendingForm = btn.closest('form');
                if (!pendingForm) return;

                titleEl.textContent = btn.getAttribute('data-delete-title') || 'Confirm delete';
                messageEl.textContent = btn.getAttribute('data-delete-message') || 'Are you sure?';

                modal.show();
            });

            confirmBtn.addEventListener('click', function () {
                if (!pendingForm) return;

                const form = pendingForm;
                pendingForm = null;
                modal.hide();

                if (typeof form.requestSubmit === 'function') {
                    form.requestSubmit();
                } else {
                    form.submit();
                }
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                pendingForm = null;
            });
        })();
    </script>
}
