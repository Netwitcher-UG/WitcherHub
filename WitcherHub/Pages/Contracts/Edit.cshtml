@page
@using System.Text.Encodings.Web
@model WitcherHub.Pages.Contracts.EditModel

@{
    ViewData["Title"] = "Edit Contract";
    Layout = "_ContractsLayout";
}

@if (Model.Contract is null)
{
    <div class="alert alert-danger">Contract not found.</div>
    return;
}

@section Styles {
    <link rel="stylesheet" href="~/css/contracts/contract-sign.css" asp-append-version="true" />
    <style>
        .contractTopActions {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

            .contractTopActions .btns {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                align-items: center;
            }

        /* Inline editor inside the same paper area */
        .contractInlineEditor {
            white-space: pre-wrap;
            word-break: break-word;
            outline: none;
            min-height: 55vh;
            font-family: inherit;
            font-size: inherit;
            line-height: inherit;
        }

            .contractInlineEditor.is-editing {
                border: 1px dashed rgba(0,0,0,.20);
                border-radius: 10px;
                padding: 14px;
                background: rgba(255,255,255,.55);
            }
    </style>
}

<div class="contractTopActions">
    <div>
        <div class="text-muted small">Contract</div>
        <div style="font-weight:700; font-size:18px;">@Model.Contract.ContractNo</div>
        <div class="text-muted small">
            Status: <strong>@Model.Contract.Status</strong>
            | Currency: <strong>@Model.Contract.Currency</strong>
        </div>
    </div>

    <div class="btns">
        <a class="btn btn-outline-secondary"
           asp-page="/Projects"
           asp-route-openProjectId="@Model.Contract.ProjectId"
           asp-route-tab="overview">Back</a>

        <a class="btn btn-outline-secondary"
           asp-page="/Contracts/Details"
           asp-route-id="@Model.Contract.Id">Details / Preview</a>

        <button class="btn btn-outline-dark" type="button" id="btnPrint">Print</button>
    </div>
</div>

<div class="contractPage">
    <div class="contractPage__container">
        <div class="contractPage__paper" id="paper">

            <!-- VIEW MODE: formatted contract (same demo look) -->
            <div id="contractView" class="contractPage__contractHtml">
                @Html.Raw(Model.ContractHtml)
            </div>

            <!-- EDIT MODE: SAME PLACE, plain text only -->
            <pre id="contractEditor"
                 class="d-none contractInlineEditor"
                 contenteditable="true"
                 spellcheck="false">@Html.Raw(HtmlEncoder.Default.Encode(Model.RawTerms ?? ""))</pre>

            <!-- Actions -->
            <div class="contractActions">
                <div class="contractActions__right">
                    <div class="contractActions__badge">
                        @(Model.IsSigned ? "Signed" : "Unsigned")
                    </div>

                    @if (Model.Contract.Status != WitcherHub.Infrastructure.Data.Models.Enums.DocumentStatus.Draft)
                    {
                        <button class="contractActions__btn" type="button" disabled
                                title="Editing is locked because contract is not Draft.">
                            Edit text
                        </button>
                    }
                    else
                    {
                        <button class="contractActions__btn" type="button" id="btnEdit">Edit text</button>
                        <button class="contractActions__btn d-none" type="button" id="btnSave">Save</button>
                        <button class="contractActions__btn d-none" type="button" id="btnCancel">Cancel</button>
                    }
                </div>
            </div>

            <!-- Hidden Save Form -> uses your existing handler OnPostUpdateHeaderAsync -->
            <form id="saveForm" method="post" asp-page-handler="UpdateHeader" asp-route-id="@Model.Id" class="d-none">
                <input type="hidden" asp-for="Id" />

                <!-- required hidden fields (to satisfy validator) -->
                <input type="hidden" asp-for="Header.Contract.ProjectId" />
                <input type="hidden" asp-for="Header.Contract.Currency" />
                <input type="hidden" asp-for="Header.Contract.Status" />
                <input type="hidden" asp-for="Header.Contract.StartDate" />
                <input type="hidden" asp-for="Header.Contract.EndDate" />
                <input type="hidden" asp-for="Header.Contract.SignedAt" />

                <!-- will be filled from editor text on Save -->
                <input type="hidden" asp-for="Header.Contract.Terms" id="termsHidden" />
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const view = document.getElementById('contractView');
            const editor = document.getElementById('contractEditor');

            const btnEdit = document.getElementById('btnEdit');
            const btnSave = document.getElementById('btnSave');
            const btnCancel = document.getElementById('btnCancel');
            const btnPrint = document.getElementById('btnPrint');

            const saveForm = document.getElementById('saveForm');
            const termsHidden = document.getElementById('termsHidden');

            if (btnPrint) {
                btnPrint.addEventListener('click', () => window.print());
            }

            if (!btnEdit || !btnSave || !btnCancel || !editor || !view) return;

            const originalText = editor.textContent ?? "";

            function toEditMode() {
                view.classList.add('d-none');
                editor.classList.remove('d-none');
                editor.classList.add('is-editing');

                btnEdit.classList.add('d-none');
                btnSave.classList.remove('d-none');
                btnCancel.classList.remove('d-none');

                editor.focus();
                placeCaretAtEnd(editor);
            }

            function toViewMode(reset) {
                if (reset) editor.textContent = originalText;

                editor.classList.add('d-none');
                editor.classList.remove('is-editing');
                view.classList.remove('d-none');

                btnEdit.classList.remove('d-none');
                btnSave.classList.add('d-none');
                btnCancel.classList.add('d-none');
            }

            // Force paste as plain text (no formatting)
            editor.addEventListener('paste', (e) => {
                e.preventDefault();
                const text = (e.clipboardData || window.clipboardData).getData('text/plain');
                document.execCommand('insertText', false, text);
            });

            btnEdit.addEventListener('click', toEditMode);

            btnCancel.addEventListener('click', () => toViewMode(true));

            btnSave.addEventListener('click', () => {
                const text = (editor.textContent ?? "").replace(/\r\n/g, "\n");
                termsHidden.value = text;
                saveForm.submit();
            });

            function placeCaretAtEnd(el) {
                const range = document.createRange();
                range.selectNodeContents(el);
                range.collapse(false);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
            }
        })();
    </script>
}
