@page
@using System.Text.Encodings.Web
@using WitcherHub.Pages.Models.UI
@model WitcherHub.Pages.Contracts.EditModel

@{
    ViewData["Title"] = "Edit Contract";
    Layout = "_Layout";
}

@if (Model.Contract is null)
{
    <div class="alert alert-danger">Contract not found.</div>
    return;
}

@section Styles {
    <link rel="stylesheet" href="~/css/contracts/contract-sign.css" asp-append-version="true" />
}
<div class="contractPage wh-contract-editor-page">

    @*
        The contract's identity and where it stands.

        This was a contract number, a status pill and a currency, styled by a
        block of CSS local to this page. Which version was on screen, whether it
        had been approved, who the contract was with and what it was worth were
        all missing from the one page whose job is editing that contract — and
        the status pill was a third independent set of status colours.
    *@
    <div class="wh-section">
        <nav class="mb-8">
            <a asp-page="/Projects/Workspace" asp-route-id="@Model.Contract.ProjectId" asp-route-tab="contracts"
               class="text-secondary-light text-sm hover-text-primary d-inline-flex align-items-center gap-1">
                <i class="ri-arrow-left-line"></i> Back to the project
            </a>
        </nav>

        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <h4 class="mb-0 fw-semibold">@Model.Contract.ContractNo</h4>
                    <partial name="_StatusBadge" model="DocumentStatusPresentation.ForContract(Model.Contract.Status)" />

                    @if (Model.ApprovedVersion is { } approved)
                    {
                        <span class="badge bg-success-focus text-success-main border border-success-main px-16 py-4 radius-4">
                            Version @approved.Version approved
                        </span>
                    }
                    else if (Model.Drafts.Count > 0)
                    {
                        <span class="badge bg-warning-focus text-warning-main border border-warning-main px-16 py-4 radius-4">
                            @Model.Drafts.Count version(s), none approved
                        </span>
                    }
                </div>

                <p class="text-secondary-light mb-0 mt-8 text-sm">
                    <a asp-page="/Clients/Details" asp-route-id="@Model.Contract.CustomerId"
                       class="text-primary-600 fw-medium">@Model.Contract.CustomerName</a>

                    @if (Model.Contract.StartDate is not null || Model.Contract.EndDate is not null)
                    {
                        <text> · @Format.Date(Model.Contract.StartDate) — @Format.Date(Model.Contract.EndDate)</text>
                    }

                    @* The contract's value, or an honest statement that there
                       is not one. 0,00 € for a contract nobody has priced is a
                       claim the system cannot support. *@
                    <text> · </text>
                    @if (Model.Money?.AgreedTotalNet is { } total)
                    {
                        <strong>@Format.Money(total, Model.Money.Currency)</strong>
                    }
                    else if (Model.Contract.Items is { Count: > 0 })
                    {
                        <text>@Model.Contract.Items.Count position(s)</text>
                    }
                    else
                    {
                        <text>value not specified</text>
                    }
                </p>
            </div>

            @*
                One primary action and a live saving state, instead of a Save
                button and a Reset button that were both disabled until something
                changed and gave no sign of what had been written.
            *@
            <div class="wh-actions align-items-center">
                <span id="saveState" class="text-sm text-secondary-light" role="status" aria-live="polite">
                    All changes saved
                </span>

                @if (Model.Contract.Status == WitcherHub.Infrastructure.Data.Models.Enums.DocumentStatus.Draft)
                {
                    <button class="btn btn-primary text-sm px-20 py-11 radius-8" type="button" id="btnSave" disabled>
                        Save now
                    </button>
                    <button class="btn btn-outline-secondary text-sm px-16 py-11 radius-8" type="button" id="btnReset" disabled>
                        Discard changes
                    </button>
                }

                <a class="btn btn-outline-primary text-sm px-20 py-11 radius-8"
                   asp-page="/Contracts/Details" asp-route-id="@Model.Contract.Id">
                    Preview
                </a>
            </div>
        </div>
    </div>

    <div class="contractPage__container">
        <div class="contractPage__paper" id="paper">

            @*
                A contract with no wording yet.

                The editor showed an empty box and nothing else: no indication that
                the contract was empty rather than failing to load, and no route to
                the two places wording actually comes from. Both live on the
                contract builder — generating it from the positions, or pasting a
                document you already have — and neither is on this page.
            *@
            @if (string.IsNullOrWhiteSpace(Model.RawTermsEditable) &&
                 string.IsNullOrWhiteSpace(Model.ContractHtml))
            {
                <div class="alert alert-info radius-8 d-flex flex-wrap align-items-center justify-content-between gap-3 mb-16">
                    <div>
                        <div class="fw-semibold">This contract has no wording yet.</div>
                        <div class="text-sm">
                            Write it below, or use the builder to generate it from the positions
                            or to paste a document you already have.
                        </div>
                    </div>

                    <a class="btn btn-primary text-sm px-20 py-11 radius-8 d-inline-flex align-items-center gap-2 text-nowrap"
                       asp-page="/Contracts/Positions" asp-route-contractId="@Model.Id">
                        <i class="ri-magic-line"></i> Open the builder
                    </a>
                </div>
            }

            <!-- VIEW MODE: formatted contract -->
            <div id="contractView" class="contractPage__contractHtml">
                @Html.Raw(Model.ContractHtml)
            </div>

            <!-- EDIT MODE: plain text editor in same paper -->
            @if (Model.Contract.Status == WitcherHub.Infrastructure.Data.Models.Enums.DocumentStatus.Draft)
            {
                <pre id="contractEditor"
                     class="wh-contract-editor"
                     contenteditable="true"
                     spellcheck="false">@Html.Raw(HtmlEncoder.Default.Encode(Model.RawTermsEditable ?? ""))</pre>

            }
        </div>
    </div>

    <!-- Hidden Save Form -> uses your existing handler OnPostUpdateHeaderAsync -->
    <form id="saveForm" method="post" asp-page-handler="UpdateHeader" asp-route-id="@Model.Id" class="d-none">
        <input type="hidden" asp-for="Id" />

        <!-- required hidden fields (to satisfy validator) -->
        <input type="hidden" asp-for="Header.Contract.ProjectId" />
        <input type="hidden" asp-for="Header.Contract.Currency" />
        <input type="hidden" asp-for="Header.Contract.Status" />
        <input type="hidden" asp-for="Header.Contract.StartDate" />
        <input type="hidden" asp-for="Header.Contract.EndDate" />
        <input type="hidden" asp-for="Header.Contract.SignedAt" />

        <!-- will be filled from editor text on Save -->
        <input type="hidden" asp-for="Header.Contract.Terms" id="termsHidden" />
    </form>

</div>

@section Scripts {
    @* The editor rewrites the preview as you type, so the page marks are
       recalculated with it — a clause that pushes the signature block onto a new
       sheet should show that while it is being written, not after it is saved. *@
    <script src="~/js/pages/contracts/contract-pages.js" asp-append-version="true"></script>

    <script>
        (function () {
          const view = document.getElementById('contractView');
          const editor = document.getElementById('contractEditor');
          const btnSave = document.getElementById('btnSave');
          const btnReset = document.getElementById('btnReset');
          const saveForm = document.getElementById('saveForm');
          const termsHidden = document.getElementById('termsHidden');

          if (!editor) return;

          // Without the form there is nothing to post to, so the editor stays
          // read-write but unsaved rather than pretending to autosave.
          const canSave = Boolean(saveForm && termsHidden);

          if (view) view.classList.add('d-none');
          editor.classList.remove('d-none');
          editor.classList.add('is-editing');

          function normalizeText(value) {
            return (value ?? '').replace(/\r\n/g, '\n').trimEnd();
          }

          function getEditorText() {
            return normalizeText(editor.textContent ?? '');
          }

          const saveState = document.getElementById('saveState');

          // ---- autosave ----------------------------------------------------
          //
          // Editing used to end at a Save button, with no indication of whether
          // anything had reached the server. A long edit could be lost by
          // closing the tab, and there was no way to tell a saved contract from
          // an unsaved one by looking.
          //
          // The draft now saves itself shortly after typing stops, and the state
          // says which of the four situations you are in: saved, unsaved,
          // saving, or failed. The Save button stays, because a person who wants
          // to be certain should not have to wait for a timer.

          const AUTOSAVE_DELAY_MS = 1500;

          let savedText = null;          // what the server last accepted
          let saveTimer = null;
          let saving = false;

          function setState(kind, message) {
            if (!saveState) return;

            saveState.textContent = message;
            saveState.className =
              'text-sm ' + (
                kind === 'failed' ? 'text-danger-main fw-medium'
                : kind === 'unsaved' ? 'text-warning-main'
                : kind === 'saving' ? 'text-secondary-light'
                : 'text-success-main');
          }

          function refreshActionState() {
            const isDirty = getEditorText() !== savedText;

            if (btnSave) btnSave.disabled = !isDirty || saving;
            if (btnReset) btnReset.disabled = !isDirty || saving;

            if (!saving) {
              setState(isDirty ? 'unsaved' : 'saved',
                       isDirty ? 'Unsaved changes' : 'All changes saved');
            }

            return isDirty;
          }

          function scheduleAutosave() {
            if (!refreshActionState()) return;

            window.clearTimeout(saveTimer);
            saveTimer = window.setTimeout(save, AUTOSAVE_DELAY_MS);
          }

          async function save() {
            if (saving || !canSave) return;

            const text = getEditorText();
            if (text === savedText) return;

            saving = true;
            setState('saving', 'Saving…');
            if (btnSave) btnSave.disabled = true;

            try {
              // Built from the existing form so the server-side validator gets
              // every field it requires — the contract's project, currency and
              // status included. Posting the terms alone would fail validation
              // for reasons that have nothing to do with the text.
              if (termsHidden) termsHidden.value = text;

              const body = new FormData(saveForm);

              const response = await fetch(saveForm.action, {
                method: 'POST',
                body: body,
                headers: { 'X-Requested-With': 'fetch' }
              });

              if (!response.ok) throw new Error('HTTP ' + response.status);

              // Only now is the text actually saved. Saying so before the server
              // has agreed is how a lost edit looks like a saved one.
              savedText = text;
              saving = false;
              refreshActionState();
            } catch (error) {
              saving = false;

              // The text stays on screen and stays dirty, so nothing is lost and
              // the next attempt still has it.
              setState('failed', 'Could not save — your text is still here. Retrying shortly.');
              if (btnSave) btnSave.disabled = false;

              window.clearTimeout(saveTimer);
              saveTimer = window.setTimeout(save, 10000);

              if (window.console) console.error(error);
            }
          }

          savedText = getEditorText();

          editor.addEventListener('paste', function (e) {
            e.preventDefault();
            const text = (e.clipboardData || window.clipboardData).getData('text/plain');
            document.execCommand('insertText', false, text);
            scheduleAutosave();
          });

          editor.addEventListener('input', scheduleAutosave);
          editor.addEventListener('keyup', scheduleAutosave);

          // A save in flight when the tab closes would be lost silently, so the
          // user is warned only when there is genuinely something unsaved.
          window.addEventListener('beforeunload', function (event) {
            if (getEditorText() === savedText) return;
            event.preventDefault();
            event.returnValue = '';
          });

          editor.focus();
          placeCaretAtEnd(editor);
          refreshActionState();

          if (btnReset) {
            btnReset.addEventListener('click', function () {
              window.clearTimeout(saveTimer);
              editor.textContent = savedText;
              editor.focus();
              placeCaretAtEnd(editor);
              refreshActionState();
            });
          }

          if (btnSave) {
            btnSave.addEventListener('click', function () {
              window.clearTimeout(saveTimer);
              save();
            });
          }

          function placeCaretAtEnd(el) {
            const range = document.createRange();
            range.selectNodeContents(el);
            range.collapse(false);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
          }
        })();
    </script>
}

