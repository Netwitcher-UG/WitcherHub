@page
@using WitcherHub.Pages.Models.UI
@model WitcherHub.Pages.Contracts.IndexModel
@{
    ViewData["Title"] = "Contracts";
    var noMatches = EmptyStateVm.NoMatches("contracts");
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
    <div>
        <h3 class="mb-4 fw-semibold">Contracts</h3>
        <p class="text-secondary-light mb-0 text-sm">Every contract, across all customers and projects.</p>
    </div>

    @if (Model.AwaitingSignatureCount > 0)
    {
        <span class="badge bg-warning-focus text-warning-main border border-warning-main px-16 py-8 radius-8 text-sm">
            @Model.AwaitingSignatureCount awaiting a signature
        </span>
    }
</div>

<div class="card radius-12 border">
    <div class="card-body p-24">
        <partial name="_RegisterFilters" model="Model.Filters" />

        @if (Model.Results.TotalItems == 0)
        {
            @if (Model.Filters.AnyApplied)
            {
                                <partial name="_EmptyState" model="noMatches" />
            }
            else
            {
                <partial name="_EmptyState" model="@(new EmptyStateVm
                       {
                           Title = "No contracts yet",
                           Message = "Contracts are created inside a project, either from an accepted quote or from positions entered by hand.",
                           Icon = "ri-file-paper-2-line",
                           ActionText = "Go to projects",
                           ActionUrl = Url.Page("/Projects"),
                           ActionIcon = "ri-briefcase-line"
                       })" />
            }
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0 wh-register-table">
                    <thead>
                        <tr>
                            <th class="text-sm">Contract</th>
                            <th class="text-sm">Customer</th>
                            <th class="text-sm">Project</th>
                            <th class="text-sm">Status</th>
                            <th class="text-sm text-end">Value</th>
                            <th class="text-sm">Term</th>
                            <th class="text-sm">Billing</th>
                            <th class="text-sm text-end">Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Results.Items)
                        {
                            var daysLeft = WitcherHub.Pages.Contracts.IndexModel.DaysUntilEnd(row.EndDate);

                            <tr>
                                <td>
                                    <a asp-page="/Contracts/Details" asp-route-id="@row.Id" class="fw-semibold text-primary-600">
                                        @row.ContractNo
                                    </a>
                                    <span class="d-block text-secondary-light text-sm">
                                        @row.ItemCount @(row.ItemCount == 1 ? "position" : "positions")
                                    </span>
                                </td>
                                <td class="text-break">@row.CustomerName</td>
                                <td class="text-break text-secondary-light">@row.ProjectTitle</td>
                                <td>
                                    <partial name="_StatusBadge" model="DocumentStatusPresentation.ForContract(row.Status)" />
                                </td>
                                <td class="text-end fw-semibold text-nowrap">
                                    @Format.Money(row.ItemsTotal, row.Currency)
                                </td>
                                <td class="text-nowrap">
                                    @if (row.StartDate is null && row.EndDate is null)
                                    {
                                        <span class="text-secondary-light">Not set</span>
                                    }
                                    else
                                    {
                                        <span class="text-sm">@Format.Date(row.StartDate) → @Format.Date(row.EndDate)</span>

                                        @if (daysLeft is not null)
                                        {
                                            <span class="badge bg-warning-focus text-warning-main border border-warning-main d-block mt-4 text-sm">
                                                ends in @daysLeft days
                                            </span>
                                        }
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (row.RecurringEnabled)
                                    {
                                        <span class="d-inline-flex align-items-center gap-1 text-sm @(row.RecurringIsActive ? "text-success-main" : "text-secondary-light")">
                                            <i class="ri-repeat-line"></i>
                                            @(row.RecurringIsActive ? "Recurring" : "Recurring, paused")
                                        </span>
                                        @if (row.RecurringIsActive && row.NextRecurringInvoiceDate is not null)
                                        {
                                            <span class="d-block text-secondary-light text-sm">
                                                next @Format.Date(row.NextRecurringInvoiceDate)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-secondary-light text-sm">One-off</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-page="/Contracts/Positions" asp-route-contractId="@row.Id"
                                           class="btn btn-sm btn-outline-primary radius-8 px-12"
                                           title="Edit positions">
                                            <i class="ri-list-check-2"></i>
                                        </a>
                                        <a asp-page="/Contracts/Details" asp-route-id="@row.Id"
                                           class="btn btn-sm btn-outline-primary radius-8 px-12"
                                           title="Open contract">
                                            <i class="ri-arrow-right-line"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="text-secondary-light text-sm mt-16 mb-0">
                Value is the sum of quantity × unit price across the positions, before position discounts and VAT.
            </p>

            <partial name="_RegisterPager" model="Model.Pager" />
        }
    </div>
</div>
