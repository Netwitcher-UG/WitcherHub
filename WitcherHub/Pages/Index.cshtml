@page
@using Microsoft.AspNetCore.Authorization
@using WitcherHub.Domain.SeedData
@attribute [Authorize(Policy = AppPolicyPrefixes.Permission + AppPermissions.ManageNetwitcher)]
@model IndexModel

@{
    ViewData["Title"] = "Clients";
}

<div class="row">
    <div class="col-12 col-xl-11 col-xxl-10 mx-auto">

        <!-- Toolbar -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h4 class="mb-0 fw-semibold text-light">Clients</h4>

            <button type="button"
                    class="btn btn-grd-primary px-4"
                    data-bs-toggle="modal"
                    data-bs-target="#FormModal">
                Add Client
            </button>
        </div>

        <!-- Clients Table -->
        <div class="card w-100 rounded-4">
            <div class="card-body">

                <div class="order-search position-relative my-3 w-25 ms-4">
                    <input class="form-control rounded-5 px-5" type="text" placeholder="Search">
                    <span class="material-icons-outlined position-absolute ms-3 translate-middle-y start-0 top-50">
                        search
                    </span>
                </div>

                <div class="table-responsive maxton-table-wrap mt-2">
                    <table class="table align-middle w-100 maxton-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Type</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>City</th>
                                <th>Tax ID</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td class="ps-4 fw-semibold">Anas Sadek</td>
                                <td><span class="badge bg-info bg-opacity-10 text-info">Individual</span></td>
                                <td>+49 174 234 5678</td>
                                <td>anas@email.com</td>
                                <td>Berlin</td>
                                <td>—</td>
                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-outline-info rounded-circle">
                                        <i class="material-icons-outlined">edit</i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger rounded-circle">
                                        <i class="material-icons-outlined">delete</i>
                                    </a>
                                </td>
                            </tr>

                            <tr>
                                <td class="ps-4 fw-semibold">ACME LLC</td>
                                <td><span class="badge bg-success bg-opacity-10 text-success">Company</span></td>
                                <td>+1 212 555 0199</td>
                                <td>finance@acme.com</td>
                                <td>New York</td>
                                <td>CR-123456</td>
                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-outline-info rounded-circle">
                                        <i class="material-icons-outlined">edit</i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger rounded-circle">
                                        <i class="material-icons-outlined">delete</i>
                                    </a>
                                </td>
                            </tr>

                            <tr>
                                <td class="ps-4 fw-semibold">Mona Ali</td>
                                <td><span class="badge bg-info bg-opacity-10 text-info">Individual</span></td>
                                <td>+966 50 123 4567</td>
                                <td>mona.ali@example.com</td>
                                <td>Riyadh</td>
                                <td>—</td>
                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-outline-info rounded-circle">
                                        <i class="material-icons-outlined">edit</i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger rounded-circle">
                                        <i class="material-icons-outlined">delete</i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= ADD CUSTOMER MODAL ================= -->

<div class="modal fade" id="FormModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-grd-info border-0">
                <h5 class="modal-title text-light">Add Individual</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form method="post">

                    <!-- Customer Information -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="material-icons-outlined">person</i>
                            <span>Customer Information</span>
                        </div>
                        <div class="form-section-divider"></div>

                        <div class="row g-3 mt-0">
                            <div class="col-md-4">
                                <label class="form-label text-light">
                                    Customer Type <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" id="type" name="Customer.Type">
                                    <option value="Individual">Individual</option>
                                    <option value="Company">Company</option>
                                </select>
                            </div>

                            <div class="col-md-8">
                                <label class="form-label text-light">
                                    Name <span class="text-danger">*</span>
                                </label>
                                <input class="form-control"
                                       name="Customer.Name"
                                       placeholder="e.g. Anas Sadek / ACME LLC"
                                       required autofocus />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Email <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Customer.Email" type="email" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Phone <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Customer.Phone" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Tax ID <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Customer.TaxId" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Notes <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Customer.Notes" />
                            </div>
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="material-icons-outlined">location_on</i>
                            <span>Address</span>
                        </div>
                        <div class="form-section-divider"></div>

                        <div class="row g-3 mt-0">
                            <div class="col-md-4">
                                <label class="form-label text-light">Label</label>
                                <select class="form-select" name="Address.Label">
                                    <option selected>Billing</option>
                                    <option>Shipping</option>
                                    <option>Office</option>
                                    <option>Home</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-light">Country</label>
                                <input class="form-control" name="Address.Country" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-light">City</label>
                                <input class="form-control" name="Address.City" />
                            </div>

                            <div class="col-md-8">
                                <label class="form-label text-light">Address Line 1</label>
                                <input class="form-control" name="Address.AddressLine1" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label text-light">Postal Code</label>
                                <input class="form-control" name="Address.PostalCode" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-light">Address Line 2</label>
                                <input class="form-control" name="Address.AddressLine2" />
                            </div>
                        </div>
                    </div>

                    <!-- Primary Contact -->
                    <div id="contactSection" class="form-section">
                        <div class="form-section-header">
                            <i class="material-icons-outlined">contacts</i>
                            <span>Primary Contact</span>
                        </div>
                        <div class="form-section-divider"></div>

                        <div class="row g-3 mt-0">
                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Contact Name <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Contact.Name" placeholder="e.g. Sara Ahmed" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Position <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Contact.Position" placeholder="e.g. Manager" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Contact Email <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Contact.Email" type="email" placeholder="e.g. sara@company.com" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-light opacity-75">
                                    Contact Phone <small>(optional)</small>
                                </label>
                                <input class="form-control" name="Contact.Phone" placeholder="e.g. 49174..." />
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 mt-5">
                        <button type="button" class="btn btn-grd-info px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-grd-primary px-4">Save</button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

<script>
    const typeSelect = document.getElementById('type');
    const contactSection = document.getElementById('contactSection');
    const modalTitle = document.querySelector('.modal-title');

    function updateUI() {
        const isCompany = typeSelect.value === 'Company';
        contactSection.style.display = isCompany ? 'block' : 'none';
        modalTitle.textContent = isCompany ? 'Add Company' : 'Add Individual';
    }

    typeSelect.addEventListener('change', updateUI);
    updateUI();
</script>
