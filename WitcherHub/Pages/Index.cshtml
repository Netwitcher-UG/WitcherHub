@page
@using Microsoft.AspNetCore.Authorization
@using WitcherHub.Domain.SeedData
@attribute [Authorize(Policy = AppPolicyPrefixes.Permission + AppPermissions.ManageNetwitcher)]
@model IndexModel

@{
    ViewData["Title"] = "Clients";
}

<partial name="_TableCard" model="Model.ClientsTable" />

<!-- المودال صار Template -->
<partial name="~/Pages/Shared/Modals/_ModalShell.cshtml" model="Model.CreateCustomerModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // نخليها Scoped داخل المودال
        const modal = document.getElementById('FormModal');
        const typeSelect = modal.querySelector('#type');
        const contactSection = modal.querySelector('#contactSection');
        const modalTitle = modal.querySelector('.modal-title');

        function updateUI() {
            const isCompany = typeSelect.value === 'Company';
            contactSection.style.display = isCompany ? 'block' : 'none';
            modalTitle.textContent = isCompany ? 'Add Company' : 'Add Individual';
        }

        typeSelect.addEventListener('change', updateUI);
        updateUI();
    </script>
}
