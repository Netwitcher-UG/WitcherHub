@page "/clients"
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using WitcherHub.Domain.SeedData
@attribute [Authorize(Policy = AppPolicyPrefixes.Permission + AppPermissions.ManageNetwitcher)]
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Clients";
    ViewData["LexwareImportUrl"] = Url.Page("./Index", "LexwareImportContacts");

    @* The title and the create button used to come from inside the table card. *@
    var header = new WitcherHub.Pages.Models.UI.PageHeaderVm
    {
        Title = "Clients",
        Subtitle = "The companies and people you invoice. Projects, quotes and contracts hang off them.",
        Actions =
        [
            new WitcherHub.Pages.Models.UI.PageAction
            {
                Label = "New client",
                Icon = "ri-add-line",
                Style = WitcherHub.Pages.Models.UI.PageActionStyle.Primary,
                ModalTarget = Model.CreateCustomerModal.Id
            }
        ]
    };
}

<partial name="_PageHeader" model="header" />

<div id="clientsTableCard" class="wh-tablecard-scroll wh-section">
    <partial name="_TableCard" model="Model.ClientsTable" />
</div>
<partial name="~/Pages/Shared/Modals/_ModalShell.cshtml" model="Model.CreateCustomerModal" />

<form id="tblDeleteForm" method="post" asp-page-handler="DeleteClient" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ClientId" id="tblDeleteClientId" />
</form>
<input type="hidden" id="vcLexwareImportUrl" value="@Url.Page("./Index", "LexwareImportContacts")" />

<input type="hidden" id="vcClientUrl" value="@Url.Page("./Index", "Client")" />
<input type="hidden" id="vcDeleteClientInfoUrl" value="@Url.Page("./Index", "DeleteInfo")" />
<input type="hidden" id="vcUpdateBasicUrl" value="@Url.Page("./Index", "UpdateBasic")" />
<input type="hidden" id="antiForgeryToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<input type="hidden" id="vcAddAddressUrl" value="@Url.Page("./Index", "AddAddress")" />
<input type="hidden" id="vcDeleteAddressUrl" value="@Url.Page("./Index", "DeleteAddress")" />
<input type="hidden" id="vcSetDefaultAddressUrl" value="@Url.Page("./Index", "SetDefaultAddress")" />
<input type="hidden" id="vcUpdateAddressUrl" value="@Url.Page("./Index", "UpdateAddress")" />

<input type="hidden" id="vcAddContactUrl" value="@Url.Page("./Index", "AddContact")" />
<input type="hidden" id="vcDeleteContactUrl" value="@Url.Page("./Index", "DeleteContact")" />
<input type="hidden" id="vcSetPrimaryContactUrl" value="@Url.Page("./Index", "SetPrimaryContact")" />
<input type="hidden" id="vcUpdateContactUrl" value="@Url.Page("./Index", "UpdateContact")" />

<input type="hidden" id="vcLexwareExportUrl" value="@Url.Page("./Index", "LexwareExport")" />
<input type="hidden" id="vcLexwareDeleteUrl" value="@Url.Page("./Index", "LexwareDelete")" />
<script type="application/json" id="countryOptionsJson">
    @Html.Raw(JsonSerializer.Serialize(Model.CountryOptions.Select(x => new { code = x.Value, name = x.Text })))
</script>
<div class="modal fade quote-confirm-modal" id="DeleteClientConfirmModal" tabindex="-1" aria-labelledby="DeleteClientConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteClientConfirmModalLabel">Delete client</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="DeleteClientConfirmModalMessage">Are you sure you want to delete this client?</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="DeleteClientConfirmModalSubmit">Delete</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/clients/clients.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const typeInput = document.getElementById("Customer_Type");
            const companyValue = "@((int)WitcherHub.Infrastructure.Data.Models.Enums.CustomerType.Company)";

            function removeOptionalText(label) {
                if (!label) return;

                const walker = document.createTreeWalker(
                    label,
                    NodeFilter.SHOW_TEXT
                );

                const textNodes = [];
                while (walker.nextNode()) {
                    textNodes.push(walker.currentNode);
                }

                textNodes.forEach(function (node) {
                    node.nodeValue = node.nodeValue
                        .replace(/\s*\(\s*optional\s*\)/gi, "")
                        .replace(/\s*-\s*optional\b/gi, "")
                        .replace(/\s+optional\b/gi, "");
                });

                label.querySelectorAll(".optional, [data-optional]").forEach(function (node) {
                    node.remove();
                });
            }

            function setRequiredByElement(element, required) {
                if (!element) return;

                if (required) {
                    element.setAttribute("required", "required");
                    element.setAttribute("aria-required", "true");
                } else {
                    element.removeAttribute("required");
                    element.removeAttribute("aria-required");
                }

                const label = element.id
                    ? Array.from(document.getElementsByTagName("label")).find(function (item) { return item.htmlFor === element.id; })
                    : null;

                if (required) {
                    removeOptionalText(label);
                }
            }

            function setRequired(id, required) {
                setRequiredByElement(document.getElementById(id), required);
            }

            function updateRequiredFields() {
                const isCompany = typeInput &&
                    (typeInput.value === companyValue || typeInput.value === "Company");

                // Customer fields depend on the selected customer type.
                setRequired("Customer_Name", isCompany);
                setRequired("Customer_FirstName", !isCompany);
                setRequired("Customer_LastName", !isCompany);

                // These address inputs are required by both the PageModel and service.
                [
                    "Address_Label",
                    "Address_StreetRaw",
                    "Address_AddressLine2",
                    "Address_PostalCode",
                    "Address_City",
                    "Address_CountryCode"
                ].forEach(function (id) {
                    setRequired(id, true);
                });

                // Every visible company-contact field is required.
                [
                    "Contact_Salutation",
                    "Contact_FirstName",
                    "Contact_LastName",
                    "Contact_Position",
                    "Contact_Email",
                    "Contact_Phone"
                ].forEach(function (id) {
                    setRequired(id, isCompany);
                });

                // At least one customer email is required.
                document.querySelectorAll(
                    'input[name^="Customer.EmailAddresses"][name$=".Email"]'
                ).forEach(function (element) {
                    setRequiredByElement(element, true);
                });
            }

            if (typeInput) {
                typeInput.addEventListener("change", updateRequiredFields);
            }

            updateRequiredFields();
        });
    </script>
}
@if (Model.CreateCustomerModal?.AutoOpen == true)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('FormModal');
            if (!el) return;

            const m = bootstrap.Modal.getOrCreateInstance(el);
            m.show();

            const firstErr = el.querySelector('.field-validation-error, .text-danger:not(:empty)');
            if (firstErr) {
                const input = firstErr.closest('.col-md-2,.col-md-4,.col-md-6,.col-md-8,.col-12')?.querySelector('input,select,textarea');
                if (input) input.focus();
            }
        });
    </script>
}

