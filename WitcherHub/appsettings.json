{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WitcherHub": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // Guarantees this address holds the Admin role, which carries every permission.
  // Checked on every start-up and safe to leave in place: an existing account keeps
  // its password and only gains the role if missing.
  //
  // No password is set here on purpose. Without BootstrapAdmin__Password the
  // account is created with a random password nobody knows, and the first sign-in
  // goes through "Forgot password?" — so no administrator credential has to live
  // in configuration. See docs/CONFIGURATION.md.
  // Token issuer, audience and lifetime are not secrets, and they must apply to
  // EVERY environment. They previously lived only in appsettings.Development.json,
  // so on any other environment Issuer and Audience were null while token
  // validation required them: sign-in accepted the password, issued a cookie, and
  // then rejected that cookie on the very next request — an endless bounce back to
  // the login page with no error shown anywhere.
  //
  // Jwt:Key is deliberately absent. It is a secret and comes from Jwt__Key.
  "Jwt": {
    "Issuer": "WitcherHub",
    "Audience": "WitcherHub",
    "AccessTokenMinutes": 480
  },

  "BootstrapAdmin": {
    "Email": "info@netwitcher.com"
  },

  // The model is not a secret and it must apply to EVERY environment, exactly as
  // Jwt:Issuer and the Serilog sinks above had to. It previously lived only in
  // appsettings.Development.json, so any environment not named "Development"
  // started with OpenAI:Model empty — and because the ChatClient registration
  // refuses to build without one, every AI action failed with "the assistant is
  // not configured" while OpenAI__ApiKey was set correctly and the start-up log
  // said the assistant was configured.
  //
  // OpenAI:ApiKey is deliberately absent. It is a secret and comes from
  // OpenAI__ApiKey. Override the model per environment with OpenAI__Model.
  "OpenAI": {
    "Model": "gpt-5.2"
  },

  // Same reasoning: the queue that runs contract analysis and outgoing email is
  // structural, not environmental. With no values the queue was built from
  // whatever the option defaults happened to be rather than from a stated
  // capacity.
  "BackgroundTasks": {
    "Capacity": 200,
    "MaxConcurrency": 1
  },

  // Where the email templates are found, relative to the application directory.
  // Absent outside Development, the renderer looked for them in a folder that
  // does not exist and every outgoing email failed to render.
  "EmailTemplates": {
    "TemplatesFolder": "EmailTemplates",
    "MessagesFolder": "Messages",
    "LayoutFileName": "_Layout.html",
    "AppName": "WitcherHub",
    "BrandLine": "System Notification",
    "LegalLine": "© {{Year}} netwitcher. All rights reserved."
  },

  // Auth__ShowSignInDiagnostics decides how much the login page says when
  // sign-in fails. It is deliberately absent here so the default can depend on
  // the environment: on in Development, off everywhere else.
  //
  //   off (default outside Development)
  //       "Login failed. Check email/password.", plus a short code (AUTH-02),
  //       a per-attempt reference and a timestamp. The code identifies the exact
  //       cause to anyone holding this file, and identifies nothing to a stranger.
  //
  //   on  (set Auth__ShowSignInDiagnostics=true)
  //       Adds the plain-English cause and the facts behind it: which database
  //       this instance is connected to, how many accounts it holds, whether the
  //       address exists, whether a start-up password override is rewriting it.
  //       This distinguishes "no such account" from "wrong password", so switch
  //       it on to diagnose and back off afterwards.
  //
  // Sign-in codes: AUTH-01 no accounts in this database · AUTH-02 no account with
  // that address · AUTH-03 wrong password · AUTH-04 locked out · AUTH-05 no
  // password stored · AUTH-500 not a credential problem (see the log).

  // Logging must be configured for EVERY environment, not just Development.
  // This section previously lived only in appsettings.Development.json, so a
  // deployed instance had no sinks at all: nothing reached the platform log
  // except unhandled exceptions written by the runtime itself, which made
  // diagnosing anything in production impossible.
  //
  // Console only here — a container filesystem does not survive a restart, so a
  // file sink would write logs nobody can read. Development adds one locally.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "WitcherHub"
    }
  }
}
