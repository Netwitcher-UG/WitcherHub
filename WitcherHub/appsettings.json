{


  "Jwt": {
    "Issuer": "WitcherHub",
    "Audience": "WitcherHub",

    "AccessTokenMinutes": 10000
  },
  "Smtp": {
    "Port": 587,
    "UseSsl": false,
    "UseStartTls": true,
    "FromName": "WitcherHub",
    "TimeoutSeconds": 30
  },
  "BackgroundTasks": {
    "Capacity": 200,
    "MaxConcurrency": 1
  },
  "WITCHERHUB_ASSETS_VERSION": "dev1",
  "EmailTemplates": {
    "TemplatesFolder": "EmailTemplates",
    "MessagesFolder": "Messages",
    "LayoutFileName": "_Layout.html",
    "AppName": "WitcherHub",
    "BrandLine": "System Notification",
    "FooterText": "",
    "LegalLine": "© {{Year}} netwitcher. All rights reserved."
  },
  "Lexware": {
    "BaseUrl": "https://api.lexware.io",
    "AppBaseUrl": "https://app.lexware.de",
    "DefaultCountryCode": "DE",
    "DefaultTaxRatePercentage": 0,
    "DefaultPaymentTermLabel": "Zahlbar sofort",
    "DefaultPaymentTermDays": 0
  },
  "LexwareWebhooks": {
    "VerifySignature": true,
    "PublicKeyPem": "-----BEGIN PUBLIC KEY-----\nPASTE_THE_OFFICIAL_LEXWARE_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
  },

  "ContractTemplateOptions": {
    "BaseDePath": "OpenAI/Contracts/Agenturvertrag.de.md",
    "AgbDePath": "OpenAI/Contracts/AGB.de.md",
    "ProviderBlock": "WitcherHub / netwitcher"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "WitcherHub"
    }
  },

  "AllowedHosts": "*",
  "DetailedErrors": true

}
